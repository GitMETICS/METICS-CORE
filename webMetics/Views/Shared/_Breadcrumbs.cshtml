@model IReadOnlyList<webMetics.Helpers.BreadcrumbItem>

@if (Model.Count > 0)
{
    <nav class="metics-breadcrumbs" aria-label="Ruta de navegación">
        <ol>
            @for (var index = 0; index < Model.Count; index++)
            {
                var item = Model[index];
                var isCurrent = index == Model.Count - 1;
                <li>
                    @if (!isCurrent && !string.IsNullOrEmpty(item.Url))
                    {
                        <a href="@item.Url">
                            @if (index == 0) { <i class="bi bi-house-door-fill" aria-hidden="true"></i> }
                            @item.Label
                        </a>
                    }
                    else
                    {
                        <span aria-current="@(isCurrent ? "page" : null)" class="@(isCurrent ? "metics-breadcrumb-current" : null)">
                            @if (index == 0) { <i class="bi bi-house-door-fill" aria-hidden="true"></i> }
                            @item.Label
                        </span>
                    }
                </li>
            }
        </ol>
    </nav>
}
