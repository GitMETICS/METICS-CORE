@{
    ViewBag.Title = "Ocurrió un problema";
}

<div class="contenedor-caja container-fluid result-page error-page">
    <section class="admin-panel-card result-card is-error" aria-labelledby="errorTitulo">
        <span class="result-card-icon" aria-hidden="true"><i class="bi bi-exclamation-lg"></i></span>
        <h1 class="result-card-title" id="errorTitulo">Ocurrió un problema</h1>
        <p class="result-card-message">
            Lo sentimos, algo salió mal al procesar su solicitud.<br />
            Si el problema persiste, comuníquese con el equipo de soporte.
        </p>
        <div class="result-card-actions">
            <a href="/" class="btn admin-panel-btn-primary"><i class="bi bi-house-door" aria-hidden="true"></i>Volver al inicio</a>
        </div>
    </section>
</div>
