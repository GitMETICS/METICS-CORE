<!DOCTYPE html>
<!--
    Aqui se encuentra el Header y Footer del sitio web que se comparte para cada vista del sitio
//-->
@using webMetics.Controllers
@using webMetics.Helpers

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">

    <script>
        (function () {
            const storageKey = 'metics-inscripcion-assignment-scroll';
            try {
                if (!window.location.pathname.toLowerCase().endsWith('/inscripcion/verinscripciones')) {
                    sessionStorage.removeItem(storageKey);
                    return;
                }

                const savedPosition = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
                if (!savedPosition || !Number.isFinite(savedPosition.top) || !Number.isFinite(savedPosition.savedAt) || Date.now() - savedPosition.savedAt > 30000) {
                    sessionStorage.removeItem(storageKey);
                    return;
                }

                history.scrollRestoration = 'manual';
                document.documentElement.classList.add('metics-scroll-restore-pending');
                let restored = false;
                let fallbackTimer;
                window.__meticsFinishScrollRestore = function () {
                    if (restored) return;
                    restored = true;
                    window.clearTimeout(fallbackTimer);
                    requestAnimationFrame(function () {
                        window.scrollTo(0, savedPosition.top);
                        sessionStorage.removeItem(storageKey);
                        document.documentElement.classList.remove('metics-scroll-restore-pending');
                        history.scrollRestoration = 'auto';
                        window.__meticsFinishScrollRestore = null;
                        document.dispatchEvent(new Event('metics:scroll-restored'));
                    });
                };
                document.addEventListener('DOMContentLoaded', function () {
                    fallbackTimer = window.setTimeout(window.__meticsFinishScrollRestore, 1800);
                }, { once: true });
            } catch (error) {
                document.documentElement.classList.remove('metics-scroll-restore-pending');
            }
        })();
    </script>

    <!-- jQuery se carga una sola vez en el head para que esté disponible en todas las vistas (DataTables, etc.) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- DataTables se carga una sola vez (versión 1.13.x) para todas las vistas de listado.
         El helper compartido MeticsTable vive en site.js. -->
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
    <script src="//cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    @{
        string navUserId = Convert.ToString(ViewBag.Id) ?? "";
        string navRoleValue = Convert.ToString(ViewBag.Role) ?? "";
        int navRole = 0;
        int.TryParse(navRoleValue, out navRole);
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]) ?? "";
        string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]) ?? "";
        bool showNav = !string.IsNullOrEmpty(navUserId)
            && ViewBag.Title != "Formulario de Registro"
            && ViewBag.Title != "Iniciar sesión"
            && ViewBag.Title != "Recuperar Contraseña"
            && ViewBag.Title != "Completar Información - Correo Alternativo"
            && ViewBag.Title != "Completar Información - Grado Académico";
        bool isAcademicActive = currentController == "Categoria" || currentController == "Tema";
        bool isPeopleActive = currentController == "Participante" || (currentController == "Asesor" && currentAction != "MisModulos");
        bool isInscriptionActive = currentController == "Inscripcion";
        bool isContentActive = currentController == "Medallas"
            || (currentController == "Grupo" && currentAction == "CrearGrupo");
        bool isFacilitatorActive = (currentController == "Asesor" && currentAction == "MisModulos")
            || (currentController == "Grupo" && currentAction == "CrearGrupo");
        string roleLabel = navRole == 1 ? "Administrador" : navRole == 2 ? "Facilitador(a)" : "Participante";
        var breadcrumbs = showNav ? BreadcrumbBuilder.Build(ViewContext, Url) : Array.Empty<BreadcrumbItem>();
        bool hasPageHeading = showNav && ViewData["UseSharedPageHeader"] is true;
        bool showCreateModuleAction = (navRole == 1 || navRole == 2)
            && currentController == "Grupo"
            && (currentAction == "ListaGruposDisponibles" || currentAction == "BuscarGrupos");
    }

    <header class="metics-unified-header">
        <nav class="navbar metics-navbar-expand metics-tabs-navbar" aria-label="Navegación principal">
            <div class="container-fluid metics-tabs-container">
                <div class="metics-institutional-brand" aria-label="Universidad de Costa Rica, Vicerrectoría de Docencia y METICS">
                    <a class="metics-brand-ucr" href="https://www.ucr.ac.cr/" aria-label="Universidad de Costa Rica">
                        <span class="metics-ucr-signature-window" aria-hidden="true">
                            <svg class="metics-ucr-signature-art" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 651.2514 78" role="img" aria-label="Universidad de Costa Rica">
                                <use class="metics-ucr-wordmark" href="@Url.Content("~/images/firma-ucr-c.svg")#textoUCR"></use>
                                <use class="metics-ucr-crest" href="@Url.Content("~/images/firma-ucr-c.svg")#escudo"></use>
                                <use class="metics-ucr-crest-text" href="@Url.Content("~/images/firma-ucr-c.svg")#escudotexto"></use>
                            </svg>
                        </span>
                    </a>
                    <span class="metics-brand-divider" aria-hidden="true"></span>
                    <a class="metics-brand-vd" href="https://vd.ucr.ac.cr/"><img src="@Url.Content("~/images/VD-01.png")" alt="Logo Vicerrectoria de Docencia" /></a>
                    <a class="metics-brand-metics" href="https://metics.ucr.ac.cr/es/"><img src="@Url.Content("~/images/METICS-01.png")" alt="Logo METICS" /></a>
                </div>
                @if (showNav)
                {
                    <button class="navbar-toggler metics-tabs-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Abrir o cerrar navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse metics-tabs-collapse" id="navbarColor01">
                        <div class="metics-tabs-left">
                            @if (navRole == 1)
                            {
                                <ul class="navbar-nav metics-tabs-nav">
                                    <li class="nav-item dropdown metics-tab metics-section-academic @(isAcademicActive ? "active" : "")">
                                        <a class="nav-link dropdown-toggle" href="#" id="academicDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-list-ul"></i><span>Gestión académica</span></a>
                                        <ul class="dropdown-menu metics-tabs-menu metics-section-menu" aria-labelledby="academicDropdown">
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("ListaCategorias", "Categoria")"><span class="metics-menu-icon"><i class="bi bi-diagram-3"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Niveles</span><span class="metics-menu-description">Gestiona los niveles del sistema</span></span></a></li>
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("ListaTemas", "Tema")"><span class="metics-menu-icon"><i class="bi bi-collection"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Áreas de competencia</span><span class="metics-menu-description">Administra las áreas de competencia</span></span></a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown metics-tab metics-section-people @(isPeopleActive ? "active" : "")">
                                        <a class="nav-link dropdown-toggle" href="#" id="peopleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-people"></i><span>Personas</span></a>
                                        <ul class="dropdown-menu metics-tabs-menu metics-section-menu" aria-labelledby="peopleDropdown">
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("ListaAsesores", "Asesor")"><span class="metics-menu-icon"><i class="bi bi-person-badge"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Lista de facilitadores(as)</span><span class="metics-menu-description">Administra las cuentas de facilitadores</span></span></a></li>
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("VerParticipantes", "Participante")"><span class="metics-menu-icon"><i class="bi bi-people"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Lista de participantes</span><span class="metics-menu-description">Consulta y gestiona participantes</span></span></a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown metics-tab metics-section-inscriptions @(isInscriptionActive ? "active" : "")">
                                        <a class="nav-link dropdown-toggle" href="#" id="inscriptionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-card-checklist"></i><span>Inscripciones</span></a>
                                        <ul class="dropdown-menu metics-tabs-menu metics-section-menu" aria-labelledby="inscriptionDropdown">
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("VerInscripciones", "Inscripcion")"><span class="metics-menu-icon"><i class="bi bi-card-checklist"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Lista de inscripciones</span><span class="metics-menu-description">Revisa solicitudes y estados de inscripción</span></span></a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown metics-tab metics-section-content @(isContentActive ? "active" : "")">
                                        <a class="nav-link dropdown-toggle" href="#" id="contentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-file-earmark-plus"></i><span>Contenido</span></a>
                                        <ul class="dropdown-menu metics-tabs-menu metics-section-menu" aria-labelledby="contentDropdown">
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("CrearGrupo", "Grupo")"><span class="metics-menu-icon"><i class="bi bi-journal-plus"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Crear un módulo</span><span class="metics-menu-description">Crea y configura módulos académicos</span></span></a></li>
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("ListaMedallas", "Medallas")"><span class="metics-menu-icon"><i class="bi bi-award"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Medallas</span><span class="metics-menu-description">Administra el catálogo de medallas</span></span></a></li>
                                        </ul>
                                    </li>
                                </ul>
                            }
                            else if (navRole == 2)
                            {
                                <ul class="navbar-nav metics-tabs-nav">
                                    <li class="nav-item dropdown metics-tab metics-section-facilitator @(isFacilitatorActive ? "active" : "")">
                                        <a class="nav-link dropdown-toggle" href="#" id="facilitatorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-workspace"></i><span>Facilitador(a)</span></a>
                                        <ul class="dropdown-menu metics-tabs-menu metics-section-menu" aria-labelledby="facilitatorDropdown">
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("MisModulos", "Asesor")"><span class="metics-menu-icon"><i class="bi bi-journal-text"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Mis módulos</span><span class="metics-menu-description">Consulta los módulos que facilitas</span></span></a></li>
                                            <li><a class="dropdown-item metics-menu-card" href="@Url.Action("CrearGrupo", "Grupo")"><span class="metics-menu-icon"><i class="bi bi-journal-plus"></i></span><span class="metics-menu-copy"><span class="metics-menu-title">Crear un módulo</span><span class="metics-menu-description">Crea y configura un módulo académico</span></span></a></li>
                                        </ul>
                                    </li>
                                </ul>
                            }
                        </div>

                        <div class="metics-tabs-right">
                            <span class="metics-brand-divider metics-account-divider" aria-hidden="true"></span>
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown metics-account">
                                    <a class="nav-link dropdown-toggle metics-account-link" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle"></i><span>@roleLabel</span></a>
                                    <ul class="dropdown-menu dropdown-menu-end metics-tabs-menu" aria-labelledby="accountDropdown">
                                        <li><h6 class="dropdown-header">Mi cuenta</h6></li>
                                        <li>@Html.ActionLink("Información personal", "InformacionPersonal", "Usuario", new { }, new { @class = "dropdown-item bi bi-person" })</li>
                                        <li>@Html.ActionLink("Cambiar contraseña", "CambiarContrasena", "Usuario", null, new { @class = "dropdown-item bi bi-key" })</li>
                                        @if (navRole == 1)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Configuración</h6></li>
                                            <li>@Html.ActionLink("Configuración del correo", "Index", "EmailSettings", new { }, new { @class = "dropdown-item bi bi-envelope" })</li>
                                            <li>@Html.ActionLink("Registro de accesos", "VerBitacoraAccesos", "Usuario", new { }, new { @class = "dropdown-item bi bi-clock-history" })</li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>@Html.ActionLink("Cerrar sesión", "CerrarSesion", "Usuario", new { }, new { @class = "dropdown-item bi bi-box-arrow-right metics-logout" })</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    @if (hasPageHeading)
    {
        <section class="metics-page-header" aria-labelledby="@(ViewData["PageHeadingId"] ?? "pageHeading")">
            <div class="container metics-page-header-inner">
                <div class="metics-page-header-content">
                    @await Html.PartialAsync("_Breadcrumbs", breadcrumbs)
                    <h1 id="@(ViewData["PageHeadingId"] ?? "pageHeading")">@ViewData["PageHeading"]</h1>
                    @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewData["PageSubheading"])))
                    {
                        <p class="metics-page-subheading">@ViewData["PageSubheading"]</p>
                    }
                </div>
                @if (showCreateModuleAction)
                {
                    <div class="metics-page-actions" aria-label="Acciones de página">
                        @Html.ActionLink("Crear módulo", "CrearGrupo", "Grupo", new { }, new { @class = "btn btn-primary metics-create-module bi bi-plus-lg" })
                    </div>
                }
            </div>
        </section>
    }
    <div class="container body-content @(hasPageHeading ? "metics-has-page-heading" : "")" style="min-height: 100vh">
        @if (!hasPageHeading && (breadcrumbs.Count > 0 || (showNav && (navRole == 1 || navRole == 2))))
        {
            <div class="metics-page-context">
                @await Html.PartialAsync("_Breadcrumbs", breadcrumbs)
                @if (showNav && showCreateModuleAction)
                {
                    <div class="metics-page-actions" aria-label="Acciones de página">
                        @Html.ActionLink("Crear módulo", "CrearGrupo", "Grupo", new { }, new { @class = "btn btn-primary metics-create-module bi bi-plus-lg" })
                    </div>
                }
            </div>
        }
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="text-center text-lg-start text-white" id="footer" style="background-color: #3e4551; bottom: 0px; width: 100%; height: 100%;">
        <div class="container p-4 pb-5">
            <section class="">
                <div class="row h-100">
                    <div class="col-md-4">
                        <!-- Información de los contactos  -->
                        @{await Html.RenderPartialAsync("~/Views/Shared/Info.cshtml"); }
                    </div>                   
                </div>
            </section>
        </div>
        <div class="text-center p-1">
            <p>&copy; @DateTime.Now.Year METICS</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.9.2/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    <script src="~/js/metics-header-scroll.js" asp-append-version="true"></script>
    <script src="~/js/metics-dropdown-exclusive.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
