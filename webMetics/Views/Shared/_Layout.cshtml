<!DOCTYPE html>
<!--
    Aqui se encuentra el Header y Footer del sitio web que se comparte para cada vista del sitio
//-->
@using webMetics.Controllers
@using webMetics.Helpers

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">

    <!-- jQuery se carga una sola vez en el head para que esté disponible en todas las vistas (DataTables, etc.) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- DataTables se carga una sola vez (versión 1.13.x) para todas las vistas de listado.
         El helper compartido MeticsTable vive en site.js. -->
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
    <script src="//cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
    @{
        string navUserId = Convert.ToString(ViewBag.Id) ?? "";
        string navRoleValue = Convert.ToString(ViewBag.Role) ?? "";
        int navRole = 0;
        int.TryParse(navRoleValue, out navRole);
        string currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]) ?? "";
        string currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]) ?? "";
        bool showNav = !string.IsNullOrEmpty(navUserId)
            && ViewBag.Title != "Formulario de Registro"
            && ViewBag.Title != "Iniciar sesión"
            && ViewBag.Title != "Recuperar Contraseña"
            && ViewBag.Title != "Completar Información - Correo Alternativo"
            && ViewBag.Title != "Completar Información - Grado Académico";
        bool isAcademicActive = currentController == "Categoria" || (currentController == "Tema" && currentAction != "CrearTema");
        bool isPeopleActive = currentController == "Participante" || (currentController == "Asesor" && currentAction != "MisModulos");
        bool isInscriptionActive = currentController == "Inscripcion";
        bool isContentActive = currentController == "Medallas"
            || (currentController == "Tema" && currentAction == "CrearTema")
            || (currentController == "Grupo" && currentAction == "CrearGrupo");
        bool isFacilitatorActive = (currentController == "Asesor" && currentAction == "MisModulos")
            || (currentController == "Grupo" && currentAction == "CrearGrupo");
        string roleLabel = navRole == 1 ? "Administrador" : navRole == 2 ? "Facilitador(a)" : "Participante";
        var breadcrumbs = showNav ? BreadcrumbBuilder.Build(ViewContext, Url) : Array.Empty<BreadcrumbItem>();
        bool hasPageHeading = showNav && ViewData["UseSharedPageHeader"] is true;
    }

    <header class="metics-unified-header">
        <nav class="navbar metics-navbar-expand metics-tabs-navbar" aria-label="Navegación principal">
            <div class="container-fluid metics-tabs-container">
                <div class="metics-institutional-brand" aria-label="Universidad de Costa Rica, Vicerrectoría de Docencia y METICS">
                    <a class="metics-brand-ucr" href="https://www.ucr.ac.cr/"><img src="@Url.Content("~/images/ucr.svg")" alt="Logo Universidad de Costa Rica" /></a>
                    <span class="metics-brand-divider" aria-hidden="true"></span>
                    <a class="metics-brand-vd" href="https://vd.ucr.ac.cr/"><img src="@Url.Content("~/images/VD-01.png")" alt="Logo Vicerrectoria de Docencia" /></a>
                    <a class="metics-brand-metics" href="https://metics.ucr.ac.cr/es/"><img src="@Url.Content("~/images/METICS-01.png")" alt="Logo METICS" /></a>
                </div>
                @if (showNav)
                {
                <button class="navbar-toggler metics-tabs-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Abrir o cerrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse metics-tabs-collapse" id="navbarColor01">
                    <div class="metics-tabs-left">
                        @if (navRole == 1)
                        {
                            <ul class="navbar-nav metics-tabs-nav">

                                <li class="nav-item dropdown metics-tab metics-section-academic @(isAcademicActive ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#" id="academicDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-list-ul"></i>
                                        <span>Gestión académica</span>
                                    </a>
                                    <ul class="dropdown-menu metics-tabs-menu" aria-labelledby="academicDropdown">
                                        <li>@Html.ActionLink("Niveles", "ListaCategorias", "Categoria", new { }, new { @class = "dropdown-item bi bi-diagram-3" })</li>
                                        <li>@Html.ActionLink("Áreas de competencia", "ListaTemas", "Tema", new { }, new { @class = "dropdown-item bi bi-collection" })</li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown metics-tab metics-section-people @(isPeopleActive ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#" id="peopleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-people"></i>
                                        <span>Personas</span>
                                    </a>
                                    <ul class="dropdown-menu metics-tabs-menu" aria-labelledby="peopleDropdown">
                                        <li>@Html.ActionLink("Lista de facilitadores(as)", "ListaAsesores", "Asesor", new { }, new { @class = "dropdown-item bi bi-person-badge" })</li>
                                        <li>@Html.ActionLink("Lista de participantes", "VerParticipantes", "Participante", new { }, new { @class = "dropdown-item bi bi-people" })</li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown metics-tab metics-section-inscriptions @(isInscriptionActive ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#" id="inscriptionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-card-checklist"></i>
                                        <span>Inscripciones</span>
                                    </a>
                                    <ul class="dropdown-menu metics-tabs-menu" aria-labelledby="inscriptionDropdown">
                                        <li>@Html.ActionLink("Lista de inscripciones", "VerInscripciones", "Inscripcion", new { }, new { @class = "dropdown-item bi bi-card-checklist" })</li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown metics-tab metics-section-content @(isContentActive ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#" id="contentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-file-earmark-plus"></i>
                                        <span>Contenido</span>
                                    </a>
                                    <ul class="dropdown-menu metics-tabs-menu" aria-labelledby="contentDropdown">
                                        <li>@Html.ActionLink("Crear un área de competencia", "CrearTema", "Tema", new { }, new { @class = "dropdown-item bi bi-plus-square" })</li>
                                        <li>@Html.ActionLink("Crear un módulo", "CrearGrupo", "Grupo", new { }, new { @class = "dropdown-item bi bi-journal-plus" })</li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>@Html.ActionLink("Medallas", "ListaMedallas", "Medallas", new { }, new { @class = "dropdown-item bi bi-award" })</li>
                                    </ul>
                                </li>
                            </ul>
                        }
                        else if (navRole == 2)
                        {
                            <ul class="navbar-nav metics-tabs-nav">
                                <li class="nav-item dropdown metics-tab metics-section-facilitator @(isFacilitatorActive ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#" id="facilitatorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-workspace"></i>
                                        <span>Facilitador(a)</span>
                                    </a>
                                    <ul class="dropdown-menu metics-tabs-menu" aria-labelledby="facilitatorDropdown">
                                        <li>@Html.ActionLink("Mis módulos", "MisModulos", "Asesor", new { }, new { @class = "dropdown-item bi bi-journal-text" })</li>
                                        <li>@Html.ActionLink("Crear un módulo", "CrearGrupo", "Grupo", new { }, new { @class = "dropdown-item bi bi-journal-plus" })</li>
                                    </ul>
                                </li>
                            </ul>
                        }
                    </div>

                    <div class="metics-tabs-right">

                        <ul class="navbar-nav">
                            <li class="nav-item dropdown metics-account">
                                <a class="nav-link dropdown-toggle metics-account-link" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@roleLabel</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end metics-tabs-menu" aria-labelledby="accountDropdown">
                                    <li><h6 class="dropdown-header">Mi cuenta</h6></li>
                                    <li>@Html.ActionLink("Información personal", "InformacionPersonal", "Usuario", new { }, new { @class = "dropdown-item bi bi-person" })</li>
                                    <li>@Html.ActionLink("Cambiar contraseña", "CambiarContrasena", "Usuario", null, new { @class = "dropdown-item bi bi-key" })</li>
                                    @if (navRole == 1)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Configuración</h6></li>
                                        <li>@Html.ActionLink("Configuración del correo", "Index", "EmailSettings", new { }, new { @class = "dropdown-item bi bi-envelope" })</li>
                                        <li>@Html.ActionLink("Registro de accesos", "VerBitacoraAccesos", "Usuario", new { }, new { @class = "dropdown-item bi bi-clock-history" })</li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("Cerrar sesión", "CerrarSesion", "Usuario", new { }, new { @class = "dropdown-item bi bi-box-arrow-right metics-logout" })</li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
                }
            </div>
        </nav>
    </header>
    @if (hasPageHeading)
    {
        <section class="metics-page-header" aria-labelledby="@(ViewData["PageHeadingId"] ?? "pageHeading")">
            <div class="container metics-page-header-inner">
                <div class="metics-page-header-content">
                    @await Html.PartialAsync("_Breadcrumbs", breadcrumbs)
                    <h1 id="@(ViewData["PageHeadingId"] ?? "pageHeading")">@ViewData["PageHeading"]</h1>
                    @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewData["PageSubheading"])))
                    {
                        <p class="metics-page-subheading">@ViewData["PageSubheading"]</p>
                    }
                </div>
                @if (navRole == 1 || navRole == 2)
                {
                    <div class="metics-page-actions" aria-label="Acciones de página">
                        @Html.ActionLink("Crear módulo", "CrearGrupo", "Grupo", new { }, new { @class = "btn btn-primary metics-create-module bi bi-plus-lg" })
                    </div>
                }
            </div>
        </section>
    }
    <div class="container body-content @(hasPageHeading ? "metics-has-page-heading" : "")" style="min-height: 100vh">
        @if (!hasPageHeading && (breadcrumbs.Count > 0 || (showNav && (navRole == 1 || navRole == 2))))
        {
            <div class="metics-page-context">
                @await Html.PartialAsync("_Breadcrumbs", breadcrumbs)
                @if (showNav && (navRole == 1 || navRole == 2))
                {
                    <div class="metics-page-actions" aria-label="Acciones de página">
                        @Html.ActionLink("Crear módulo", "CrearGrupo", "Grupo", new { }, new { @class = "btn btn-primary metics-create-module bi bi-plus-lg" })
                    </div>
                }
            </div>
        }
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="text-center text-lg-start text-white" id="footer" style="background-color: #3e4551; bottom: 0px; width: 100%; height: 100%;">
        <div class="container p-4 pb-5">
            <section class="">
                <div class="row h-100">
                    <div class="col-md-4">
                        <!-- Información de los contactos  -->
                        @{await Html.RenderPartialAsync("~/Views/Shared/Info.cshtml"); }
                    </div>                   
                </div>
            </section>
        </div>
        <div class="text-center p-1">
            <p>&copy; @DateTime.Now.Year METICS</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.9.2/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
