@using webMetics.Controllers
@using System.Text.Json
@{
    ViewBag.Title = "Inscripciones";
    PageHeadingBuilder.Configure(ViewContext, Url, title: "Lista de inscripciones");
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid table-page-with-divider">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />
        @await Html.PartialAsync("_MeticsToast")

        <div style="padding-bottom: 220px;">
            <section class="file-management-card" aria-labelledby="inscripcionFileManagementTitle">
                <header class="file-management-header">
                    <h2 id="inscripcionFileManagementTitle">Gestión de archivos</h2>
                    <p>Importa y exporta información de inscripciones</p>
                </header>

                <div class="file-management-body">
                    <section class="file-management-section" aria-labelledby="importInscripcionesTitle">
                        <div class="file-section-heading">
                            <i class="bi bi-upload" aria-hidden="true"></i>
                            <div>
                                <h3 id="importInscripcionesTitle">Importar inscripciones</h3>
                                <p>Carga un archivo Excel al sistema</p>
                            </div>
                        </div>

                        @using (Html.BeginForm("SubirArchivoExcelInscripciones", "Inscripcion", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inscripcion-import-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="file-management-controls file-import-controls">
                                <input type="file" class="participant-file-input" name="file" id="inscripcionFileInput" accept=".xls,.xlsx" required aria-label="Seleccionar archivo Excel de inscripciones" onchange="updateInscripcionFileName(this)">
                                <label for="inscripcionFileInput" class="file-management-button file-management-button-secondary file-picker-trigger">
                                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                                    <span id="inscripcionFileName">Elegir archivo</span>
                                </label>
                                <button class="file-management-button file-management-button-primary" type="submit">
                                    <i class="bi bi-upload" aria-hidden="true"></i>
                                    Subir
                                </button>
                            </div>
                        }

                        <div class="file-management-note file-requirements-note">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            <p>Subir un archivo en formato <strong>XLS</strong> o <strong>XLSX</strong> con las siguientes columnas: <strong>Correo Institucional, Módulo, Grupo, Horas, Estado, Horas Completadas y Calificación</strong>.</p>
                            <a href="@Url.Action("DescargarPlantillaSubirInscripciones", "Inscripcion")" class="file-management-download-link">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                Descargar plantilla
                            </a>
                        </div>
                    </section>

                    <section class="file-management-section file-export-section" aria-labelledby="exportInscripcionesTitle">
                        <div class="file-section-heading">
                            <i class="bi bi-download" aria-hidden="true"></i>
                            <div>
                                <h3 id="exportInscripcionesTitle">Exportar inscripciones</h3>
                                <p>Descarga los datos en el formato que necesites</p>
                            </div>
                        </div>

                        <div class="file-management-controls file-export-controls">
                            <label class="visually-hidden" for="inscripcionExportFormat">Formato de exportación</label>
                            <select id="inscripcionExportFormat" class="file-management-select">
                                <option value="@Url.Action("ExportarTodosParticipantesPDF", "Inscripcion", new { searchTerm = Context.Request.Query["searchTerm"] })">PDF</option>
                                <option value="@Url.Action("ExportarTodosParticipantesExcel", "Inscripcion", new { searchTerm = Context.Request.Query["searchTerm"] })">Excel</option>
                                <option value="@Url.Action("ExportarTodosParticipantesWord", "Inscripcion", new { searchTerm = Context.Request.Query["searchTerm"] })" selected>Word</option>
                            </select>
                            <button type="button" id="downloadInscripcionExport" class="file-management-button file-management-button-secondary">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                Descargar
                            </button>
                        </div>

                        <div class="file-management-note file-export-note">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            <p>Formatos disponibles para descargar: PDF, Excel y Word.</p>
                        </div>
                    </section>
                </div>
            </section>


            <!-- Sección de Asignación de Medallas -->
            <form method="post" asp-controller="Participante" asp-action="AsignarMedallaMasiva" asp-antiforgery="false" id="formAsignarMedallas">
                @Html.AntiForgeryToken()
                <div id="selectedParticipantsInputs"></div>
                <section class="medal-assignment-card mb-4" aria-labelledby="medalAssignmentTitle">
                    <header class="medal-assignment-header">
                        <i class="bi bi-award" aria-hidden="true"></i>
                        <div>
                            <h2 id="medalAssignmentTitle">Asignación masiva de medallas</h2>
                            <p>Selecciona las medallas y los participantes a quienes deseas asignarlas.</p>
                        </div>
                    </header>

                    <div class="medal-assignment-layout">
                        <section class="medal-gallery-section" aria-labelledby="medalGalleryTitle">
                            <label class="medal-section-label" id="medalGalleryTitle" for="medalla-search">Seleccionar medalla</label>
                            <div class="input-group medal-search-group">
                                <input type="text" class="form-control" id="medalla-search" onkeyup="filterMedals()" placeholder="Buscar medalla..." aria-label="Buscar medalla">
                                <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                            </div>

                            @if (ViewBag.TodasLasMedallas != null && ViewBag.TodasLasMedallas.Count > 0)
                            {
                                <div class="medal-carousel" aria-label="Navegación de medallas">
                                    <button type="button" class="medal-carousel-button" id="medalCarouselPrevious" onclick="navigateMedalCarousel(-1)" aria-label="Ver medallas anteriores" aria-controls="medalCarouselViewport" disabled>
                                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                    </button>
                                    <div class="medal-gallery-scroll" id="medalCarouselViewport" role="region" aria-label="Galería de medallas" tabindex="0" aria-live="polite">
                                        <div id="medalla-list" class="medalla-list-container">
                                            @foreach (var medalla in ViewBag.TodasLasMedallas)
                                            {
                                                <div class="medalla-item medal-option-card">
                                                    <img src="@Url.Content("~/images/medallas/" + Uri.EscapeDataString((string)medalla))" alt="Medalla: @medalla" class="medalla-image" />
                                                    <div class="form-check">
                                                        <label class="form-check-label">
                                                            <input class="form-check-input" type="checkbox" id="medallaSeleccionada" name="nombreMedalla" value="@medalla" aria-label="Seleccionar medalla @medalla">
                                                            <span>@medalla</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" class="medal-carousel-button" id="medalCarouselNext" onclick="navigateMedalCarousel(1)" aria-label="Ver más medallas" aria-controls="medalCarouselViewport">
                                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="medal-gallery-empty">No hay medallas disponibles.</p>
                            }
                        </section>

                        <aside class="medal-assignment-panel" aria-labelledby="assignmentSummaryTitle">
                            <h3 id="assignmentSummaryTitle">Resumen de asignación</h3>
                            <div class="medal-participant-summary" aria-live="polite" aria-atomic="true">
                                <i class="bi bi-people" aria-hidden="true"></i>
                                <div>
                                    <span>Participantes seleccionados</span>
                                    <strong id="selectedCount">0</strong>
                                </div>
                            </div>
                            <p class="medal-selection-hint"><i class="bi bi-info-circle-fill" aria-hidden="true"></i> Selecciona participantes desde la tabla de inscripciones.</p>
                            <div class="medal-assignment-actions">
                                <button type="button" class="btn btn-outline-primary" onclick="selectAllParticipants()" aria-pressed="false">
                                    <i class="bi bi-check-all" aria-hidden="true"></i><span id="selectPageParticipantsText">Seleccionar página</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="clearAllParticipants()">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i>Limpiar
                                </button>
                                <button type="submit" class="btn btn-success" id="btnAsignarMedallas">
                                    <i class="bi bi-award" aria-hidden="true"></i>Asignar Medallas
                                </button>
                            </div>
                        </aside>
                    </div>
                </section>
            </form>

                <div class="table-card">
                    <div class="table-card-header">
                        <div class="table-card-heading">
                            <span class="table-card-title">Inscripciones</span>
                            <span class="table-card-desc">Listado de inscripciones registradas en el sistema</span>
                        </div>
                    </div>

                    <div class="table-toolbar">
                        <div class="table-toolbar-group">
                            <form id="refreshForm2" method="get" action="@Url.Action("VerInscripciones", "Inscripcion")" style="margin: 0;">
                                <button type="submit" class="icon-action icon-view" id="refreshButton2" title="Recargar datos">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </form>

                            <div class="table-pagesize">
                                <label for="inscripcionPageSize">Mostrar</label>
                                <select id="inscripcionPageSize">
                                    <option>5</option>
                                    <option>10</option>
                                    <option>25</option>
                                    <option selected>50</option>
                                </select>
                                <label for="inscripcionPageSize">registros</label>
                            </div>

                            <form asp-action="VerInscripciones" asp-controller="Inscripcion" method="get" class="table-search">
                                <input type="text" name="searchTerm" class="form-control" placeholder="Buscar inscripción" value="@Context.Request.Query["searchTerm"]" />
                                <button class="btn" type="submit"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                    </div>

                    <div class="table-scroll table-scroll--fit">
                        <table id="inscripcionTblCustomers" class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="text-center" style="width: 3%;">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="selectAllCheckbox" onchange="toggleAllParticipants()">
                                        </div>
                                    </th>
                                    <th scope="col" style="width: 8%;">Nombre</th>
                                    <th scope="col" style="width: 7%;">Primer Apellido</th>
                                    <th scope="col" style="width: 7%;">Segundo Apellido</th>
                                    <th scope="col" style="width: 12%;">Correo Institucional</th>
                                    <th scope="col" style="width: 15%;">Módulo</th>
                                    <th scope="col" style="width: 8%;">Estado</th>
                                    <th scope="col" class="text-center" style="width: 8%;">Horas Inscritas</th>
                                    <th scope="col" class="text-center" style="width: 8%;">Horas Aprobadas</th>
                                    <th scope="col" class="text-center" style="width: 4%;">Ver</th>
                                    <th scope="col" class="text-center" style="width: 8%;">Eliminar</th>
                                </tr>
                            </thead>

                            <tbody></tbody>
                        </table>
                    </div>

                    <div id="inscripcionTblPaginacion" class="table-pagination"></div>
                </div>
        </div>
    </div>

    <!-- Ventana emergente de eliminación -->
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Eliminar inscripción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Está seguro de que desea eliminar la inscripción de este participante?
                    <br />
                    @using (Html.BeginForm("EliminarInscripcion", "Inscripcion"))
                    {
                        @Html.AntiForgeryToken()

                        <div class="modal-footer">
                            <input type="hidden" id="nombreGrupo" name="nombreGrupo">
                            <input type="hidden" id="numeroGrupo" name="numeroGrupo">
                            <input type="hidden" id="idParticipante" name="idParticipante">

                            <input type="submit" class="btn btn-danger" value="Aceptar" />
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript para la funcionalidad de selección de participantes y filtro de medallas -->
    <script>
        const selectedParticipants = new Set();

        function updateInscripcionFileName(fileInput) {
            const fileNameLabel = document.getElementById('inscripcionFileName');
            if (!fileNameLabel) return;

            const selectedFile = fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
            fileNameLabel.textContent = selectedFile ? selectedFile.name : 'Elegir archivo';
            fileNameLabel.title = selectedFile ? selectedFile.name : '';
        }

        document.getElementById('downloadInscripcionExport').addEventListener('click', function () {
            const exportUrl = document.getElementById('inscripcionExportFormat').value;
            if (exportUrl) {
                window.location.assign(exportUrl);
            }
        });

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[character]);
        }

        function syncSelectedParticipantInputs() {
            const container = document.getElementById('selectedParticipantsInputs');
            container.innerHTML = '';

            selectedParticipants.forEach(idParticipante => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'participantesSeleccionados';
                input.value = idParticipante;
                container.appendChild(input);
            });
        }

        function updateSelectedCount() {
            const pageCheckboxes = Array.from(document.querySelectorAll('.participant-checkbox'));
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            document.getElementById('selectedCount').textContent = selectedParticipants.size;
            const selectPageButton = document.querySelector('.medal-assignment-actions button[onclick="selectAllParticipants()"]');
            const selectPageText = document.getElementById('selectPageParticipantsText');
            const allPageSelected = pageCheckboxes.length > 0 && pageCheckboxes.every(checkbox =>
                selectedParticipants.has(checkbox.dataset.participantId));

            if (selectPageText) {
                selectPageText.textContent = allPageSelected ? 'Deseleccionar página' : 'Seleccionar página';
            }
            if (selectPageButton) {
                selectPageButton.setAttribute('aria-pressed', String(allPageSelected));
            }

            if (pageCheckboxes.length === 0) {
                selectAllCheckbox.indeterminate = false;
                selectAllCheckbox.checked = false;
                return;
            }

            const selectedOnPage = pageCheckboxes.filter(checkbox =>
                selectedParticipants.has(checkbox.dataset.participantId));

            if (selectedOnPage.length === 0) {
                selectAllCheckbox.indeterminate = false;
                selectAllCheckbox.checked = false;
            } else if (selectedOnPage.length === pageCheckboxes.length) {
                selectAllCheckbox.indeterminate = false;
                selectAllCheckbox.checked = true;
            } else {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = true;
            }
        }

        function refreshCurrentPageSelection() {
            document.querySelectorAll('.participant-checkbox').forEach(checkbox => {
                checkbox.checked = selectedParticipants.has(checkbox.dataset.participantId);
            });
            updateSelectedCount();
        }

        function handleParticipantSelection(checkbox) {
            const idParticipante = checkbox.dataset.participantId;
            if (checkbox.checked) {
                selectedParticipants.add(idParticipante);
            } else {
                selectedParticipants.delete(idParticipante);
            }

            syncSelectedParticipantInputs();
            refreshCurrentPageSelection();
        }

        function toggleAllParticipants() {
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');
            const participantCheckboxes = document.querySelectorAll('.participant-checkbox');

            participantCheckboxes.forEach(checkbox => {
                const idParticipante = checkbox.dataset.participantId;
                if (selectAllCheckbox.checked) {
                    selectedParticipants.add(idParticipante);
                } else {
                    selectedParticipants.delete(idParticipante);
                }
            });

            syncSelectedParticipantInputs();
            refreshCurrentPageSelection();
        }

        function selectAllParticipants() {
            const participantCheckboxes = Array.from(document.querySelectorAll('.participant-checkbox'));
            const deselectPage = participantCheckboxes.length > 0 && participantCheckboxes.every(checkbox =>
                selectedParticipants.has(checkbox.dataset.participantId));

            participantCheckboxes.forEach(checkbox => {
                if (deselectPage) {
                    selectedParticipants.delete(checkbox.dataset.participantId);
                } else {
                    selectedParticipants.add(checkbox.dataset.participantId);
                }
            });

            syncSelectedParticipantInputs();
            refreshCurrentPageSelection();
        }

        function clearAllParticipants() {
            selectedParticipants.clear();
            syncSelectedParticipantInputs();
            refreshCurrentPageSelection();
        }

        // ------ Función para filtrar medallas ------
        function filterMedals() {
            const searchInput = document.getElementById('medalla-search').value.toLowerCase();
            const medalItems = document.querySelectorAll('.medalla-item');

            medalItems.forEach(item => {
                const label = item.querySelector('.form-check-label').textContent.toLowerCase();
                if (label.includes(searchInput)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });

            const viewport = document.getElementById('medalCarouselViewport');
            if (viewport) {
                viewport.scrollLeft = 0;
                updateMedalCarouselControls();
            }
        }

        function navigateMedalCarousel(direction) {
            const viewport = document.getElementById('medalCarouselViewport');
            if (!viewport) return;

            viewport.scrollBy({ left: direction * viewport.clientWidth * 0.8, behavior: 'smooth' });
        }

        function updateMedalCarouselControls() {
            const viewport = document.getElementById('medalCarouselViewport');
            const previousButton = document.getElementById('medalCarouselPrevious');
            const nextButton = document.getElementById('medalCarouselNext');
            if (!viewport || !previousButton || !nextButton) return;

            const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
            previousButton.disabled = viewport.scrollLeft <= 1;
            nextButton.disabled = viewport.scrollLeft >= maxScroll - 1;
        }

        const medalCarouselViewport = document.getElementById('medalCarouselViewport');
        if (medalCarouselViewport) {
            medalCarouselViewport.addEventListener('scroll', updateMedalCarouselControls, { passive: true });
            window.addEventListener('resize', updateMedalCarouselControls);
            updateMedalCarouselControls();
        }

        function actualizarModalEliminarInscripcion(nombreGrupo, numeroGrupo, idParticipante) {
            document.getElementById("nombreGrupo").value = nombreGrupo;
            document.getElementById("numeroGrupo").value = numeroGrupo;
            document.getElementById("idParticipante").value = idParticipante;
            var deleteModal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            deleteModal.show();
        }

        function actualizarModalEliminar(nombreGrupo, numeroGrupo, idParticipante) {
            actualizarModalEliminarInscripcion(nombreGrupo, numeroGrupo, idParticipante);
        }

        const initialSearchTerm = @Html.Raw(JsonSerializer.Serialize(Context.Request.Query["searchTerm"].ToString()));
        const participantDetailsUrl = '@Url.Action("VerDatosParticipante", "Participante")';

        const inscripcionesTable = MeticsTable.initServer({
            tableId: 'inscripcionTblCustomers',
            pageSizeId: 'inscripcionPageSize',
            paginationId: 'inscripcionTblPaginacion',
            ajaxUrl: '@Url.Action("ObtenerInscripcionesPaginadas", "Inscripcion")',
            pageLength: 50,
            initialSearch: initialSearchTerm,
            order: [[1, 'asc']],
            columns: [
                {
                    data: 'idParticipante',
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function (data, type, row) {
                        if (type !== 'display') return data;
                        const participantId = escapeHtml(data);
                        return '<div class="form-check">' +
                            '<input type="checkbox" class="form-check-input participant-checkbox" ' +
                            'id="participante_' + row.idInscripcion + '" ' +
                            'data-participant-id="' + participantId + '" ' +
                            'onchange="handleParticipantSelection(this)">' +
                            '</div>';
                    }
                },
                {
                    data: 'nombre',
                    render: function (data, type, row) {
                        if (type !== 'display') return data;
                        const fullName = [row.nombre, row.primerApellido, row.segundoApellido]
                            .filter(value => value && value !== '-')
                            .join(' ');
                        return '<span class="table-desktop-only">' + escapeHtml(data) + '</span>' +
                            '<span class="table-mobile-only">' + escapeHtml(fullName) + '</span>';
                    }
                },
                { data: 'primerApellido', render: data => escapeHtml(data) },
                { data: 'segundoApellido', render: data => escapeHtml(data) },
                { data: 'correo', render: data => escapeHtml(data) },
                {
                    data: 'nombreGrupo',
                    render: function (data, type, row) {
                        if (type !== 'display') return data;
                        return escapeHtml(data) + ' (Grupo ' + escapeHtml(row.numeroGrupo) + ')';
                    }
                },
                { data: 'estado', render: data => escapeHtml(data) },
                { data: 'horasMatriculadas', className: 'text-center' },
                { data: 'horasAprobadas', className: 'text-center' },
                {
                    data: 'idParticipante',
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function (data, type) {
                        if (type !== 'display') return data;
                        const url = participantDetailsUrl + '?idParticipante=' + encodeURIComponent(data) + '&breadcrumbOrigin=inscriptions';
                        return '<a href="' + escapeHtml(url) + '" class="icon-action icon-view bi bi-search" ' +
                            'title="Ver datos del participante"></a>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function (data, type, row) {
                        if (type !== 'display') return '';
                        return '<a href="#" class="icon-action icon-delete bi bi-trash js-delete-inscripcion" ' +
                            'data-nombre-grupo="' + escapeHtml(row.nombreGrupo) + '" ' +
                            'data-numero-grupo="' + row.numeroGrupo + '" ' +
                            'data-id-participante="' + escapeHtml(row.idParticipante) + '" ' +
                            'title="Eliminar inscripción"></a>';
                    }
                }
            ],
            onDraw: function () {
                refreshCurrentPageSelection();
                if (window.__meticsFinishScrollRestore) {
                    window.__meticsFinishScrollRestore();
                }
            }
        });

        document.getElementById('inscripcionTblCustomers').addEventListener('click', function (event) {
            const deleteLink = event.target.closest('.js-delete-inscripcion');
            if (!deleteLink) return;

            event.preventDefault();
            actualizarModalEliminarInscripcion(
                deleteLink.dataset.nombreGrupo,
                deleteLink.dataset.numeroGrupo,
                deleteLink.dataset.idParticipante);
        });

        document.getElementById('formAsignarMedallas').addEventListener('submit', function () {
            syncSelectedParticipantInputs();
            history.scrollRestoration = 'manual';
            sessionStorage.setItem('metics-inscripcion-assignment-scroll', JSON.stringify({
                top: window.scrollY,
                savedAt: Date.now()
            }));
        });
    </script>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}
