@model webMetics.Models.CategoriaModel
@using webMetics.Controllers
@{
    ViewBag.Title = "Crear nivel";
    PageHeadingBuilder.Configure(ViewContext, Url);

}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid required-update-page admin-panel-page category-form-page">
        @using (Html.BeginForm("CrearCategoria", "Categoria", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            @await Html.PartialAsync("_MeticsToast")

            <section class="admin-panel-card required-update-card" aria-labelledby="formularioTitulo">
                <div class="required-update-header">
                    <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                    <div>
                        <h2 class="required-update-title" id="formularioTitulo">Crear nivel</h2>
                        <p class="admin-panel-card-desc">Revise los datos del nivel y vuelva a guardarlo.</p>
                    </div>
                </div>
                @await Html.PartialAsync("_CategoriaFormFields", Model ?? new webMetics.Models.CategoriaModel())

                <div class="category-form-actions">
                    <a href="#" class="btn admin-panel-btn-secondary" onclick="history.go(-1); return false;">Cancelar</a>
                    <input type="submit" class="btn admin-panel-btn-primary" value="Guardar nivel" />
                </div>
            </section>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}
