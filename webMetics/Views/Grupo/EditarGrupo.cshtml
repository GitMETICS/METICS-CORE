@model webMetics.Models.GrupoModel
@using webMetics.Controllers
@using webMetics.Helpers
@{

    ViewBag.Title = "Editar módulo";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@{
    string defaultAsesorId = "";
    if (ViewBag.Role == 2)
    {
        defaultAsesorId = ViewBag.Id;
    }
}

@if (ViewBag.Id != "" && (ViewBag.Role == 1 || ViewBag.Role == 2))
{
    <div class="contenedor-caja container-fluid create-group-page table-page-with-divider edit-group-page">
        @using (Html.BeginForm("EditarGrupo", "Grupo", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            @await Html.PartialAsync("_MeticsToast")

            @Html.HiddenFor(grupoModel => grupoModel.idGrupo, new { })
            @Html.HiddenFor(grupoModel => grupoModel.cupoActual, new { })
            @Html.HiddenFor(grupoModel => grupoModel.esVisible, new { })

            <div class="create-group-sections">
                <section class="create-group-card" aria-labelledby="editGroupGeneralTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                        <div>
                            <h2 id="editGroupGeneralTitle">Información general</h2>
                            <p>Datos principales del módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="form-group mt-1 create-group-full-field">
                            @Html.LabelFor(grupoModel => grupoModel.nombre) <span class="create-group-required" aria-hidden="true">*</span>
                            @Html.TextBoxFor(grupoModel => grupoModel.nombre, new { @class = "form-control", @maxlength = "256", @autocomplete = "off" })
                            @Html.ValidationMessageFor(grupoModel => grupoModel.nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-1 create-group-full-field">
                            @Html.LabelFor(grupoModel => grupoModel.descripcion)
                            @Html.TextAreaFor(grupoModel => grupoModel.descripcion, new { @class = "form-control", @rows = "3", @maxlength = "5000", @autocomplete = "off" })
                            @Html.ValidationMessageFor(grupoModel => grupoModel.descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.numeroGrupo) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.numeroGrupo, new { @type = "number", @class = "form-control", @min = "1", @max = "100", @value = "" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.numeroGrupo, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.modalidad, new { @for = "modalidadSelect" })
                                <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(
                                         grupoModel => grupoModel.modalidad,
                                         new SelectList(
                                         Enum.GetValues(typeof(webMetics.Models.TipoModalidad))
                                         .Cast<webMetics.Models.TipoModalidad>()
                                         .Select(e => new { Value = e, Text = EnumHelper.GetDisplayName(e) }),
                                         "Value",
                                         "Text"),
                                         "Seleccione un tipo de modalidad...",
                                         new { @class = "form-control", @id = "modalidadSelect" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.modalidad, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.cantidadHoras) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.cantidadHoras, new { @type = "number", @class = "form-control", @min = "0", @value = "" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.cantidadHoras, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.cupo) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.cupo, new { @type = "number", @class = "form-control", @min = "0", @value = "" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.cupo, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="editGroupLocationTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <div>
                            <h2 id="editGroupLocationTitle">Ubicación y acceso</h2>
                            <p>Información para acceder y participar en el módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.lugar)
                                @Html.TextBoxFor(grupoModel => grupoModel.lugar, new { @class = "form-control", @maxlength = "256", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.lugar, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.enlace)
                                @Html.TextBoxFor(grupoModel => grupoModel.enlace, new { @class = "form-control", @maxlength = "1000", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.enlace, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.claveInscripcion)
                                @Html.TextBoxFor(grupoModel => grupoModel.claveInscripcion, new { @class = "form-control", @maxlength = "1000", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.claveInscripcion, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.horario)
                                @Html.TextBoxFor(grupoModel => grupoModel.horario, new { @placeholder = "Ejemplo: L - V de 7am a 9am", @class = "form-control", @maxlength = "200", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.horario, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                @{
                    var temas = ViewData["Temas"] as List<SelectListItem> ?? new List<SelectListItem>(); // Default to an empty list if null
                    var temasSeleccionados = ViewData["TemasSeleccionadosCheckList"] as List<SelectListItem> ?? new List<SelectListItem>(); // Default to an empty list if null
                    var indiceTema = 0;
                }

                <section class="create-group-card" aria-labelledby="editGroupClassificationTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-mortarboard" aria-hidden="true"></i>
                        <div>
                            <h2 id="editGroupClassificationTitle">Clasificación académica</h2>
                            <p>Competencias, nivel y facilitación del módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="form-group mt-1 create-group-competencies">
                            @Html.LabelFor(grupoModel => grupoModel.TemasSeleccionados) <span class="create-group-required" aria-hidden="true">*</span>

                            <div class="create-group-checkbox-grid">
                                @foreach (var item in temas)
                                {
                                    bool isChecked = temasSeleccionados.Any(t => t.Value == item.Value);
                                    var idCheckboxTema = $"competencia_{indiceTema++}";

                                    <div class="form-check">
                                        <input type="checkbox" id="@idCheckboxTema" name="TemasSeleccionados" value="@item.Value" class="form-check-input" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label" for="@idCheckboxTema">@item.Text</label>
                                    </div>
                                }
                            </div>

                            @Html.ValidationMessageFor(model => model.TemasSeleccionados, "", new { @class = "text-danger" })
                        </div>

                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.nombreCategoria, new { @for = "idCategoria" }) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(grupoModel => grupoModel.idCategoria, ViewData["Categorias"] as List<SelectListItem>, "Seleccione un nivel...", new { @class = "form-select" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.nombreCategoria, "", new { @class = "text-danger" })
                            </div>

                            @if (ViewBag.Role == 2)
                            {
                                @Html.DropDownListFor(
                                         grupoModel => grupoModel.idAsesor,
                                         new SelectList(ViewData["Asesores"] as List<SelectListItem>, "Value", "Text", defaultAsesorId),
                                         "Seleccione un(a) facilitador(a)...",
                                         new { @class = "form-select", @hidden = true }
                                         )
                            }
                            else
                            {
                                <div class="form-group mt-1">
                                    @Html.LabelFor(grupoModel => grupoModel.nombreAsesor, new { @for = "asesorSelect" })
                                    @Html.DropDownListFor(
                                             grupoModel => grupoModel.idAsesor,
                                             new SelectList(ViewData["Asesores"] as List<SelectListItem>, "Value", "Text"),
                                             "Seleccione un(a) facilitador(a)...",
                                             new { @class = "form-select", @id = "asesorSelect" }
                                             )
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.nombreAsesor, "", new { @class = "text-danger" })
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="editGroupDatesTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <div>
                            <h2 id="editGroupDatesTitle">Fechas del módulo</h2>
                            <p>Define los períodos de inscripción y ejecución</p>
                        </div>
                    </header>
                    <div class="create-group-card-body create-group-date-groups">
                        <section class="create-group-date-block" aria-labelledby="editGroupEnrollmentDatesTitle">
                            <h3 id="editGroupEnrollmentDatesTitle">Fechas de inscripción</h3>
                            <div class="create-group-field-grid">
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaInicioInscripcion)
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaInicioInscripcion, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaInicioInscripcion, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaFinalizacionInscripcion)
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaFinalizacionInscripcion, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaFinalizacionInscripcion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </section>

                        <section class="create-group-date-block" aria-labelledby="editGroupExecutionDatesTitle">
                            <h3 id="editGroupExecutionDatesTitle">Fechas del módulo</h3>
                            <div class="create-group-field-grid">
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaInicioGrupo)
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaInicioGrupo, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaInicioGrupo, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaFinalizacionGrupo)
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaFinalizacionGrupo, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaFinalizacionGrupo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </section>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="editGroupAttachmentTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                        <div>
                            <h2 id="editGroupAttachmentTitle">Archivo adjunto</h2>
                            <p>Consulte el archivo actual o adjunte uno nuevo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        @if (ViewBag.Adjunto != null && ViewBag.Adjunto.Length > 0)
                        {
                            <div class="edit-group-current-file">
                                <span class="edit-group-file-label">Archivo actual</span>
                                <div class="edit-group-file-row">
                                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                    <span class="edit-group-file-name">@Model.nombreArchivo</span>
                                    <a class="edit-group-file-download" href="@Url.Action("DescargarArchivo", "Grupo", new { idGrupo = Model.idGrupo })" title="Descargar archivo" aria-label="Descargar archivo">
                                        <i class="bi bi-download" aria-hidden="true"></i>
                                    </a>
                                </div>
                                <iframe class="edit-group-file-preview" id="pdfPreview" src="data:application/pdf;base64,@(ViewBag.Adjunto)" width="100%" height="500" title="Vista previa del archivo actual"></iframe>
                            </div>
                        }

                        <div class="form-group">
                            @Html.Label("archivoAdjunto", "Adjuntar nuevo archivo", new { @for = "archivoAdjunto" })
                            <div class="file-management-controls file-import-controls group-file-picker">
                                @Html.TextBoxFor(grupoModel => grupoModel.archivoAdjunto, null, new { type = "file", @class = "participant-file-input", onchange = "actualizarNombreArchivoGrupo(this)" })
                                <label for="archivoAdjunto" class="file-management-button file-management-button-secondary file-picker-trigger">
                                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                                    <span id="archivoAdjuntoNombre">Elegir archivo</span>
                                </label>
                            </div>
                            <p class="edit-group-file-help">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>Subir un archivo en formato <strong>PDF</strong> menor a 5 MB.
                            </p>
                        </div>
                    </div>
                </section>
            </div>

            <div class="create-group-actions">
                <a href="#" class="btn create-group-action-button create-group-action-cancel" onclick="history.go(-1); return false;">Cancelar</a>
                <input type="submit" class="btn btn-primary create-group-action-button create-group-action-save" value="Guardar" />
            </div>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<style>
    /* Detalles propios de "Editar módulo"; el resto reutiliza el diseño de "Crear módulo". */
    .edit-group-page .edit-group-current-file { margin-bottom: var(--metics-space-5); }
    .edit-group-page .edit-group-file-label { color: var(--metics-ink-strong); display: block; font-weight: var(--metics-font-weight-semibold); margin-bottom: var(--metics-space-2); }
    .edit-group-page .edit-group-file-row {
        align-items: center;
        background: var(--metics-icon-surface);
        border: 1px solid var(--metics-border-modal);
        border-radius: var(--metics-radius-lg);
        display: flex;
        gap: var(--metics-space-2-5);
        padding: var(--metics-space-2-5) var(--metics-space-3);
    }
    .edit-group-page .edit-group-file-row > .bi { color: var(--metics-interactive-blue); font-size: var(--metics-font-size-xl); }
    .edit-group-page .edit-group-file-name { color: var(--metics-ink-strong); flex: 1 1 auto; font-weight: var(--metics-font-weight-semibold); min-width: 0; overflow-wrap: anywhere; }
    .edit-group-page .edit-group-file-download {
        align-items: center;
        border-radius: var(--metics-radius-md);
        color: var(--metics-interactive-blue);
        display: inline-flex;
        height: var(--metics-icon-button-sm);
        justify-content: center;
        text-decoration: none;
        width: var(--metics-icon-button-sm);
    }
    .edit-group-page .edit-group-file-download:hover,
    .edit-group-page .edit-group-file-download:focus-visible { background: var(--metics-soft-blue); color: var(--metics-action-hover); }
    .edit-group-page .edit-group-file-preview { border: 1px solid var(--metics-border-card); border-radius: var(--metics-radius-lg); margin-top: var(--metics-space-3); }
    .edit-group-page .edit-group-file-help { color: var(--metics-ink-muted-alt); font-size: var(--metics-font-size-xs); margin: var(--metics-space-2) 0 0; }
    .edit-group-page .edit-group-file-help .bi { color: var(--metics-interactive-blue); margin-right: var(--metics-space-1); }
    @@media (max-width: 575.98px) {
        .edit-group-page .edit-group-file-preview { height: 360px; }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        function verificarModalidad() {
            var modalidadSeleccionada = $('#modalidadSelect').val();
            if (modalidadSeleccionada === '@webMetics.Models.TipoModalidad.Autogestionado') {
                $('#asesorSelect').prop('disabled', true);
                $('#asesorSelect').val('');
                $('#horario').prop('disabled', true);
                $('#horario').val('');
                $('#lugar').prop('disabled', true);
                $('#lugar').val('');
            } else {
                if ('@ViewBag.Role' && '@ViewBag.Role' != 2) {
                    $('#asesorSelect').prop('disabled', false);
                }
                $('#horario').prop('disabled', false);
                $('#lugar').prop('disabled', false);
            }
        }

        verificarModalidad();

        // Llamar a la función cuando cambie la modalidad
        $('#modalidadSelect').change(function () {
            verificarModalidad();
        });
        $('#modalidadSelect').hover(function () {
            deshabilitarAsesor();
        });
    });
</script>
<script src="~/js/metics-form-controls.js" asp-append-version="true"></script>
<script>
    // Mismo calendario y misma lista desplegable que "Crear módulo" (solo presentación).
    (function () {
        var root = document.querySelector('.edit-group-page');
        if (!root || !window.MeticsFormControls) return;
        MeticsFormControls.initDatePickers(root);
        MeticsFormControls.initSelects(root);
    })();
</script>

<script>
    // Muestra el nombre del archivo elegido en el selector (solo presentación; el campo y su envío no cambian).
    function actualizarNombreArchivoGrupo(input) {
        var etiqueta = document.getElementById('archivoAdjuntoNombre');
        if (!etiqueta) return;
        var archivo = input.files && input.files.length ? input.files[0] : null;
        etiqueta.textContent = archivo ? archivo.name : 'Elegir archivo';
        etiqueta.title = archivo ? archivo.name : '';
    }
</script>
