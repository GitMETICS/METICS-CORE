                                    }
                                    <div class="module-card-details">
                                        <div class="module-card-detail">
                                            <span class="module-card-detail-label"><i class="bi bi-people" aria-hidden="true"></i>Número de grupo</span>
                                            <span class="module-card-detail-value">@grupo.numeroGrupo</span>
                                        </div>
                                        <div class="module-card-detail">
                                            <span class="module-card-detail-label"><i class="bi bi-clock" aria-hidden="true"></i>Cantidad de horas</span>
                                            <span class="module-card-detail-value">@grupo.cantidadHoras</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(grupo.nombreAsesor))
                                        {
                                            <div class="module-card-detail module-card-detail-wide">
                                                <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador(a)</span>
                                                <span class="module-card-detail-value">@grupo.nombreAsesor</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @if (grupo.modalidad == "Autogestionado")
                                            {
                                                <div class="module-card-detail module-card-detail-wide">
                                                    <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador</span>
                                                    <span class="module-card-detail-value">Equipo del Área de Asesoría Docente de la Unidad METICS</span>
                                                </div>
                                            }
                                        }
                                        <div class="module-card-detail module-card-detail-wide">
                                            <span class="module-card-detail-label"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Área(s) de competencia</span>
                                            <span class="module-card-detail-value">
                                                @if (grupo.TemasSeleccionadosNombres != null)
                                                {
                                                    @String.Join(", ", grupo.TemasSeleccionadosNombres)
                                                }
                                                else
                                                {
                                                    <span>No hay temas asociados.</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="module-card-detail module-card-detail-wide">
                                            <span class="module-card-detail-label"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i>Nivel</span>
                                            <span class="module-card-detail-value">@grupo.nombreCategoria</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(grupo.enlace))
                                        {
                                            <div class="module-card-detail module-card-detail-wide module-card-detail-mv">
                                                <span class="module-card-detail-label"><span class="module-card-mv-logo" aria-hidden="true"><img src="~/images/images-removebg-preview.png" alt="" /></span>Mediación Virtual</span>
                                                <span class="module-card-detail-value">
                                                    <a class="module-card-mv-link" href="@grupo.enlace" target="_blank" rel="noopener noreferrer">Abrir enlace<span class="visually-hidden"> de Mediación Virtual (se abre en otra pestaña)</span> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                                </span>
                                            </div>
                                        }
                                    </div>


                                    <div class="module-card-actions module-enrolled-actions">
                                        <button class="btn admin-panel-btn-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalDesinscribir" onclick="actualizarModalDesinscribir(@grupo.idGrupo)"><i class="bi bi-person-dash" aria-hidden="true"></i> Desinscribirse</button>
                                    </div>
                                </div>
                                    <div class="card-footer text-muted">
                                        <span class="module-card-location"><i class="bi bi-geo-alt" aria-hidden="true"></i>
                                        @if (string.Equals(grupo.modalidad, "presencial", StringComparison.OrdinalIgnoreCase))
                                        {
                                            @grupo.lugar
                                        }
                                        else
                                        {
                                                @EnumHelper.GetDisplayName(grupo.modalidad)
                                        }
                                        </span>
                                        <span class="module-card-schedule"><i class="bi bi-clock" aria-hidden="true"></i>@grupo.horario</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- Grupos disponibles para inscripción -->
        <section class="module-catalog-toolbar" aria-labelledby="moduleCatalogTitle">
            <h1 metics-page-heading id="moduleCatalogTitle" class="module-catalog-title">@ViewBag.Title</h1>
            <div class="module-toolbar-controls">
                <form asp-action="BuscarGrupos" asp-controller="Grupo" method="get" class="module-search-form" role="search">
                    <div class="module-search-control">
                        <button class="module-search-submit" type="submit" aria-label="Buscar módulos">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </button>
                        <input type="text" name="searchTerm" class="form-control module-search-input" placeholder="Buscar módulo" aria-label="Buscar módulo" value="@Context.Request.Query["searchTerm"]" />
                    </div>
                    <input type="number" name="userRole" value="@ViewBag.Role" hidden />
                    <input type="text" name="userId" value="@ViewBag.Id" hidden />
                    <input type="hidden" id="currentFilterParam" name="filter" value="@(Context.Request.Query["filter"] == string.Empty ? Context.Request.Query["filter"] : "all")" />
                </form>

                <div class="btn-group module-filter-group" role="group" id="filterButtons" aria-label="Filtrar módulos">
                    <button type="button" class="btn btn-secondary" data-filter="all" aria-pressed="true" onclick="filterModules('all', this)">Todos</button>
                    <button type="button" class="btn btn-outline-secondary" data-filter="active" aria-pressed="false" onclick="filterModules('active', this)">Activos</button>
                    @if (ViewBag.Role == 1)
                    {
                        <button type="button" class="btn btn-outline-secondary" data-filter="inactive" aria-pressed="false" onclick="filterModules('inactive', this)">Inactivos</button>
                    }
                </div>

                <button class="btn btn-secondary module-view-toggle" type="button" id="toggleViewBtn2" onclick="toggleView()">
                    <i class="bi bi-list-ul me-2" aria-hidden="true"></i>Modo lista
                </button>
            </div>
        </section>

        <div class="view-container" id="viewContainer">
            <div class="row d-none" id="gridView">
                @foreach (var grupo in ViewBag.ListaGrupos)
                {
                    var estadoGrupo = grupo.esVisible == true ? "is-active" : "is-inactive";
                    var visibleInicialmente = grupo.esVisible == true || ViewBag.Role == 1;

                    DateTime fechaInicioInscripcion = grupo.fechaInicioInscripcion.Date.AddDays(-1).AddSeconds(1);
                    DateTime fechaFinInscripcion = grupo.fechaFinalizacionInscripcion.Date.AddDays(1).AddSeconds(-1);

                    if (visibleInicialmente)
                    {
                        var visibleStyle = grupo.esVisible == false ? "opacity:0.5" : "";
                        <div class="col-12 col-md-6 mb-4 module-item module-card-item @estadoGrupo" id="module-@grupo.idGrupo" style="@visibleStyle">
                            <div class="card h-100 text-center mb-1">
                                <div class="card-header">
                                    <div>
                                        <div style="float:left">
                                            @if (grupo.cupoActual < grupo.cupo)
                                            {
                                                <span class="badge bg-info" style="float:left; margin-right: 10px;">Cupo: @(grupo.cupo - grupo.cupoActual)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" style="float:left; margin-right: 10px;">Sin cupo</span>
                                            }
                                            @if (ViewBag.DateNow.Date > fechaFinInscripcion)
                                            {
                                                <span class="badge bg-danger" style="float:left; margin-right: 10px;">Inscripción finalizada</span>
                                            }
                                            @if (ViewBag.Role == 1)
                                            {
                                                <span class="badge bg-info" style="float:left; margin-right: 10px;">Inscripciones: @(grupo.cupoActual)</span>
                                            }
                                        </div>
                                        @if (ViewBag.Role == 1 || ViewBag.Role == 2)
                                        {
                                            <div style="float:right">
                                                <a href="@Url.Action("CopiarGrupo", "Grupo", new { idGrupo = grupo.idGrupo })" class="module-admin-action" aria-label="Copiar módulo @grupo.nombre" title="Copiar módulo"><i class="bi bi-clipboard" aria-hidden="true"></i></a>
                                                <button type="button" class="module-admin-action" data-bs-toggle="modal" data-bs-target="#modalEditar" onclick="actualizarModalEditar(@grupo.idGrupo)" aria-label="Editar módulo @grupo.nombre" title="Editar módulo"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                @if (ViewBag.Role == 1)
                                                {
                                                    <button type="button" class="module-admin-action" data-bs-toggle="modal" data-bs-target="#modalEliminar" onclick="actualizarModalEliminar(@grupo.idGrupo)" aria-label="Eliminar módulo @grupo.nombre" title="Eliminar módulo"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                                    if (grupo.esVisible == true)
                                                    {
                                                        <!--El grupo no esta visible -->
                                                        <a href="@Url.Action("CambiarEstadoVisible", "Grupo", new { idGrupo = grupo.idGrupo })" class="module-admin-action" aria-label="Ocultar módulo @grupo.nombre" title="Ocultar módulo"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                                    }
                                                    else
                                                    {
                                                        <!--El grupo esta visible -->
                                                        <a href="@Url.Action("CambiarEstadoVisible", "Grupo", new { idGrupo = grupo.idGrupo })" class="module-admin-action module-admin-action-hidden" aria-label="Mostrar módulo @grupo.nombre" title="Mostrar módulo"><i class="bi bi-eye-slash" aria-hidden="true"></i></a>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <br />
                                </div>
                                <div class="card-body module-card-body">
                                    <div class="module-card-heading"><h4>@grupo.nombre</h4></div>
                                    <div class="module-card-dates">
                                        <div><i class="bi bi-calendar-event" aria-hidden="true"></i><span><small>Fecha de inicio</small><time>@grupo.fechaInicioGrupo.ToString("dd/MM/yyyy")</time></span></div>
                                        <div><i class="bi bi-calendar-check" aria-hidden="true"></i><span><small>Fin del módulo</small><time>@grupo.fechaFinalizacionGrupo.ToString("dd/MM/yyyy")</time></span></div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(grupo.descripcion))
                                    {
                                        <div class="card-text module-card-description" style="line-height: 1.6; font-size: 1rem; padding: 10px;">
                                            @grupo.descripcion.Substring(0, Math.Min(250, grupo.descripcion.Length))
                                            @if (grupo.descripcion.Length > 250)
                                            {
                                                <span class="dots">...</span>
                                                <span class="more" style="display:none;">@grupo.descripcion.Substring(250)</span>
                                                <button class="btn btn-link p-0 see-more-btn" style="color: var(--metics-interactive-blue); font-weight: bold;" onclick="toggleSeeMore(this)">Ver más</button>
                                            }
                                        </div>
                                    }
                                    <div class="module-card-details">
                                        <div class="module-card-detail">
                                            <span class="module-card-detail-label"><i class="bi bi-people" aria-hidden="true"></i>Número de grupo</span>
                                            <span class="module-card-detail-value">@grupo.numeroGrupo</span>
                                        </div>
                                        <div class="module-card-detail">
                                            <span class="module-card-detail-label"><i class="bi bi-clock" aria-hidden="true"></i>Cantidad de horas</span>
                                            <span class="module-card-detail-value">@grupo.cantidadHoras</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(grupo.nombreAsesor))
                                        {
                                            <div class="module-card-detail module-card-detail-wide">
                                                <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador(a)</span>
                                                <span class="module-card-detail-value">@grupo.nombreAsesor</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @if (grupo.modalidad == "Autogestionado")
                                            {
                                                <div class="module-card-detail module-card-detail-wide">
                                                    <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador</span>
                                                    <span class="module-card-detail-value">Equipo del Área de Asesoría Docente de la Unidad METICS</span>
                                                </div>
                                            }
                                        }
                                        <div class="module-card-detail module-card-detail-wide">
                                            <span class="module-card-detail-label"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Área(s) de competencia</span>
                                            <span class="module-card-detail-value">
                                                @if (grupo.TemasSeleccionadosNombres != null)
                                                {
                                                    @String.Join(", ", grupo.TemasSeleccionadosNombres)
                                                }
                                                else
                                                {
                                                    <span>No hay temas asociados.</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="module-card-detail module-card-detail-wide">
                                            <span class="module-card-detail-label"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i>Nivel</span>
                                            <span class="module-card-detail-value">@grupo.nombreCategoria</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(grupo.enlace))
                                        {
                                            <div class="module-card-detail module-card-detail-wide module-card-detail-mv">
                                                <span class="module-card-detail-label"><span class="module-card-mv-logo" aria-hidden="true"><img src="~/images/images-removebg-preview.png" alt="" /></span>Mediación Virtual</span>
                                                <span class="module-card-detail-value">
                                                    <a class="module-card-mv-link" href="@grupo.enlace" target="_blank" rel="noopener noreferrer">Abrir enlace<span class="visually-hidden"> de Mediación Virtual (se abre en otra pestaña)</span> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                                </span>
                                            </div>
                                        }
                                    </div>


                                    <div class="module-card-actions">
                                        @if (ViewBag.Role == 1)
                                        {
                                            <div class="mb-3">
