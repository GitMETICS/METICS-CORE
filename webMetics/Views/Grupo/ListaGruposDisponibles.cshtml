@* Resultado de "Inscribirse" en un popup: se llama a la misma acción Inscripcion/Inscribir y se muestra
   su resultado aquí. Al cerrar, la página se recarga para reflejar la inscripción (igual que al "Regresar"). *@
<div class="modal fade create-category-modal enroll-result-modal" id="modalResultadoInscripcion" tabindex="-1" aria-labelledby="resultadoInscripcionTitulo" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body create-category-modal-body">
                <div class="result-card result-card--modal" id="resultadoInscripcionContenido" aria-live="polite">
                    <span class="result-card-icon is-loading" aria-hidden="true"><span class="spinner-border spinner-border-sm"></span></span>
                    <p class="result-card-message mb-0">Procesando inscripción…</p>
                </div>
            </div>
            <div class="modal-footer create-category-modal-actions">
                <button type="button" class="btn create-category-save" data-bs-dismiss="modal" id="resultadoInscripcionCerrar" disabled>Cerrar</button>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        var modalElemento = document.getElementById('modalResultadoInscripcion');
        if (!modalElemento) return;
        var contenido = document.getElementById('resultadoInscripcionContenido');
        var cerrar = document.getElementById('resultadoInscripcionCerrar');
        var huboInscripcion = false;
        var enCurso = false;

        document.addEventListener('click', function (event) {
            var enlace = event.target.closest('a.module-enroll-btn');
            if (!enlace || enlace.getAttribute('aria-disabled') === 'true' || enlace.classList.contains('disabled')) return;
            var href = enlace.getAttribute('href') || '';
            if (href.indexOf('/Inscripcion/Inscribir') === -1 || !window.bootstrap || !window.fetch) return;

            event.preventDefault();
            if (enCurso) return;
            enCurso = true;
            huboInscripcion = true;
            cerrar.disabled = true;
            contenido.className = 'result-card result-card--modal';
            contenido.innerHTML = '<span class="result-card-icon is-loading" aria-hidden="true"><span class="spinner-border spinner-border-sm"></span></span><p class="result-card-message mb-0">Procesando inscripción…</p>';
            bootstrap.Modal.getOrCreateInstance(modalElemento).show();

            fetch(href, { credentials: 'same-origin' })
                .then(function (respuesta) { return respuesta.text().then(function (html) { return { ok: respuesta.ok, url: respuesta.url, html: html }; }); })
                .then(function (r) {
                    var doc = new DOMParser().parseFromString(r.html, 'text/html');
                    var tarjeta = doc.querySelector('.result-card');
                    if (!r.ok || !tarjeta) {
                        // Respuesta inesperada (p. ej. sesión vencida): se navega como antes.
                        window.location.href = r.url || href;
                        return;
                    }
                    var acciones = tarjeta.querySelector('.result-card-actions');
                    if (acciones) acciones.remove();
                    contenido.className = tarjeta.className + ' result-card--modal';
                    contenido.innerHTML = tarjeta.innerHTML;
                    var titulo = contenido.querySelector('.result-card-title');
                    if (titulo) titulo.id = 'resultadoInscripcionTitulo';
                })
                .catch(function () { window.location.href = href; })
                .finally(function () {
                    enCurso = false;
                    cerrar.disabled = false;
                    cerrar.focus();
                });
        });

        modalElemento.addEventListener('hidden.bs.modal', function () {
            if (huboInscripcion) window.location.reload();
        });
    })();
</script>

