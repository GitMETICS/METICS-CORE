<script>
    // Búsqueda en "mis módulos": filtra al instante las tarjetas inscritas (cuadrícula y lista), sin tildes ni mayúsculas.
    (function () {
        var campo = document.getElementById('buscarMisModulos');
        if (!campo) return;
        var vacio = document.getElementById('misModulosSinResultados');

        function normalizar(texto) {
            return (texto || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, ' ');
        }

        function filtrar() {
            var consulta = normalizar(campo.value.trim());
            var visiblesEnCuadricula = 0;
            ['gridView0', 'listView0'].forEach(function (idVista) {
                var vista = document.getElementById(idVista);
                if (!vista) return;
                vista.querySelectorAll('.module-card-item').forEach(function (tarjeta) {
                    var coincide = !consulta || normalizar(tarjeta.textContent).indexOf(consulta) !== -1;
                    tarjeta.classList.toggle('module-search-hidden', !coincide);
                    if (coincide && idVista === 'gridView0') visiblesEnCuadricula++;
                });
            });
            if (vacio) vacio.hidden = !consulta || visiblesEnCuadricula > 0;
        }

        campo.addEventListener('input', filtrar);
        campo.addEventListener('search', filtrar);
    })();
</script>

<script>
    // Variable global para mantener el estado del filtro
    let currentFilter = "all";

    function filterModules(filter, clickedButton) {
        currentFilter = filter;
        const allModules = document.querySelectorAll('.module-item');
        let visibleCount = 0;

        // 1. Mostrar/Ocultar módulos
        allModules.forEach(module => {
            const isVisible = module.classList.contains('is-active');
            const isInactive = module.classList.contains('is-inactive');

            let shouldShow = false;

            if (filter === 'all') {
                shouldShow = true;
            } else if (filter === 'active' && isVisible) {
                shouldShow = true;
            } else if (filter === 'inactive' && isInactive) {
                // Asumiendo que 'is-inactive' solo existe si Role == 1 lo permite ver
                shouldShow = true;
            }

            if (shouldShow) {
                module.style.display = 'block';
                visibleCount++;
            } else {
                module.style.display = 'none';
            }
        });

        // 2. Actualizar el estado visual de los botones de filtro
        const filterButtons = document.querySelectorAll('#filterButtons .btn');
        filterButtons.forEach(button => {
            button.classList.remove('btn-secondary');
            button.classList.add('btn-outline-secondary');
            button.setAttribute('aria-pressed', 'false');
        });

        if (clickedButton) {
            clickedButton.classList.remove('btn-outline-secondary');
            clickedButton.classList.add('btn-secondary');
            clickedButton.setAttribute('aria-pressed', 'true');
        } else {
            // Caso inicial o si se llama sin botón (p. ej. desde toggleView)
            const defaultButton = document.querySelector(`#filterButtons button[data-filter='${filter}']`);
            if (defaultButton) {
                defaultButton.classList.remove('btn-outline-secondary');
                defaultButton.classList.add('btn-secondary');
                defaultButton.setAttribute('aria-pressed', 'true');
            }
        }

        // 3. Mostrar el mensaje "No hay módulos" si el conteo es 0
        const noModulesMessageGrid = document.getElementById('noModulesMessageGrid');
        const noModulesMessageList = document.getElementById('noModulesMessageList');

        if (noModulesMessageGrid) noModulesMessageGrid.hidden = visibleCount !== 0;
        if (noModulesMessageList) noModulesMessageList.hidden = visibleCount !== 0;

        // 4. Actualizar el campo oculto de la búsqueda si está presente
        const filterParam = document.getElementById('currentFilterParam');
        if (filterParam) {
            filterParam.value = filter;
        }

        // 5. Guardar el filtro en localStorage
        localStorage.setItem('moduleFilter', filter);
    }
</script>

