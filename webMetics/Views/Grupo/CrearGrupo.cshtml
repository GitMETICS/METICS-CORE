@model webMetics.Models.GrupoModel
@using webMetics.Controllers
@using webMetics.Helpers
@{
    ViewBag.Title = "Crear Módulo";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@{
    string defaultAsesorId = "";
    if (ViewBag.Role == 2)
    {
        defaultAsesorId = ViewBag.Id;
    }
}

@if (ViewBag.Id != "" && (ViewBag.Role == 1 || ViewBag.Role == 2))
{
    <div class="contenedor-caja container-fluid create-group-page table-page-with-divider">
        @using (Html.BeginForm("CrearGrupo", "Grupo", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inline-required-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-dark alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.ErrorMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.SuccessMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="create-group-sections">
                <section class="create-group-card" aria-labelledby="createGroupGeneralTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                        <div>
                            <h2 id="createGroupGeneralTitle">Información general</h2>
                            <p>Datos principales del módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="form-group mt-1 create-group-full-field">
                            @Html.LabelFor(grupoModel => grupoModel.nombre) <span class="create-group-required" aria-hidden="true">*</span>
                            @Html.TextBoxFor(grupoModel => grupoModel.nombre, new { @class = "form-control", @maxlength = "256", @autocomplete = "off", @required = "required" })
                            @Html.ValidationMessageFor(grupoModel => grupoModel.nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-1 create-group-full-field">
                            @Html.LabelFor(grupoModel => grupoModel.descripcion)
                            @Html.TextAreaFor(grupoModel => grupoModel.descripcion, new { @class = "form-control", @rows = "3", @maxlength = "5000", @autocomplete = "off" })
                            @Html.ValidationMessageFor(grupoModel => grupoModel.descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.numeroGrupo) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.numeroGrupo, new { @type = "number", @class = "form-control", @required = "required" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.numeroGrupo, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.modalidad)
                                <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(
                                         grupoModel => grupoModel.modalidad,
                                         new SelectList(
                                         Enum.GetValues(typeof(webMetics.Models.TipoModalidad))
                                         .Cast<webMetics.Models.TipoModalidad>()
                                         .Select(e => new { Value = e, Text = EnumHelper.GetDisplayName(e) }),
                                         "Value",
                                         "Text"),
                                         "Seleccione un tipo de modalidad...",
                                         new { @class = "form-control", @id = "modalidadSelect", @required = "required" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.modalidad, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.cantidadHoras) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.cantidadHoras, new { @type = "number", @class = "form-control", @min = "1", @max = "100", @required = "required" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.cantidadHoras, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.cupo) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(grupoModel => grupoModel.cupo, new { @type = "number", @class = "form-control", @min = "1", @max = "5000", @required = "required" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.cupo, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="createGroupLocationTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <div>
                            <h2 id="createGroupLocationTitle">Ubicación y acceso</h2>
                            <p>Información para acceder y participar en el módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.lugar)
                                @Html.TextBoxFor(grupoModel => grupoModel.lugar, new { @class = "form-control", @maxlength = "256", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.lugar, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.enlace)
                                @Html.TextBoxFor(grupoModel => grupoModel.enlace, new { @class = "form-control", @maxlength = "1000", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.enlace, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.claveInscripcion)
                                @Html.TextBoxFor(grupoModel => grupoModel.claveInscripcion, new { @class = "form-control", @maxlength = "1000", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.claveInscripcion, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group mt-1">
                                @Html.LabelFor(grupoModel => grupoModel.horario)
                                @Html.TextBoxFor(grupoModel => grupoModel.horario, new { @placeholder = "Ejemplo: L - V de 7am a 9am", @class = "form-control", @maxlength = "200", @autocomplete = "off" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.horario, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                @{
                    var temas = ViewData["Temas"] as List<SelectListItem> ?? new List<SelectListItem>();
                }

                <section class="create-group-card" aria-labelledby="createGroupClassificationTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-mortarboard" aria-hidden="true"></i>
                        <div>
                            <h2 id="createGroupClassificationTitle">Clasificación académica</h2>
                            <p>Competencias, nivel y facilitación del módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="form-group mt-1 create-group-competencies" data-required-group="TemasSeleccionados">
                            @Html.LabelFor(grupoModel => grupoModel.TemasSeleccionados) <span class="create-group-required" aria-hidden="true">*</span>

                            @{
                                var temasSeleccionados = Model?.TemasSeleccionados ?? new List<int>();
                                var indiceTema = 0;
                            }
                            <div class="create-group-checkbox-grid">
                                @foreach (var item in temas)
                                {
                                    var idCheckboxTema = $"competencia_{indiceTema++}";
                                    var temaSeleccionado = int.TryParse(item.Value, out var idTema) && temasSeleccionados.Contains(idTema);
                                    <div class="form-check">
                                        <input type="checkbox" id="@idCheckboxTema" name="TemasSeleccionados" value="@item.Value" class="form-check-input" checked="@(temaSeleccionado ? "checked" : null)" />
                                        <label class="form-check-label" for="@idCheckboxTema">@item.Text</label>
                                    </div>
                                }
                            </div>

                            @Html.ValidationMessageFor(grupoModel => grupoModel.TemasSeleccionados, "", new { @class = "text-danger" })
                        </div>

                        <div class="create-group-field-grid">
                            <div class="form-group mt-1">
                                @Html.Label("idCategoria", "Nivel", new { @for = "idCategoria" }) <span class="create-group-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(grupoModel => grupoModel.idCategoria, ViewData["Categorias"] as List<SelectListItem>, "Seleccione un nivel...", new { @class = "form-select", @required = "required" })
                                @Html.ValidationMessageFor(grupoModel => grupoModel.idCategoria, "", new { @class = "text-danger" })
                            </div>

                            @if (ViewBag.Role == 2)
                            {
                                @Html.DropDownListFor(
                                    grupoModel => grupoModel.idAsesor,
                                    new SelectList(ViewData["Asesores"] as List<SelectListItem>, "Value", "Text", defaultAsesorId),
                                    "Seleccione un(a) facilitador(a)...",
                                    new { @class = "form-select", @hidden = true }
                                )
                            }
                            else
                            {
                                <div class="form-group mt-1">
                                    @Html.Label("asesorSelect", "Facilitador(a)")
                                    @Html.DropDownListFor(
                                             grupoModel => grupoModel.idAsesor,
                                             new SelectList(ViewData["Asesores"] as List<SelectListItem>, "Value", "Text"),
                                             "Seleccione un(a) facilitador(a)...",
                                             new { @class = "form-select", @id = "asesorSelect" }
                                             )
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.nombreAsesor, "", new { @class = "text-danger" })
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="createGroupDatesTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <div>
                            <h2 id="createGroupDatesTitle">Fechas del módulo</h2>
                            <p>Define los períodos de inscripción y ejecución</p>
                        </div>
                    </header>
                    <div class="create-group-card-body create-group-date-groups">
                        <section class="create-group-date-block" aria-labelledby="createGroupEnrollmentDatesTitle">
                            <h3 id="createGroupEnrollmentDatesTitle">Período de inscripción</h3>
                            <div class="create-group-field-grid">
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaInicioInscripcion) <span class="create-group-required" aria-hidden="true">*</span>
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaInicioInscripcion, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaInicioInscripcion, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaFinalizacionInscripcion) <span class="create-group-required" aria-hidden="true">*</span>
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaFinalizacionInscripcion, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaFinalizacionInscripcion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </section>

                        <section class="create-group-date-block" aria-labelledby="createGroupExecutionDatesTitle">
                            <h3 id="createGroupExecutionDatesTitle">Inicio y finalización del módulo</h3>
                            <div class="create-group-field-grid">
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaInicioGrupo) <span class="create-group-required" aria-hidden="true">*</span>
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaInicioGrupo, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaInicioGrupo, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(grupoModel => grupoModel.fechaFinalizacionGrupo) <span class="create-group-required" aria-hidden="true">*</span>
                                    <br />
                                    @Html.EditorFor(grupoModel => grupoModel.fechaFinalizacionGrupo, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                                    @Html.ValidationMessageFor(grupoModel => grupoModel.fechaFinalizacionGrupo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </section>
                    </div>
                </section>

                <section class="create-group-card" aria-labelledby="createGroupAttachmentTitle">
                    <header class="create-group-card-header">
                        <i class="bi bi-paperclip" aria-hidden="true"></i>
                        <div>
                            <h2 id="createGroupAttachmentTitle">Archivo adjunto</h2>
                            <p>Adjunta un archivo al módulo</p>
                        </div>
                    </header>
                    <div class="create-group-card-body">
                        <div class="form-group">
                            @Html.TextBoxFor(grupoModel => grupoModel.archivoAdjunto, null, new { type = "file", @class = "form-control" })
                        </div>
                    </div>
                </section>
            </div>

            <div class="create-group-actions">
                <a href="@Url.Action("ListaGruposDisponibles", "Grupo")" class="btn create-group-action-button create-group-action-cancel">
                    Cancelar
                </a>
                <input type="submit" class="btn btn-primary create-group-action-button create-group-action-save" value="Guardar" />
            </div>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script>
    $(document).ready(function () {
        function verificarModalidad() {
            var modalidadSeleccionada = $('#modalidadSelect').val();
            if (modalidadSeleccionada === '@webMetics.Models.TipoModalidad.Autogestionado') {
                $('#asesorSelect').prop('disabled', true);
                $('#asesorSelect').val('');
                $('#horario').prop('disabled', true);
                $('#horario').val('');
                $('#lugar, #enlace, #claveInscripcion').prop('disabled', true);
                $('#lugar, #enlace, #claveInscripcion').val('');
            } else {
                if ('@ViewBag.Role' && '@ViewBag.Role' != 2) {
                    $('#asesorSelect').prop('disabled', false);
                }
                $('#horario').prop('disabled', false);
                $('#lugar, #enlace, #claveInscripcion').prop('disabled', false);
            }
        }
        
        verificarModalidad();

        $('#modalidadSelect').change(function () {
            verificarModalidad();
        });
    });
</script>
<script>
    (function () {
        function initializeCreateGroupDatePickers() {
            var inputs = Array.prototype.slice.call(
                document.querySelectorAll('.create-group-page input[type="date"]')
            );
            var instances = [];
            var manualErrors = {};

            function pad(number) { return String(number).padStart(2, '0'); }
            function dateKey(date) {
                return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
            }
            function parseDate(value) {
                if (!value) return null;
                var parts = value.split('-').map(Number);
                if (parts.length !== 3) return null;
                var date = new Date(parts[0], parts[1] - 1, parts[2]);
                return date.getFullYear() === parts[0] && date.getMonth() === parts[1] - 1 && date.getDate() === parts[2] ? date : null;
            }
            function sameDay(left, right) {
                return !!left && !!right && dateKey(left) === dateKey(right);
            }

            inputs.forEach(function (input, inputIndex) {
                if (input.dataset.customDateReady === 'true') return;

                var baseId = input.id || input.name || ('createGroupDate' + inputIndex);
                var wrapper = document.createElement('div');
                wrapper.className = 'create-group-custom-date';
                input.parentNode.insertBefore(wrapper, input);
                wrapper.appendChild(input);
                input.classList.add('create-group-native-date');
                input.setAttribute('aria-hidden', 'true');
                input.setAttribute('tabindex', '-1');
                input.dataset.customDateReady = 'true';

                var manualInput = document.createElement('input');
                manualInput.type = 'text';
                manualInput.id = baseId + 'DateText';
                manualInput.className = 'create-group-date-text';
                manualInput.placeholder = 'dd/mm/aaaa';
                manualInput.autocomplete = 'off';
                manualInput.inputMode = 'numeric';
                manualInput.setAttribute('aria-haspopup', 'dialog');
                manualInput.setAttribute('aria-expanded', 'false');
                manualInput.setAttribute('aria-controls', baseId + 'Calendar');
                if (input.required) manualInput.setAttribute('aria-required', 'true');

                var trigger = document.createElement('button');
                trigger.type = 'button';
                trigger.id = baseId + 'CalendarTrigger';
                trigger.className = 'create-group-date-trigger';
                trigger.setAttribute('aria-label', 'Abrir calendario de fecha');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.setAttribute('aria-controls', baseId + 'Calendar');

                var icon = document.createElement('i');
                icon.className = 'bi bi-calendar3';
                icon.setAttribute('aria-hidden', 'true');
                trigger.appendChild(icon);

                var panel = document.createElement('div');
                panel.id = baseId + 'Calendar';
                panel.className = 'create-group-date-panel';
                panel.setAttribute('role', 'dialog');
                panel.setAttribute('aria-label', 'Seleccionar fecha');
                panel.hidden = true;

                var header = document.createElement('div');
                header.className = 'create-group-date-header';
                var previous = document.createElement('button');
                previous.type = 'button';
                previous.className = 'create-group-date-nav';
                previous.setAttribute('aria-label', 'Mes anterior');
                previous.innerHTML = '<i class="bi bi-chevron-left" aria-hidden="true"></i>';
                var monthTitle = document.createElement('div');
                monthTitle.className = 'create-group-date-month';
                monthTitle.setAttribute('aria-live', 'polite');
                var next = document.createElement('button');
                next.type = 'button';
                next.className = 'create-group-date-nav';
                next.setAttribute('aria-label', 'Mes siguiente');
                next.innerHTML = '<i class="bi bi-chevron-right" aria-hidden="true"></i>';
                header.append(previous, monthTitle, next);

                var calendar = document.createElement('div');
                calendar.className = 'create-group-date-calendar';
                calendar.setAttribute('role', 'group');
                var footer = document.createElement('div');
                footer.className = 'create-group-date-footer';
                var todayButton = document.createElement('button');
                todayButton.type = 'button';
                todayButton.className = 'create-group-date-today';
                todayButton.textContent = 'Hoy';
                footer.appendChild(todayButton);
                panel.append(header, calendar, footer);
                wrapper.append(manualInput, trigger, panel);

                var fieldContainer = input.closest('.form-group');
                var validationMessage = fieldContainer
                    ? fieldContainer.querySelector('[data-valmsg-for="' + input.name + '"]')
                    : null;
                if (validationMessage) {
                    if (!validationMessage.id) validationMessage.id = baseId + 'CalendarValidation';
                    manualInput.setAttribute('aria-describedby', validationMessage.id);
                    trigger.setAttribute('aria-describedby', validationMessage.id);
                }
                var labels = Array.prototype.filter.call(document.querySelectorAll('label'), function (label) {
                    return label.htmlFor === input.id || label.htmlFor === input.name;
                });
                if (labels.length) {
                    var labelIds = labels.map(function (label, labelIndex) {
                        if (!label.id) label.id = baseId + 'CalendarLabel' + labelIndex;
                        return label.id;
                    }).join(' ');
                    manualInput.setAttribute('aria-labelledby', labelIds);
                    trigger.setAttribute('aria-label', 'Abrir calendario para ' + labels.map(function (label) {
                        return label.textContent.trim();
                    }).join(' '));
                    labels.forEach(function (label) {
                        label.addEventListener('click', function (event) {
                            event.preventDefault();
                            manualInput.focus();
                        });
                    });
                }

                var isOpen = false;
                var viewMonth = new Date();
                viewMonth.setDate(1);
                var focusedDate = null;
                var dayButtons = [];

                function formatDisplay(date) {
                    return new Intl.DateTimeFormat('es-CR', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
                }
                function parseTypedDate(value) {
                    var text = value.trim();
                    var isoParts = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
                    var localParts = text.match(/^(\d{1,2})[/.\-](\d{1,2})[/.\-](\d{4})$/);
                    var year;
                    var month;
                    var day;
                    if (isoParts) {
                        year = Number(isoParts[1]);
                        month = Number(isoParts[2]);
                        day = Number(isoParts[3]);
                    } else if (localParts) {
                        day = Number(localParts[1]);
                        month = Number(localParts[2]);
                        year = Number(localParts[3]);
                    } else {
                        return null;
                    }
                    var date = new Date(year, month - 1, day);
                    return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day ? date : null;
                }
                function isAllowed(date) {
                    var key = dateKey(date);
                    return (!input.min || key >= input.min) && (!input.max || key <= input.max);
                }
                function renderValue() {
                    var selected = parseDate(input.value);
                    if (!manualErrors[input.name]) manualInput.value = selected ? formatDisplay(selected) : '';
                    if (selected) {
                        viewMonth = new Date(selected.getFullYear(), selected.getMonth(), 1);
                    }
                    renderCalendar();
                    var hasError = validationMessage && validationMessage.textContent.trim().length > 0;
                    if (hasError) {
                        trigger.setAttribute('aria-invalid', 'true');
                        manualInput.setAttribute('aria-invalid', 'true');
                        wrapper.classList.add('has-validation-error');
                    } else {
                        trigger.removeAttribute('aria-invalid');
                        manualInput.removeAttribute('aria-invalid');
                        wrapper.classList.remove('has-validation-error');
                    }
                }
                function renderCalendar() {
                    monthTitle.textContent = new Intl.DateTimeFormat('es-CR', { month: 'long', year: 'numeric' }).format(viewMonth);
                    calendar.replaceChildren();
                    dayButtons = [];
                    ['L', 'M', 'X', 'J', 'V', 'S', 'D'].forEach(function (dayName) {
                        var weekday = document.createElement('span');
                        weekday.className = 'create-group-date-weekday';
                        weekday.setAttribute('role', 'columnheader');
                        weekday.textContent = dayName;
                        calendar.appendChild(weekday);
                    });

                    var firstDay = new Date(viewMonth.getFullYear(), viewMonth.getMonth(), 1);
                    var offset = (firstDay.getDay() + 6) % 7;
                    var daysInMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 0).getDate();
                    var weeks = Math.ceil((offset + daysInMonth) / 7);
                    var selectedDate = parseDate(input.value);
                    var today = new Date();
                    today.setHours(0, 0, 0, 0);
                    todayButton.disabled = !isAllowed(today);

                    for (var cell = 0; cell < weeks * 7; cell++) {
                        var date = new Date(viewMonth.getFullYear(), viewMonth.getMonth(), cell - offset + 1);
                        var dayButton = document.createElement('button');
                        dayButton.type = 'button';
                        dayButton.className = 'create-group-date-day';
                        dayButton.textContent = String(date.getDate());
                        dayButton.setAttribute('aria-label', new Intl.DateTimeFormat('es-CR', { dateStyle: 'full' }).format(date));
                        dayButton.dataset.date = dateKey(date);
                        dayButton.disabled = !isAllowed(date);
                        dayButton.tabIndex = -1;
                        if (date.getMonth() !== viewMonth.getMonth()) dayButton.classList.add('is-outside-month');
                        if (sameDay(date, selectedDate)) {
                            dayButton.classList.add('is-selected');
                            dayButton.setAttribute('aria-selected', 'true');
                        } else {
                            dayButton.setAttribute('aria-selected', 'false');
                        }
                        if (sameDay(date, today)) dayButton.classList.add('is-today');
                        dayButton.addEventListener('click', function (event) {
                            chooseDate(parseDate(event.currentTarget.dataset.date));
                        });
                        calendar.appendChild(dayButton);
                        dayButtons.push(dayButton);
                    }
                }
                function setFocusedDate(date, focusButton) {
                    focusedDate = date;
                    if (date.getMonth() !== viewMonth.getMonth() || date.getFullYear() !== viewMonth.getFullYear()) {
                        viewMonth = new Date(date.getFullYear(), date.getMonth(), 1);
                        renderCalendar();
                    }
                    dayButtons.forEach(function (button) {
                        var isFocused = button.dataset.date === dateKey(date);
                        button.tabIndex = isFocused && !button.disabled ? 0 : -1;
                    });
                    var target = dayButtons.find(function (button) { return button.dataset.date === dateKey(date); });
                    if (focusButton && target && !target.disabled) target.focus();
                }
                function open() {
                    if (trigger.disabled || isOpen) return;
                    instances.forEach(function (instance) { if (instance.wrapper !== wrapper) instance.close(false); });
                    var now = new Date();
                    focusedDate = parseDate(input.value) || new Date(now.getFullYear(), now.getMonth(), now.getDate());
                    var minimumDate = parseDate(input.min);
                    var maximumDate = parseDate(input.max);
                    if (minimumDate && focusedDate < minimumDate) focusedDate = minimumDate;
                    if (maximumDate && focusedDate > maximumDate) focusedDate = maximumDate;
                    viewMonth = new Date(focusedDate.getFullYear(), focusedDate.getMonth(), 1);
                    renderCalendar();
                    panel.hidden = false;
                    wrapper.classList.add('is-open');
                    var card = wrapper.closest('.create-group-card');
                    if (card) card.classList.add('create-group-card--select-open');
                    trigger.setAttribute('aria-expanded', 'true');
                    manualInput.setAttribute('aria-expanded', 'true');
                    isOpen = true;
                    var rect = trigger.getBoundingClientRect();
                    var roomBelow = window.innerHeight - rect.bottom;
                    wrapper.classList.toggle('is-open-above', roomBelow < panel.offsetHeight + 12 && rect.top > panel.offsetHeight + 12);
                    setFocusedDate(focusedDate, true);
                }
                function close(returnFocus) {
                    if (!isOpen) return;
                    panel.hidden = true;
                    wrapper.classList.remove('is-open', 'is-open-above');
                    var card = wrapper.closest('.create-group-card');
                    if (card) card.classList.remove('create-group-card--select-open');
                    trigger.setAttribute('aria-expanded', 'false');
                    manualInput.setAttribute('aria-expanded', 'false');
                    isOpen = false;
                    if (returnFocus) manualInput.focus();
                }
                function chooseDate(date) {
                    if (!date || !isAllowed(date)) return;
                    manualErrors[input.name] = '';
                    input.value = dateKey(date);
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                    if (validationMessage && input.validity.valid) validationMessage.textContent = '';
                    renderValue();
                    close(true);
                }
                function changeMonth(amount) {
                    viewMonth = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + amount, 1);
                    renderCalendar();
                    var preferred = focusedDate && focusedDate.getDate() || 1;
                    var last = new Date(viewMonth.getFullYear(), viewMonth.getMonth() + 1, 0).getDate();
                    setFocusedDate(new Date(viewMonth.getFullYear(), viewMonth.getMonth(), Math.min(preferred, last)), false);
                }
                function toggle() { if (isOpen) close(false); else open(); }

                trigger.addEventListener('click', toggle);
                manualInput.addEventListener('input', function () {
                    var typedValue = manualInput.value.trim();
                    if (!typedValue) {
                        manualErrors[input.name] = '';
                        input.value = '';
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                        return;
                    }

                    var typedDate = parseTypedDate(typedValue);
                    if (!typedDate) {
                        manualErrors[input.name] = 'Ingrese una fecha válida con formato dd/mm/aaaa.';
                        input.value = '';
                        updateDateConstraints();
                        return;
                    }

                    var typedKey = dateKey(typedDate);
                    manualErrors[input.name] = '';
                    input.value = typedKey;
                    input.dispatchEvent(new Event('input', { bubbles: true }));
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                    if (validationMessage && input.validity.valid) validationMessage.textContent = '';
                    renderValue();
                });
                manualInput.addEventListener('keydown', function (event) {
                    if (event.key === 'ArrowDown' && !isOpen) {
                        event.preventDefault();
                        open();
                    } else if (event.key === 'Escape' && isOpen) {
                        event.preventDefault();
                        close(true);
                    }
                });
                previous.addEventListener('click', function () { changeMonth(-1); });
                next.addEventListener('click', function () { changeMonth(1); });
                todayButton.addEventListener('click', function () {
                    var now = new Date();
                    chooseDate(new Date(now.getFullYear(), now.getMonth(), now.getDate()));
                });
                trigger.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && isOpen) { event.preventDefault(); close(true); }
                    else if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        if (!isOpen) open();
                    }
                });
                panel.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') { event.preventDefault(); close(true); return; }
                    var delta = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : event.key === 'ArrowUp' ? -7 : event.key === 'ArrowDown' ? 7 : 0;
                    if (delta) {
                        event.preventDefault();
                        if (input.min && input.max && input.min > input.max) return;
                        var nextDate = new Date(focusedDate.getFullYear(), focusedDate.getMonth(), focusedDate.getDate() + delta);
                        var attempts = 0;
                        while (!isAllowed(nextDate) && attempts < 3700) {
                            var nextKey = dateKey(nextDate);
                            if (input.min && nextKey < input.min) nextDate = parseDate(input.min);
                            else if (input.max && nextKey > input.max) nextDate = parseDate(input.max);
                            else nextDate.setDate(nextDate.getDate() + Math.sign(delta));
                            if (!nextDate) break;
                            attempts++;
                        }
                        if (attempts < 3700 && isAllowed(nextDate)) setFocusedDate(nextDate, true);
                    } else if (event.key === 'Enter' && event.target.classList.contains('create-group-date-day')) {
                        event.preventDefault();
                        chooseDate(parseDate(event.target.dataset.date));
                    }
                });
                input.addEventListener('change', renderValue);
                input.addEventListener('invalid', function (event) {
                    event.preventDefault();
                    if (validationMessage) {
                        validationMessage.textContent = input.validity.valueMissing
                            ? 'Selecciona la fecha indicada.'
                            : input.validationMessage || 'Selecciona una fecha válida.';
                    }
                    trigger.setAttribute('aria-invalid', 'true');
                    manualInput.setAttribute('aria-invalid', 'true');
                    wrapper.classList.add('has-validation-error');
                    window.setTimeout(function () { manualInput.focus(); }, 0);
                });
                var instance = { close: close, wrapper: wrapper, sync: renderValue };
                instances.push(instance);
                renderValue();
            });

            var dateInputs = {};
            inputs.forEach(function (input) { dateInputs[input.name] = input; });

            function earliestDate(left, right) {
                if (!left) return right;
                if (!right) return left;
                return dateKey(left) <= dateKey(right) ? left : right;
            }
            function latestDate(left, right) {
                if (!left) return right;
                if (!right) return left;
                return dateKey(left) >= dateKey(right) ? left : right;
            }
            function setDateRange(input, minimum, maximum) {
                if (!input) return;
                if (minimum) input.min = dateKey(minimum);
                else input.removeAttribute('min');
                if (maximum) input.max = dateKey(maximum);
                else input.removeAttribute('max');
            }
            function updateDateConstraints() {
                var enrollmentStartInput = dateInputs.fechaInicioInscripcion;
                var enrollmentEndInput = dateInputs.fechaFinalizacionInscripcion;
                var moduleStartInput = dateInputs.fechaInicioGrupo;
                var moduleEndInput = dateInputs.fechaFinalizacionGrupo;
                if (!enrollmentStartInput || !enrollmentEndInput || !moduleStartInput || !moduleEndInput) return;

                var enrollmentStart = parseDate(enrollmentStartInput.value);
                var enrollmentEnd = parseDate(enrollmentEndInput.value);
                var moduleStart = parseDate(moduleStartInput.value);
                var moduleEnd = parseDate(moduleEndInput.value);

                setDateRange(enrollmentStartInput, null, earliestDate(enrollmentEnd, moduleStart));
                setDateRange(enrollmentEndInput, enrollmentStart, moduleEnd);
                setDateRange(moduleStartInput, enrollmentStart, moduleEnd);
                setDateRange(moduleEndInput, latestDate(moduleStart, enrollmentEnd), null);

                var errors = {};
                function addError(input, message) {
                    if (!input) return;
                    errors[input.name] = errors[input.name] ? errors[input.name] + ' ' + message : message;
                }
                inputs.forEach(function (input) {
                    if (input.value && input.min && input.value < input.min) {
                        addError(input, 'La fecha no puede ser anterior al ' + formatDisplay(parseDate(input.min)) + '.');
                    }
                    if (input.value && input.max && input.value > input.max) {
                        addError(input, 'La fecha no puede ser posterior al ' + formatDisplay(parseDate(input.max)) + '.');
                    }
                });
                if (enrollmentStart && enrollmentEnd && enrollmentStart > enrollmentEnd) {
                    addError(enrollmentEndInput, 'La fecha de finalización de inscripción no puede ser anterior al inicio de inscripción.');
                }
                if (moduleStart && moduleEnd && moduleStart > moduleEnd) {
                    addError(moduleEndInput, 'La fecha de finalización del módulo no puede ser anterior a su inicio.');
                }
                if (enrollmentEnd && moduleEnd && enrollmentEnd > moduleEnd) {
                    addError(enrollmentEndInput, 'La fecha de finalización de inscripción no puede ser posterior al fin del módulo.');
                }
                if (enrollmentStart && moduleStart && enrollmentStart > moduleStart) {
                    addError(enrollmentStartInput, 'La inscripción no puede iniciar después del inicio del módulo.');
                }

                inputs.forEach(function (input) {
                    var message = errors[input.name] || '';
                    if (manualErrors[input.name]) {
                        message = message ? message + ' ' + manualErrors[input.name] : manualErrors[input.name];
                    }
                    input.setCustomValidity(message);
                    var fieldContainer = input.closest('.form-group');
                    var validationMessage = fieldContainer
                        ? fieldContainer.querySelector('[data-valmsg-for="' + input.name + '"]')
                        : null;
                    if (!validationMessage) return;

                    var previousClientMessage = input.dataset.dateConstraintMessage || '';
                    if (message) validationMessage.textContent = message;
                    else if (previousClientMessage && validationMessage.textContent === previousClientMessage) validationMessage.textContent = '';
                    input.dataset.dateConstraintMessage = message;
                });
                instances.forEach(function (instance) { instance.sync(); });
            }

            inputs.forEach(function (input) {
                input.addEventListener('change', updateDateConstraints);
            });
            updateDateConstraints();

            document.addEventListener('pointerdown', function (event) {
                instances.forEach(function (instance) {
                    if (!instance.wrapper.contains(event.target)) instance.close(false);
                });
            });
            document.addEventListener('focusin', function (event) {
                instances.forEach(function (instance) {
                    if (!instance.wrapper.contains(event.target)) instance.close(false);
                });
            });
            var form = document.querySelector('.create-group-page form');
            if (form) {
                form.addEventListener('reset', function () {
                    window.setTimeout(function () {
                        inputs.forEach(function (input) {
                            manualErrors[input.name] = '';
                            input.setCustomValidity('');
                            input.dispatchEvent(new Event('change', { bubbles: true }));
                        });
                    }, 0);
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCreateGroupDatePickers, { once: true });
        } else {
            initializeCreateGroupDatePickers();
        }
    })();
</script>

<script>
    (function () {
        function initializeCreateGroupSelects() {
            var selects = Array.prototype.slice.call(
                document.querySelectorAll('.create-group-page select:not([hidden])')
            );
            var instances = [];

            function closeAll(except) {
                instances.forEach(function (instance) {
                    if (instance !== except) instance.close(false);
                });
            }

            selects.forEach(function (select, selectIndex) {
                if (select.dataset.customSelectReady === 'true') return;

                var baseId = select.id || select.name || ('createGroupSelect' + selectIndex);
                var wrapper = document.createElement('div');
                wrapper.className = 'create-group-custom-select';

                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);
                select.classList.add('create-group-native-select');
                select.setAttribute('aria-hidden', 'true');
                select.setAttribute('tabindex', '-1');
                select.dataset.customSelectReady = 'true';

                var trigger = document.createElement('button');
                trigger.type = 'button';
                trigger.id = baseId + 'CustomTrigger';
                trigger.className = 'create-group-select-trigger';
                trigger.setAttribute('role', 'combobox');
                trigger.setAttribute('aria-haspopup', 'listbox');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.setAttribute('aria-controls', baseId + 'CustomListbox');

                var selectedText = document.createElement('span');
                selectedText.className = 'create-group-select-value';
                var arrow = document.createElement('span');
                arrow.className = 'create-group-select-arrow';
                arrow.setAttribute('aria-hidden', 'true');
                trigger.appendChild(selectedText);
                trigger.appendChild(arrow);

                var panel = document.createElement('div');
                panel.id = baseId + 'CustomListbox';
                panel.className = 'create-group-select-panel';
                panel.setAttribute('role', 'listbox');
                panel.hidden = true;

                var fieldContainer = select.closest('.form-group');
                var validationMessage = fieldContainer
                    ? fieldContainer.querySelector('[data-valmsg-for="' + select.name + '"]')
                    : null;
                if (validationMessage) {
                    if (!validationMessage.id) validationMessage.id = baseId + 'CustomValidation';
                    trigger.setAttribute('aria-describedby', validationMessage.id);
                }

                wrapper.appendChild(trigger);
                wrapper.appendChild(panel);

                var labels = Array.prototype.filter.call(document.querySelectorAll('label'), function (label) {
                    return label.htmlFor === select.id || label.htmlFor === select.name;
                });
                if (labels.length) {
                    trigger.setAttribute('aria-labelledby', labels.map(function (label, labelIndex) {
                        if (!label.id) label.id = baseId + 'CustomLabel' + labelIndex;
                        return label.id;
                    }).join(' '));
                    labels.forEach(function (label) {
                        label.addEventListener('click', function (event) {
                            event.preventDefault();
                            if (!trigger.disabled) {
                                trigger.focus();
                                toggle();
                            }
                        });
                    });
                } else {
                    trigger.setAttribute('aria-label', select.name || 'Seleccionar una opción');
                }

                var activeIndex = -1;
                var optionRows = [];
                var isOpen = false;
                var typeAheadBuffer = '';
                var typeAheadTimer = null;

                function enabledIndexFrom(startIndex, step) {
                    var index = startIndex;
                    while (index >= 0 && index < select.options.length) {
                        if (!select.options[index].disabled) return index;
                        index += step;
                    }
                    return -1;
                }

                function renderOptions() {
                    panel.replaceChildren();
                    optionRows = [];

                    Array.prototype.forEach.call(select.options, function (nativeOption, optionIndex) {
                        var row = document.createElement('div');
                        row.id = panel.id + 'Option' + optionIndex;
                        row.className = 'create-group-select-option';
                        row.setAttribute('role', 'option');
                        row.setAttribute('aria-selected', nativeOption.selected ? 'true' : 'false');
                        row.setAttribute('aria-disabled', nativeOption.disabled ? 'true' : 'false');
                        row.dataset.optionIndex = String(optionIndex);
                        row.textContent = nativeOption.text;

                        if (nativeOption.selected) row.classList.add('is-selected');
                        if (nativeOption.disabled) row.tabIndex = -1;

                        row.addEventListener('mouseenter', function () {
                            if (!nativeOption.disabled) setActive(optionIndex, false);
                        });
                        row.addEventListener('mousedown', function (event) {
                            event.preventDefault();
                        });
                        row.addEventListener('click', function () {
                            if (!nativeOption.disabled) choose(optionIndex);
                        });

                        panel.appendChild(row);
                        optionRows.push(row);
                    });
                }

                function updateSelection(clearValidation) {
                    var selectedOption = select.options[select.selectedIndex];
                    selectedText.textContent = selectedOption ? selectedOption.text : '';
                    optionRows.forEach(function (row, index) {
                        var selected = index === select.selectedIndex;
                        row.classList.toggle('is-selected', selected);
                        row.setAttribute('aria-selected', selected ? 'true' : 'false');
                    });

                    if (clearValidation && select.value !== '' && validationMessage) {
                        validationMessage.textContent = '';
                    }
                    var hasValidationMessage = validationMessage && validationMessage.textContent.trim().length > 0;
                    if (hasValidationMessage) {
                        trigger.setAttribute('aria-invalid', 'true');
                        wrapper.classList.add('has-validation-error');
                    } else {
                        trigger.removeAttribute('aria-invalid');
                        wrapper.classList.remove('has-validation-error');
                    }
                }

                function syncDisabled() {
                    trigger.disabled = select.disabled;
                    trigger.setAttribute('aria-disabled', select.disabled ? 'true' : 'false');
                    if (select.disabled) close(false);
                }

                function syncFromNative() {
                    renderOptions();
                    updateSelection(true);
                    syncDisabled();
                }

                function setActive(index, scrollIntoView) {
                    if (index < 0 || index >= optionRows.length || select.options[index].disabled) return;
                    activeIndex = index;
                    optionRows.forEach(function (row, rowIndex) {
                        row.classList.toggle('is-active', rowIndex === activeIndex);
                    });
                    trigger.setAttribute('aria-activedescendant', optionRows[activeIndex].id);
                    if (scrollIntoView) optionRows[activeIndex].scrollIntoView({ block: 'nearest' });
                }

                function open() {
                    if (trigger.disabled || isOpen) return;
                    closeAll(instance);
                    renderOptions();
                    panel.hidden = false;
                    wrapper.classList.add('is-open');
                    var card = wrapper.closest('.create-group-card');
                    if (card) card.classList.add('create-group-card--select-open');
                    trigger.setAttribute('aria-expanded', 'true');
                    isOpen = true;

                    var triggerRect = trigger.getBoundingClientRect();
                    var panelHeight = Math.min(panel.scrollHeight, window.innerHeight - 24);
                    var roomBelow = window.innerHeight - triggerRect.bottom;
                    wrapper.classList.toggle('is-open-above', roomBelow < panelHeight + 14 && triggerRect.top > panelHeight + 14);

                    var selectedIndex = select.selectedIndex;
                    if (selectedIndex < 0 || select.options[selectedIndex].disabled) {
                        selectedIndex = enabledIndexFrom(0, 1);
                    }
                    if (selectedIndex >= 0) setActive(selectedIndex, true);
                }

                function close(returnFocus) {
                    if (!isOpen) return;
                    panel.hidden = true;
                    wrapper.classList.remove('is-open', 'is-open-above');
                    var card = wrapper.closest('.create-group-card');
                    if (card) card.classList.remove('create-group-card--select-open');
                    trigger.setAttribute('aria-expanded', 'false');
                    trigger.removeAttribute('aria-activedescendant');
                    isOpen = false;
                    activeIndex = -1;
                    if (returnFocus) trigger.focus();
                }

                function choose(index) {
                    if (index < 0 || index >= select.options.length || select.options[index].disabled) return;
                    if (select.selectedIndex !== index) {
                        select.selectedIndex = index;
                        select.dispatchEvent(new Event('input', { bubbles: true }));
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    updateSelection();
                    syncDisabled();
                    close(true);
                }

                function toggle() {
                    if (isOpen) close(false);
                    else open();
                }

                function moveActive(step) {
                    var start = activeIndex;
                    if (start < 0) start = step > 0 ? -1 : select.options.length;
                    var next = start + step;
                    while (next >= 0 && next < select.options.length && select.options[next].disabled) next += step;
                    if (next >= 0 && next < select.options.length) setActive(next, true);
                }

                function findTypeAheadMatch(query) {
                    var startIndex = select.selectedIndex;
                    for (var offset = 1; offset <= select.options.length; offset++) {
                        var optionIndex = (startIndex + offset + select.options.length) % select.options.length;
                        var option = select.options[optionIndex];
                        var optionText = option.text.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                        if (!option.disabled && option.value !== '' && optionText.startsWith(query)) {
                            return optionIndex;
                        }
                    }
                    return -1;
                }

                function searchByTyping(character) {
                    var normalizedCharacter = character.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                    var repeatedCharacter = typeAheadBuffer && Array.from(typeAheadBuffer).every(function (letter) {
                        return letter === normalizedCharacter;
                    });
                    typeAheadBuffer = repeatedCharacter ? normalizedCharacter : typeAheadBuffer + normalizedCharacter;
                    window.clearTimeout(typeAheadTimer);
                    typeAheadTimer = window.setTimeout(function () { typeAheadBuffer = ''; }, 800);

                    var match = findTypeAheadMatch(typeAheadBuffer);
                    if (match < 0 && typeAheadBuffer !== normalizedCharacter) {
                        typeAheadBuffer = normalizedCharacter;
                        match = findTypeAheadMatch(typeAheadBuffer);
                    }
                    if (match >= 0) choose(match);
                }

                var instance = { close: close, select: select, syncDisabled: syncDisabled, syncFromNative: syncFromNative };
                instances.push(instance);

                trigger.addEventListener('click', toggle);
                trigger.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        if (isOpen) {
                            event.preventDefault();
                            close(true);
                        }
                        return;
                    }

                    if (event.key === 'Tab') {
                        close(false);
                        return;
                    }

                    if (event.key.length === 1 && event.key.trim() && !event.ctrlKey && !event.altKey && !event.metaKey) {
                        event.preventDefault();
                        searchByTyping(event.key);
                        return;
                    }

                    if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' '].indexOf(event.key) === -1) return;
                    event.preventDefault();

                    if (!isOpen) {
                        open();
                        if (event.key === 'ArrowDown') setActive(enabledIndexFrom(select.selectedIndex + 1, 1), true);
                        if (event.key === 'ArrowUp') setActive(enabledIndexFrom(select.selectedIndex - 1, -1), true);
                        return;
                    }

                    if (event.key === 'ArrowDown') moveActive(1);
                    else if (event.key === 'ArrowUp') moveActive(-1);
                    else if (event.key === 'Home') setActive(enabledIndexFrom(0, 1), true);
                    else if (event.key === 'End') setActive(enabledIndexFrom(select.options.length - 1, -1), true);
                    else if (activeIndex >= 0) choose(activeIndex);
                });

                select.addEventListener('change', function () {
                    syncFromNative();
                });
                select.addEventListener('invalid', function (event) {
                    event.preventDefault();
                    if (validationMessage) validationMessage.textContent = select.value === ''
                        ? 'Selecciona una opción.'
                        : select.validationMessage || 'Selecciona una opción válida.';
                    trigger.setAttribute('aria-invalid', 'true');
                    wrapper.classList.add('has-validation-error');
                    window.setTimeout(function () { trigger.focus(); }, 0);
                });

                var disabledObserver = new MutationObserver(syncDisabled);
                disabledObserver.observe(select, { attributes: true, attributeFilter: ['disabled'] });
                renderOptions();
                updateSelection();
                syncDisabled();
            });

            document.addEventListener('pointerdown', function (event) {
                instances.forEach(function (instance) {
                    if (!instance.select.closest('.create-group-custom-select').contains(event.target)) {
                        instance.close(false);
                    }
                });
            });

            var modalitySelect = document.getElementById('modalidadSelect');
            if (modalitySelect) {
                modalitySelect.addEventListener('change', function () {
                    window.setTimeout(function () {
                        instances.forEach(function (instance) { instance.syncFromNative(); });
                    }, 0);
                });
            }

            document.addEventListener('focusin', function (event) {
                instances.forEach(function (instance) {
                    var wrapper = instance.select.closest('.create-group-custom-select');
                    if (!wrapper.contains(event.target)) instance.close(false);
                });
            });

            var form = document.querySelector('.create-group-page form');
            if (form) {
                form.addEventListener('reset', function () {
                    window.setTimeout(function () {
                        instances.forEach(function (instance) {
                            instance.select.dispatchEvent(new Event('change', { bubbles: true }));
                        });
                    }, 0);
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCreateGroupSelects, { once: true });
        } else {
            initializeCreateGroupSelects();
        }
    })();
</script>
