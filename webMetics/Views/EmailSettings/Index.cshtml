@model bool
@{
    ViewBag.Title = "Configuración del correo";
    PageHeadingBuilder.Configure(ViewContext, Url, subtitle: "Correo de aviso por límite de horas y envío de correos del sistema.");
    ViewData["AdminPanelLayout"] = true;
    ViewData["AdminPanelIcon"] = "bi-envelope";
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja admin-panel-page">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />

        @await Html.PartialAsync("_MeticsToast")

        @{
            string correoGuardado = ViewBag.CorreoNotificacion?.ToString();
            string correoActual = !string.IsNullOrEmpty(correoGuardado) ? correoGuardado : "ej., soporte.metics@ucr.ac.cr";
        }

        <section class="admin-panel-card" aria-labelledby="correoNotificacionTitulo">
            <div class="admin-panel-card-header">
                <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-envelope-at"></i></span>
                <div>
                    <h2 class="admin-panel-card-title" id="correoNotificacionTitulo">Correo de notificación</h2>
                    <p class="admin-panel-card-desc">Recibe un aviso cuando un participante supera el límite de horas aprobadas.</p>
                </div>
            </div>

            <p class="admin-panel-current-value">
                <span class="admin-panel-current-label">Correo actual:</span>
                @if (!string.IsNullOrEmpty(correoGuardado))
                {
                    <strong>@correoGuardado</strong>
                }
                else
                {
                    <span class="admin-panel-muted">Sin correo configurado</span>
                }
            </p>

            @using (Html.BeginForm("UpdateNotificationEmail", "EmailSettings", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="create-category-field mb-0">
                    <label for="correoLimiteHoras">Actualizar correo de notificación</label>
                    <div class="admin-panel-inline-form">
                        <input type="text" class="form-control" name="correoLimiteHoras" id="correoLimiteHoras" placeholder="@correoActual" oninput="toggleButton()">
                        <input class="btn admin-panel-btn-soft" type="submit" value="Actualizar" id="updateButton" disabled>
                    </div>
                </div>
            }
        </section>

        <form asp-action="ToggleEmailSending" method="post" class="admin-panel-card" aria-labelledby="envioCorreosTitulo">
            <div class="admin-panel-card-header">
                <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-send"></i></span>
                <div>
                    <h2 class="admin-panel-card-title" id="envioCorreosTitulo">Envío de correos</h2>
                    <p class="admin-panel-card-desc">Active o desactive el envío de correos del sistema y presione Guardar cambios para aplicar el cambio.</p>
                </div>
            </div>

            <div class="admin-email-switch">
                <div class="admin-email-switch-text">
                    <label class="form-check-label" for="emailToggle">
                        Habilitar envío de correos
                    </label>
                    <span class="admin-email-switch-help" id="emailToggleAyuda">Si está desactivado, el sistema no envía correos automáticos.</span>
                </div>
                <div class="admin-email-switch-control">
                    <span class="admin-email-switch-state" id="emailToggleEstado" aria-hidden="true">@(Model ? "Activado" : "Desactivado")</span>
                    <div class="form-check form-switch">
                        <input type="checkbox"
                               class="form-check-input"
                               id="emailToggle"
                               name="isEnabled"
                               value="true"
                               role="switch"
                        @(Model ? "checked" : "")
                               aria-describedby="emailToggleAyuda"
                               aria-label="Habilitar envío de correos" />
                    </div>
                </div>
            </div>

            <div class="admin-panel-card-footer admin-panel-card-footer--end">
                <div class="admin-panel-form-actions">
                    <a href="@Url.Action("ListaGruposDisponibles", "Grupo")" class="btn admin-panel-btn-secondary">
                        Cancelar
                    </a>
                    <input type="submit" class="btn admin-panel-btn-primary" value="Guardar cambios" />
                </div>
            </div>
        </form>
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script>
    function toggleButton() {
        const inputField = document.getElementById("correoLimiteHoras");
        const updateButton = document.getElementById("updateButton");

        // Disable the button if input is empty, enable it otherwise
        updateButton.disabled = inputField.value.trim() === "";
    }

    document.addEventListener("DOMContentLoaded", () => {
        toggleButton();

        // Solo presentación: muestra junto al switch si está activado o desactivado (se aplica al guardar).
        const emailToggle = document.getElementById("emailToggle");
        const emailToggleEstado = document.getElementById("emailToggleEstado");
        if (emailToggle && emailToggleEstado) {
            emailToggle.addEventListener("change", () => {
                emailToggleEstado.textContent = emailToggle.checked ? "Activado" : "Desactivado";
            });
        }
    });
</script>
