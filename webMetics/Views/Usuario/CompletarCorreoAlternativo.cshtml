@model webMetics.Models.UsuarioModel
@{
    ViewBag.Title = "Completar Información - Correo Alternativo";
}

<div class="contenedor-caja container-fluid required-update-page admin-panel-page">
    @await Html.PartialAsync("_MeticsToast")

    <section class="admin-panel-card required-update-card" aria-labelledby="actualizacionRequeridaTitulo">
        <div class="required-update-header">
            <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-envelope-at"></i></span>
            <div>
                <h1 class="required-update-title" id="actualizacionRequeridaTitulo">Actualización requerida</h1>
                <p class="admin-panel-card-desc">Para continuar, complete su correo alternativo.</p>
            </div>
        </div>

        @using (Html.BeginForm("CompletarCorreoAlternativo", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="required-update-account">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <div>
                    <span>Correo institucional</span>
                    <strong>@Model.correo</strong>
                </div>
            </div>

            <div class="required-update-field">
                @Html.LabelFor(m => m.correoAlternativo) <span class="required-update-required" aria-hidden="true">*</span>
                <small class="required-update-help">Este es un campo adicional para mejorar la comunicación.</small>
                @Html.TextBoxFor(m => m.correoAlternativo, new { @class = "form-control", @type = "email", @placeholder = "ejemplo@correo.com", @maxlength = "64", @autocomplete = "off", @required = "required" })
                @Html.ValidationMessageFor(m => m.correoAlternativo, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn admin-panel-btn-primary required-update-submit">
                <i class="bi bi-check-circle" aria-hidden="true"></i>Guardar y continuar
            </button>

            <p class="required-update-footnote">Puede usar cualquier dirección de correo válida.</p>
        }
    </section>
</div>
