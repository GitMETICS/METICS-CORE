@{
    string tituloRegistro = Convert.ToString(ViewBag.Titulo) ?? "";
    bool registroRealizado = tituloRegistro == "Registro realizado";
}

<div class="contenedor-caja container-fluid result-page">
    <section class="admin-panel-card result-card @(registroRealizado ? "is-success" : "is-error")" aria-labelledby="resultadoRegistroTitulo">
        <span class="result-card-icon" aria-hidden="true"><i class="bi @(registroRealizado ? "bi-check-lg" : "bi-x-lg")"></i></span>
        <h1 class="result-card-title" id="resultadoRegistroTitulo">@ViewBag.Titulo</h1>
        <p class="result-card-message" role="status">@ViewBag.Message</p>
        @if (ViewBag.Correo != null)
        {
            <p class="result-card-email"><i class="bi bi-envelope" aria-hidden="true"></i>@ViewBag.Correo</p>
        }
        <div class="result-card-actions">
            <a asp-action="ListaGruposDisponibles" asp-controller="Grupo" class="btn admin-panel-btn-primary">Regresar</a>
        </div>
    </section>
</div>
