@model webMetics.Models.NewLoginModel
@{
    ViewBag.Title = "Cambiar contraseña";
    PageHeadingBuilder.Configure(ViewContext, Url, subtitle: Convert.ToString(ViewBag.NombreCompleto));
    ViewData["SuccessMessage"] = ViewBag.SuccessMessage?.ToString();
    ViewData["ErrorMessage"] = ViewBag.ErrorMessage?.ToString();
}

@if (string.IsNullOrWhiteSpace(Model.id))
{
    <script>window.location.href = '@Url.Action("CerrarSesion", "Admin")';</script>
}
else
{
    <div class="contenedor-caja container-fluid password-reset-page">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />
        <p class="password-reset-page-description">Restablecimiento administrativo de contraseña.</p>
        <a class="btn btn-outline-secondary" href="@Url.Action("VerParticipantes", "Participante")">Volver a participantes</a>
        @await Html.PartialAsync("_CambiarContrasenaAdminModal", Model)
        @await Html.PartialAsync("_MeticsToast")
    </div>
}

@section Scripts {
    <script src="~/js/password-reset-modal.js" asp-append-version="true"></script>
}
