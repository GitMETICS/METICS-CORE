@model webMetics.Models.UsuarioModel
@using webMetics.Controllers
@using webMetics.Helpers
@{
    ViewBag.Title = "Formulario de Registro";

    var urlReferrer = Context.Request.Headers["Referer"].FirstOrDefault();
}

@if (ViewBag.Title == "Formulario de Registro")
{
    <div class="contenedor-caja container-fluid">
        @if (urlReferrer != null)
        {
            <div class="d-flex justify-content-start mb-3">
                <a class="text-dark fs-4" onclick="history.go(-1); return false;" href="#">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        }

        @using (Html.BeginForm("FormularioRegistro", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", id = "registroForm" }))
        {
            @Html.AntiForgeryToken()
            <h1>@ViewBag.Title</h1>
            <hr />

            if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-dark alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.ErrorMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.SuccessMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row mb-1">
                <div class="col">
                    <div class="container">

                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.nombre, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.TextBoxFor(usuarioModel => usuarioModel.nombre, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.nombre, "", new { @class = "text-danger" })
                        </div>
                        <div class="row mt-1">
                            <div class="col">
                                @Html.LabelFor(usuarioModel => usuarioModel.primerApellido, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                                @Html.TextBoxFor(usuarioModel => usuarioModel.primerApellido, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.primerApellido, "", new { @class = "text-danger" })
                            </div>
                            <div class="col">
                                @Html.LabelFor(usuarioModel => usuarioModel.segundoApellido, new { Style = "font-size:22px" })
                                @Html.TextBoxFor(usuarioModel => usuarioModel.segundoApellido, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.segundoApellido, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group mt-1">
                            <div class="form-group mt-1">
                                @Html.LabelFor(usuarioModel => usuarioModel.correo, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                                <div class="input-group">
                                    @Html.TextBoxFor(usuarioModel => usuarioModel.correo, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                    <span class="input-group-text"><b>@@ucr.ac.cr</b></span>
                                </div>
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.correo, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.correoAlternativo, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.TextBoxFor(usuarioModel => usuarioModel.correoAlternativo, new { @class = "form-control", @maxlength = "64", @autocomplete = "off", @type = "email" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.correoAlternativo, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.gradoAcademico, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(usuarioModel => usuarioModel.gradoAcademico, new SelectList(new List<string> 
                            { 
                                "Doctorado - PhD", 
                                "Maestría - MSc", 
                                "Licenciatura - Lic", 
                                "Bachillerato - Bach" 
                            }), "Seleccione su grado académico...", new { @class = "form-control" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.gradoAcademico, "", new { @class = "text-danger" })
                        </div>
                        <div class="row mt-1">
                            <div class="col">
                                @Html.LabelFor(usuarioModel => usuarioModel.tipoIdentificacion, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                                @Html.DropDownListFor(usuarioModel => usuarioModel.tipoIdentificacion, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoIdentificacion))), "Seleccione su tipo de identificación...", new { @class = "form-control" })
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.tipoIdentificacion, "", new { @class = "text-danger" })
                            </div>
                            <div class="col">
                                @Html.LabelFor(usuarioModel => usuarioModel.numeroIdentificacion, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                                @Html.TextBoxFor(usuarioModel => usuarioModel.numeroIdentificacion, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.numeroIdentificacion, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">
                                    Formato de cédula: 1-1100-1100 (con guiones)
                                </small>
                            </div>
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.tipoParticipante, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(
                                     usuarioModel => usuarioModel.tipoParticipante,
                                     new SelectList(
                                     Enum.GetValues(typeof(webMetics.Models.TipoDeParticipantes))
                                     .Cast<webMetics.Models.TipoDeParticipantes>()
                                     .Select(e => new { Value = e, Text = EnumHelper.GetDisplayName(e) }),
                                     "Value",
                                     "Text"),
                                     "Seleccione un tipo de participante...",
                                     new { @class = "form-control" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.tipoParticipante, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.area, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(usuarioModel => usuarioModel.area, new SelectList(ViewData["jsonDataAreas"] as List<string>), "Seleccione un área...", new { @class = "form-control", id = "areaDropdown" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.area, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.departamento, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(usuarioModel => usuarioModel.departamento, new SelectList(Enumerable.Empty<SelectListItem>()), "Seleccione un departamento...", new { @class = "form-control", id = "departamentoDropdown" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.departamento, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.unidadAcademica, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(usuarioModel => usuarioModel.unidadAcademica, new SelectList(Enumerable.Empty<SelectListItem>()), "Seleccione una unidad académica...", new { @class = "form-control", id = "seccionDropdown" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.unidadAcademica, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.sede, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.DropDownListFor(usuarioModel => usuarioModel.sede, webMetics.Controllers.ParticipanteController.GetSedes(), "Seleccione una sede y recinto...", new { @class = "form-control" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.sede, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.carrera, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            <select id="carreraDropdown" class="form-control">
                                <option value="">Seleccione una carrera...</option>
                            </select>
                            <input type="text" id="carreraPersonalizada" class="form-control mt-2 d-none"
                                   maxlength="512" autocomplete="off"
                                   placeholder="Escriba el nombre de su carrera" />
                            <small id="carreraFormato" class="form-text text-muted d-none">
                                Se guardará en mayúsculas y sin tildes.
                            </small>
                            <small id="carreraPreview" class="form-text text-muted d-none"></small>
                            @Html.HiddenFor(usuarioModel => usuarioModel.carrera)
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.carrera, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.telefono, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a>
                            @Html.TextBoxFor(usuarioModel => usuarioModel.telefono, new { @class = "form-control", @maxlength = "64", @minlength = "7", @autocomplete = "off" })
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.telefono, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mt-1">
                            @Html.LabelFor(usuarioModel => usuarioModel.condicion, new { Style = "font-size:22px" }) <a style="color:red;font-size:22px">*</a><br/>
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Interino(a)") @Html.Label("Profesor(a) Interino(a)")<br/>
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Instructor(a)") @Html.Label("Profesor(a) Instructor(a)")<br/>
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Adjunto(a)") @Html.Label("Profesor(a) Adjunto(a)")<br />
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Catedrático(a)") @Html.Label("Profesor(a) Catedrático(a)")<br />
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Invitado(a)") @Html.Label("Profesor(a) Invitado(a)")<br />
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Profesor(a) Asociado(a)") @Html.Label("Profesor(a) Asociado(a)")<br />
                            @Html.RadioButtonFor(usuarioModel => usuarioModel.condicion, "Otro") @Html.Label("Otro")<br />
                            @Html.ValidationMessageFor(usuarioModel => usuarioModel.condicion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row justify-content-center m-4">
                        <div class="col-auto">
                            <a href="#" class="btn btn-secondary btn-block" onclick="history.go(-1); return false;">Cancelar</a>
                        </div>
                        <div class="col-auto">
                            <input type="submit" class="btn btn-primary btn-block" value="Guardar" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var endpoints = {
                departamentos: '@Url.Action("GetDepartamentosByArea", "Participante")',
                secciones: '@Url.Action("GetSeccionesByDepartamento", "Participante")',
                carreras: '@Url.Action("GetCarrerasBySeccionAndSede", "Participante")'
            };

            var estadoInicial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                area = Model?.area ?? string.Empty,
                departamento = Model?.departamento ?? string.Empty,
                unidadAcademica = Model?.unidadAcademica ?? string.Empty,
                sede = Model?.sede ?? string.Empty,
                carrera = Model?.carrera ?? string.Empty
            }));

            var CARRERA_OTRA = '__OTRA__';
            var carrerasActuales = [];

            function mostrarError(mensaje) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: mensaje
                });
            }

            function resetDepartamentos() {
                $('#departamentoDropdown')
                    .empty()
                    .append($('<option>', { value: '', text: 'Seleccione un departamento...' }));
            }

            function resetSecciones() {
                $('#seccionDropdown')
                    .empty()
                    .append($('<option>', { value: '', text: 'Seleccione una unidad académica...' }));
            }

            function cargarSecciones(areaName, departamentoName) {
                resetSecciones();
                resetCarreras();

                if (!areaName || !departamentoName) {
                    return $.Deferred().resolve().promise();
                }

                $('#seccionDropdown').prop('disabled', true);
                return $.ajax({
                    url: endpoints.secciones,
                    type: 'GET',
                    data: { areaName: areaName, departamentoName: departamentoName },
                    dataType: 'json'
                }).done(function (data) {
                    $.each(data || [], function (index, value) {
                        $('#seccionDropdown').append($('<option>', { value: value, text: value }));
                    });
                }).fail(function () {
                    mostrarError('No fue posible cargar las unidades académicas. Intente nuevamente.');
                }).always(function () {
                    $('#seccionDropdown').prop('disabled', false);
                });
            }

            function cargarDepartamentos(areaName) {
                resetDepartamentos();
                resetSecciones();
                resetCarreras();

                if (!areaName) {
                    return $.Deferred().resolve().promise();
                }

                $('#departamentoDropdown').prop('disabled', true);
                return $.ajax({
                    url: endpoints.departamentos,
                    type: 'GET',
                    data: { areaName: areaName },
                    dataType: 'json'
                }).done(function (data) {
                    $.each(data || [], function (index, value) {
                        $('#departamentoDropdown').append($('<option>', { value: value, text: value }));
                    });
                }).fail(function () {
                    mostrarError('No fue posible cargar las facultades o departamentos. Intente nuevamente.');
                }).always(function () {
                    $('#departamentoDropdown').prop('disabled', false);
                });
            }

            function normalizarCarrera(valor) {
                return (valor || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toUpperCase()
                    .replace(/[^A-Z0-9]+/g, ' ')
                    .trim()
                    .slice(0, 512);
            }

            // Replica la regla del servidor: si lo escrito calza con una carrera del
            // cat\u00e1logo devuelve el nombre oficial; si no, devuelve el normalizado.
            function resolverCarrera(valor) {
                var normalizada = normalizarCarrera(valor);
                if (!normalizada) {
                    return '';
                }

                for (var i = 0; i < carrerasActuales.length; i++) {
                    if (normalizarCarrera(carrerasActuales[i]) === normalizada) {
                        return carrerasActuales[i];
                    }
                }

                return normalizada;
            }

            function resetCarreras() {
                carrerasActuales = [];
                $('#carreraDropdown')
                    .empty()
                    .append($('<option>', { value: '', text: 'Seleccione una carrera...' }));
                $('#carreraPersonalizada').addClass('d-none').val('');
                $('#carreraFormato').addClass('d-none');
                $('#carreraPreview').addClass('d-none').text('');
                $('#carrera').val('');
            }

            function sincronizarCarrera() {
                var seleccion = $('#carreraDropdown').val();

                if (seleccion !== CARRERA_OTRA) {
                    $('#carreraPersonalizada').addClass('d-none').val('');
                    $('#carreraFormato').addClass('d-none');
                    $('#carreraPreview').addClass('d-none').text('');
                    $('#carrera').val(seleccion || '');
                    return;
                }

                // La regla de formato se anuncia al activar "Otra", antes de teclear;
                // la vista previa de abajo aparece después, ya con el valor concreto.
                $('#carreraPersonalizada').removeClass('d-none');
                $('#carreraFormato').removeClass('d-none');

                var crudo = $('#carreraPersonalizada').val() || '';
                var resuelta = resolverCarrera(crudo);
                $('#carrera').val(resuelta);

                if (resuelta && resuelta !== crudo.trim()) {
                    $('#carreraPreview')
                        .removeClass('d-none')
                        .text('Se guardar\u00e1 como: ' + resuelta);
                } else {
                    $('#carreraPreview').addClass('d-none').text('');
                }
            }

            function setCarreras(carreras, seleccionInicial) {
                resetCarreras();
                carrerasActuales = carreras || [];

                $.each(carrerasActuales, function (index, value) {
                    $('#carreraDropdown').append($('<option>', { value: value, text: value }));
                });
                $('#carreraDropdown').append($('<option>', {
                    value: CARRERA_OTRA,
                    text: 'Otra (no est\u00e1 en la lista)'
                }));

                var enLista = seleccionInicial && $.grep(carrerasActuales, function (c) {
                    return c === seleccionInicial;
                }).length > 0;

                if (enLista) {
                    $('#carreraDropdown').val(seleccionInicial);
                } else if (seleccionInicial) {
                    $('#carreraDropdown').val(CARRERA_OTRA);
                    $('#carreraPersonalizada').val(seleccionInicial);
                } else if (carrerasActuales.length === 0) {
                    // Sin cat\u00e1logo para esa unidad y sede (caso Sedes Regionales):
                    // se fuerza el campo libre.
                    $('#carreraDropdown').val(CARRERA_OTRA);
                }

                sincronizarCarrera();
            }

            function cargarCarreras(seleccionInicial) {
                var areaName = $('#areaDropdown').val();
                var departamentoName = $('#departamentoDropdown').val();
                var unidadAcademica = $('#seccionDropdown').val();
                var sede = $('#sede').val();

                resetCarreras();

                if (!areaName || !departamentoName || !unidadAcademica || !sede) {
                    return $.Deferred().resolve().promise();
                }

                $('#carreraDropdown').prop('disabled', true);
                return $.ajax({
                    url: endpoints.carreras,
                    type: 'GET',
                    data: {
                        areaName: areaName,
                        departamentoName: departamentoName,
                        unidadAcademica: unidadAcademica,
                        sede: sede
                    },
                    dataType: 'json'
                }).done(function (data) {
                    setCarreras(data || [], seleccionInicial);
                }).fail(function () {
                    mostrarError('No fue posible cargar las carreras. Intente nuevamente.');
                    // Sin cat\u00e1logo se deja el campo libre para no bloquear el registro.
                    setCarreras([], seleccionInicial);
                }).always(function () {
                    $('#carreraDropdown').prop('disabled', false);
                });
            }

            $('#areaDropdown').on('change', function () {
                cargarDepartamentos($(this).val());
            });

            $('#departamentoDropdown').on('change', function () {
                cargarSecciones($('#areaDropdown').val(), $(this).val());
            });

            $('#seccionDropdown').on('change', function () {
                cargarCarreras('');
            });

            $('#sede').on('change', function () {
                cargarCarreras('');
            });

            $('#carreraDropdown').on('change', sincronizarCarrera);
            $('#carreraPersonalizada').on('input', sincronizarCarrera);

            // Restauración tras un error de validación: cada eslabón espera al anterior.
            if (estadoInicial.area) {
                $('#areaDropdown').val(estadoInicial.area);

                cargarDepartamentos(estadoInicial.area)
                    .then(function () {
                        if (!estadoInicial.departamento) {
                            return;
                        }
                        $('#departamentoDropdown').val(estadoInicial.departamento);
                        return cargarSecciones(estadoInicial.area, estadoInicial.departamento);
                    })
                    .then(function () {
                        if (estadoInicial.unidadAcademica) {
                            $('#seccionDropdown').val(estadoInicial.unidadAcademica);
                        }
                        if (estadoInicial.sede) {
                            $('#sede').val(estadoInicial.sede);
                        }
                        return cargarCarreras(estadoInicial.carrera);
                    });
            }
        });
    </script>
}
