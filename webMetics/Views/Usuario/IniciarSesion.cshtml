@model webMetics.Models.LoginModel
@{
    ViewBag.Title = "Iniciar sesión";
}


<style>
    .body-content:has(.metics-login-page) {
        display: flex;
        flex: 1 0 auto;
        flex-direction: column;
        margin: 0;
        max-width: none;
        padding: 0;
        width: 100%;
    }

    .body-content:has(.metics-login-page) + .metics-footer { margin-top: 0; }

    .metics-login-page {
        align-items: center;
        background-color: var(--metics-surface-table-head);
        background-image: url('/images/fondo_login_waves.svg');
        background-position: center bottom;
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        flex: 1 0 auto;
        justify-content: center;
        min-height: 0;
        padding: var(--metics-space-9) var(--metics-space-4);
        width: 100%;
    }

    .metics-login-shell { margin: 0 auto; max-width: 480px; width: 100%; }
    .metics-login-card {
        background: var(--metics-surface);
        border: 1px solid var(--metics-border-card);
        border-radius: var(--metics-radius-xl);
        box-shadow: var(--metics-shadow-modal);
        overflow: hidden;
        width: 100%;
    }
    .metics-login-card-header {
        align-items: center;
        background: var(--metics-surface);
        border-bottom: 1px solid var(--metics-divider-row);
        display: flex;
        gap: var(--metics-space-4);
        padding: var(--metics-space-6) var(--metics-space-8);
    }
    .metics-login-brand-icon {
        align-items: center;
        background: var(--metics-icon-surface);
        border-radius: var(--metics-radius-card);
        color: var(--metics-interactive-blue);
        display: inline-flex;
        flex: 0 0 50px;
        height: 50px;
        justify-content: center;
    }
    .metics-login-brand-icon .bi { font-size: var(--metics-font-size-2xl); }
    .metics-login-brand-copy { min-width: 0; }
    .metics-login-brand-copy p { color: var(--metics-ink-placeholder); font-size: var(--metics-font-size-xs); font-weight: var(--metics-font-weight-semibold); margin: 0 0 var(--metics-space-0-5); }
    .metics-login-brand-copy h1 { color: var(--metics-ink-heading); font-size: var(--metics-font-size-2xl); font-weight: var(--metics-font-weight-bold); line-height: 1.2; margin: 0; }
    .metics-login-card-body { padding: var(--metics-space-7) var(--metics-space-8) var(--metics-space-7); }
    .metics-login-heading { color: var(--metics-ink-heading); font-size: var(--metics-font-size-2xl); font-weight: var(--metics-font-weight-bold); margin: 0; }
    .metics-login-subtitle { color: var(--metics-ink-muted); font-size: var(--metics-font-size-sm); line-height: 1.5; margin: var(--metics-space-1-5) 0 var(--metics-space-5-5); }
    .metics-login-form { display: grid; gap: var(--metics-space-4); }
    .metics-login-field { min-width: 0; }
    .metics-login-label { color: var(--metics-ink-label); display: block; font-size: var(--metics-font-size-sm); font-weight: var(--metics-font-weight-semibold); margin-bottom: var(--metics-space-1-5); }
    .metics-login-email .form-control,
    .metics-login-password-wrap .form-control {
        border-color: var(--metics-border-input);
        border-radius: var(--metics-radius-md);
        color: var(--metics-ink-heading);
        font-size: var(--metics-font-size-sm);
        min-height: var(--metics-control-lg);
    }
    .metics-login-email .form-control:focus,
    .metics-login-password-wrap .form-control:focus {
        border-color: var(--metics-interactive-blue);
        box-shadow: var(--metics-shadow-focus);
    }
    .metics-login-email .input-group-text {
        background: var(--metics-icon-surface);
        border-color: var(--metics-border-input);
        border-radius: 0 var(--metics-radius-md) var(--metics-radius-md) 0;
        color: var(--metics-interactive-blue) !important;
        font-size: var(--metics-font-size-sm);
        font-weight: var(--metics-font-weight-semibold);
        padding: 0 var(--metics-space-3);
    }
    .metics-login-email .form-control { border-radius: var(--metics-radius-md) 0 0 var(--metics-radius-md); }
    .metics-login-password-wrap { position: relative; }
    .metics-login-password-wrap .form-control { padding-right: var(--metics-space-12); }
    .metics-login-password-toggle {
        align-items: center;
        background: transparent;
        border: 0;
        border-radius: var(--metics-radius-sm);
        color: var(--metics-interactive-blue);
        display: inline-flex;
        height: var(--metics-icon-button-sm);
        justify-content: center;
        position: absolute;
        right: 7px;
        top: 6px;
        width: var(--metics-icon-button-sm);
    }
    .metics-login-password-toggle:hover { background: var(--metics-icon-surface); }
    .metics-login-password-toggle:focus-visible { outline: 2px solid var(--metics-interactive-blue); outline-offset: 1px; }
    .metics-login-password-toggle .fa { font-size: var(--metics-font-size-md); }
    .metics-login-validation { color: var(--metics-danger); display: block; font-size: var(--metics-font-size-2xs); line-height: 1.4; margin-top: var(--metics-space-1); }
    .metics-login-feedback {
        border-radius: var(--metics-radius-md);
        font-size: var(--metics-font-size-xs);
        line-height: 1.45;
        margin: 0;
        padding: var(--metics-space-2-5) var(--metics-space-3);
    }
    .metics-login-feedback-error { background: var(--metics-danger-icon-fill); border: 1px solid var(--metics-error-border); color: var(--metics-danger-text); }
    .metics-login-feedback-success { background: var(--metics-success-tint); border: 1px solid var(--metics-success-border); color: var(--metics-success-text); }
    .metics-login-note {
        align-items: flex-start;
        background: var(--metics-icon-surface);
        border: 1px solid var(--metics-border-modal);
        border-radius: var(--metics-radius-md);
        color: var(--metics-ink-muted);
        display: flex;
        font-size: var(--metics-font-size-2xs);
        gap: var(--metics-space-2);
        line-height: 1.5;
        margin: 0;
        padding: var(--metics-space-2-5) var(--metics-space-3);
    }
    .metics-login-note .bi { color: var(--metics-interactive-blue); flex: 0 0 auto; font-size: var(--metics-font-size-md); margin-top: var(--metics-space-0-5); }
    .metics-login-submit {
        align-items: center;
        background: var(--metics-action-blue);
        border: 1px solid var(--metics-action-blue);
        border-radius: var(--metics-button-radius);
        color: var(--metics-ink-on-dark);
        display: flex;
        font-size: var(--metics-button-font-size);
        font-weight: var(--metics-button-font-weight);
        justify-content: center;
        min-height: var(--metics-control-lg);
        width: 100%;
    }
    .metics-login-submit:hover,
    .metics-login-submit:focus-visible { background: var(--metics-action-hover); border-color: var(--metics-action-hover); color: var(--metics-ink-on-dark); }
    .metics-login-card-footer {
        background: var(--metics-surface-hover);
        border-top: 1px solid var(--metics-divider-row);
        padding: var(--metics-space-3-5) var(--metics-space-8) var(--metics-space-4);
    }
    .metics-login-secondary-links { display: grid; gap: var(--metics-space-2-5); grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metics-login-secondary-link {
        background: var(--metics-surface);
        border: 1px solid var(--metics-border-card);
        border-radius: var(--metics-radius-md);
        display: flex;
        flex-direction: column;
        gap: var(--metics-space-0-5);
        justify-content: center;
        min-height: 62px;
        padding: var(--metics-space-2) var(--metics-space-2-5);
    }
    .metics-login-secondary-link span { color: var(--metics-ink-muted); font-size: var(--metics-font-size-2xs); line-height: 1.35; }
    .metics-login-secondary-link a { font-size: var(--metics-font-size-xs); line-height: 1.35; }
    .metics-login-page a { color: var(--metics-interactive-blue); font-weight: var(--metics-font-weight-semibold); text-underline-offset: 2px; }
    .metics-login-page a:hover { color: var(--metics-action-hover); }
    .metics-login-support { color: var(--metics-ink-muted); font-size: var(--metics-font-size-2xs); line-height: 1.45; margin: var(--metics-space-2-5) 0 0; text-align: center; }

    @@media (max-width: 575.98px) {
        .metics-login-page { padding: var(--metics-space-6) var(--metics-space-3); }
        .metics-login-card-header { padding: var(--metics-space-5) var(--metics-space-5); }
        .metics-login-card-body { padding: var(--metics-space-5-5) var(--metics-space-5) var(--metics-space-5-5); }
        .metics-login-card-footer { padding: var(--metics-space-4) var(--metics-space-5) var(--metics-space-4-5); }
        .metics-login-brand-copy h1 { font-size: var(--metics-font-size-xl); }
    }
</style>

<main class="metics-login-page">
    <div class="metics-login-shell">
        <section class="metics-login-card" aria-labelledby="loginHeading">
            <header class="metics-login-card-header">
                <span class="metics-login-brand-icon" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                <div class="metics-login-brand-copy">
                    <p>Sistema de Inscripciones</p>
                    <h1>METICS</h1>
                </div>
            </header>

            <div class="metics-login-card-body">
                <h2 class="metics-login-heading" id="loginHeading">Iniciar sesión</h2>
                <p class="metics-login-subtitle">Ingrese con su cuenta institucional para continuar.</p>

                @using (Html.BeginForm("IniciarSesion", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", @class = "metics-login-form" }))
                {
                    <div class="metics-login-field">
                        @Html.LabelFor(loginModel => loginModel.id, new { @class = "metics-login-label" })
                        <div class="input-group metics-login-email">
                            @Html.TextBoxFor(loginModel => loginModel.id, new { @class = "form-control", @autocomplete = "on" })
                            <span class="input-group-text"><b>@@ucr.ac.cr</b></span>
                        </div>
                        @Html.ValidationMessageFor(loginModel => loginModel.id, "", new { @class = "metics-login-validation" })
                    </div>

                    <div class="metics-login-field">
                        @Html.LabelFor(loginModel => loginModel.contrasena, new { @class = "metics-login-label", @for = "password" })
                        <div class="metics-login-password-wrap">
                            @Html.PasswordFor(loginModel => loginModel.contrasena, new { @id = "password", @class = "form-control" })
                            <button type="button" class="metics-password-toggle" onclick="togglePasswordVisibility()" aria-label="Mostrar u ocultar contraseña">
                                <i id="toggleIcon" class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(loginModel => loginModel.contrasena, "", new { @class = "metics-login-validation" })
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="metics-login-feedback metics-login-feedback-error" role="alert">@ViewBag.ErrorMessage</div>
                    }
                    else if (ViewBag.SuccessMessage != null)
                    {
                        <div class="metics-login-feedback metics-login-feedback-success" role="status">@ViewBag.SuccessMessage</div>
                    }

                    <p class="metics-login-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Importante:</strong> El SIMETICS <u>no</u> utiliza la misma contraseña del correo institucional.</span></p>

                    <button type="submit" class="btn metics-login-submit">Acceder</button>
                }
            </div>

            <div class="metics-login-card-footer">
                <div class="metics-login-secondary-links">
                    <div class="metics-login-secondary-link">
                        <span>¿Primera vez en METICS?</span>
                        @Html.ActionLink("Regístrate aquí", "FormularioRegistro", "Usuario", null, new { aria_label = "Formulario de registro" })
                    </div>
                    <div class="metics-login-secondary-link">
                        <span>¿Olvidó su contraseña?</span>
                        @Html.ActionLink("Recupere su acceso", "FormularioRecuperarContrasena", "Participante", null, new { aria_label = "Recuperar contraseña" })
                    </div>
                </div>
                <p class="metics-login-support">¿Dudas? Escríbenos a <a href="mailto:soporte.metics@ucr.ac.cr">soporte.metics@ucr.ac.cr</a>.</p>
            </div>
        </section>
    </div>
</main>

<script>
    function togglePasswordVisibility() {
        var passwordInput = document.getElementById('password');
        var toggleIcon = document.getElementById('toggleIcon');
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleIcon.classList.remove('bi-eye');
            toggleIcon.classList.add('bi-eye-slash');
        } else {
            passwordInput.type = "password";
            toggleIcon.classList.remove('bi-eye-slash');
            toggleIcon.classList.add('bi-eye');
        }
    }
</script>
