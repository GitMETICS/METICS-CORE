@model webMetics.Models.LoginModel
@{
    ViewBag.Title = "Iniciar sesión";
}


<style>
    .body-content:has(.metics-login-page) {
        display: flex;
        flex: 1 0 auto;
        flex-direction: column;
        margin: 0;
        max-width: none;
        padding: 0;
        width: 100%;
    }

    .body-content:has(.metics-login-page) + .metics-footer { margin-top: 0; }

    .metics-login-page {
        align-items: center;
        background-color: #F1F5FB;
        background-image: url('/images/fondo_login_waves.svg');
        background-position: center bottom;
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        flex: 1 0 auto;
        justify-content: center;
        min-height: 0;
        padding: 36px var(--metics-space-4);
        width: 100%;
    }

    .metics-login-shell { margin: 0 auto; max-width: 480px; width: 100%; }
    .metics-login-card {
        background: var(--metics-surface);
        border: 1px solid #dfe7f0;
        border-radius: 16px;
        box-shadow: 0 16px 42px rgba(19, 49, 82, .14);
        overflow: hidden;
        width: 100%;
    }
    .metics-login-card-header {
        align-items: center;
        background: var(--metics-surface);
        border-bottom: 1px solid #e6edf5;
        display: flex;
        gap: var(--metics-space-4);
        padding: var(--metics-space-6) 30px;
    }
    .metics-login-brand-icon {
        align-items: center;
        background: var(--metics-icon-surface);
        border-radius: 13px;
        color: var(--metics-interactive-blue);
        display: inline-flex;
        flex: 0 0 50px;
        height: 50px;
        justify-content: center;
    }
    .metics-login-brand-icon .bi { font-size: 23px; }
    .metics-login-brand-copy { min-width: 0; }
    .metics-login-brand-copy p { color: #5f7691; font-size: 13px; font-weight: 600; margin: 0 0 2px; }
    .metics-login-brand-copy h1 { color: #1b2f49; font-size: 23px; font-weight: 700; line-height: 1.2; margin: 0; }
    .metics-login-card-body { padding: 26px 30px 28px; }
    .metics-login-heading { color: #1b2f49; font-size: 22px; font-weight: 700; margin: 0; }
    .metics-login-subtitle { color: #647991; font-size: 14px; line-height: 1.5; margin: 6px 0 23px; }
    .metics-login-form { display: grid; gap: 17px; }
    .metics-login-field { min-width: 0; }
    .metics-login-label { color: #263c56; display: block; font-size: 14px; font-weight: 600; margin-bottom: 7px; }
    .metics-login-email .form-control,
    .metics-login-password-wrap .form-control {
        border-color: #cdd9e7;
        border-radius: 8px;
        color: #1b2f49;
        font-size: 14px;
        min-height: 46px;
    }
    .metics-login-email .form-control:focus,
    .metics-login-password-wrap .form-control:focus {
        border-color: var(--metics-interactive-blue);
        box-shadow: var(--metics-shadow-focus);
    }
    .metics-login-email .input-group-text {
        background: var(--metics-icon-surface);
        border-color: #cdd9e7;
        border-radius: 0 8px 8px 0;
        color: var(--metics-interactive-blue) !important;
        font-size: 14px;
        font-weight: 600;
        padding: 0 13px;
    }
    .metics-login-email .form-control { border-radius: 8px 0 0 8px; }
    .metics-login-password-wrap { position: relative; }
    .metics-login-password-wrap .form-control { padding-right: 48px; }
    .metics-login-password-toggle {
        align-items: center;
        background: transparent;
        border: 0;
        border-radius: var(--metics-radius-sm);
        color: var(--metics-interactive-blue);
        display: inline-flex;
        height: 34px;
        justify-content: center;
        position: absolute;
        right: 7px;
        top: 6px;
        width: 34px;
    }
    .metics-login-password-toggle:hover { background: var(--metics-icon-surface); }
    .metics-login-password-toggle:focus-visible { outline: 2px solid var(--metics-interactive-blue); outline-offset: 1px; }
    .metics-login-password-toggle .fa { font-size: 15px; }
    .metics-login-validation { color: var(--metics-danger); display: block; font-size: 12px; line-height: 1.4; margin-top: 5px; }
    .metics-login-feedback {
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.45;
        margin: 0;
        padding: 10px var(--metics-space-3);
    }
    .metics-login-feedback-error { background: #fff1f1; border: 1px solid #f0caca; color: #a52834; }
    .metics-login-feedback-success { background: #eff9f2; border: 1px solid #cce8d3; color: #236b3b; }
    .metics-login-note {
        align-items: flex-start;
        background: var(--metics-icon-surface);
        border: 1px solid #dce8f5;
        border-radius: 8px;
        color: #526987;
        display: flex;
        font-size: 12px;
        gap: 9px;
        line-height: 1.5;
        margin: 0;
        padding: 10px var(--metics-space-3);
    }
    .metics-login-note .bi { color: var(--metics-interactive-blue); flex: 0 0 auto; font-size: 15px; margin-top: 1px; }
    .metics-login-submit {
        align-items: center;
        background: var(--metics-action-blue);
        border: 1px solid var(--metics-action-blue);
        border-radius: 8px;
        color: var(--metics-ink-on-dark);
        display: flex;
        font-size: 15px;
        font-weight: 600;
        justify-content: center;
        min-height: 46px;
        width: 100%;
    }
    .metics-login-submit:hover,
    .metics-login-submit:focus-visible { background: var(--metics-action-hover); border-color: var(--metics-action-hover); color: var(--metics-ink-on-dark); }
    .metics-login-card-footer {
        background: #f8fafd;
        border-top: 1px solid #e6edf5;
        padding: 14px 30px var(--metics-space-4);
    }
    .metics-login-secondary-links { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metics-login-secondary-link {
        background: var(--metics-surface);
        border: 1px solid #e1e9f2;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        justify-content: center;
        min-height: 62px;
        padding: var(--metics-space-2) 11px;
    }
    .metics-login-secondary-link span { color: #647991; font-size: 11px; line-height: 1.35; }
    .metics-login-secondary-link a { font-size: 13px; line-height: 1.35; }
    .metics-login-page a { color: var(--metics-interactive-blue); font-weight: 600; text-underline-offset: 2px; }
    .metics-login-page a:hover { color: var(--metics-action-hover); }
    .metics-login-support { color: #647991; font-size: 12px; line-height: 1.45; margin: 10px 0 0; text-align: center; }

    @@media (max-width: 575.98px) {
        .metics-login-page { padding: var(--metics-space-6) var(--metics-space-3); }
        .metics-login-card-header { padding: var(--metics-space-5) var(--metics-space-5); }
        .metics-login-card-body { padding: 22px var(--metics-space-5) 22px; }
        .metics-login-card-footer { padding: var(--metics-space-4) var(--metics-space-5) 18px; }
        .metics-login-brand-copy h1 { font-size: 21px; }
    }
</style>

<main class="metics-login-page">
    <div class="metics-login-shell">
        <section class="metics-login-card" aria-labelledby="loginHeading">
            <header class="metics-login-card-header">
                <span class="metics-login-brand-icon" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                <div class="metics-login-brand-copy">
                    <p>Sistema de Inscripciones</p>
                    <h1>METICS</h1>
                </div>
            </header>

            <div class="metics-login-card-body">
                <h2 class="metics-login-heading" id="loginHeading">Iniciar sesión</h2>
                <p class="metics-login-subtitle">Ingrese con su cuenta institucional para continuar.</p>

                @using (Html.BeginForm("IniciarSesion", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", @class = "metics-login-form" }))
                {
                    <div class="metics-login-field">
                        @Html.LabelFor(loginModel => loginModel.id, new { @class = "metics-login-label" })
                        <div class="input-group metics-login-email">
                            @Html.TextBoxFor(loginModel => loginModel.id, new { @class = "form-control", @autocomplete = "on" })
                            <span class="input-group-text"><b>@@ucr.ac.cr</b></span>
                        </div>
                        @Html.ValidationMessageFor(loginModel => loginModel.id, "", new { @class = "metics-login-validation" })
                    </div>

                    <div class="metics-login-field">
                        @Html.LabelFor(loginModel => loginModel.contrasena, new { @class = "metics-login-label" })
                        <div class="metics-login-password-wrap">
                            @Html.PasswordFor(loginModel => loginModel.contrasena, new { @id = "password", @class = "form-control" })
                            <button type="button" class="metics-password-toggle" onclick="togglePasswordVisibility()" aria-label="Mostrar u ocultar contraseña">
                                <i id="toggleIcon" class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(loginModel => loginModel.contrasena, "", new { @class = "metics-login-validation" })
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="metics-login-feedback metics-login-feedback-error" role="alert">@ViewBag.ErrorMessage</div>
                    }
                    else if (ViewBag.SuccessMessage != null)
                    {
                        <div class="metics-login-feedback metics-login-feedback-success" role="status">@ViewBag.SuccessMessage</div>
                    }

                    <p class="metics-login-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Importante:</strong> El SIMETICS <u>no</u> utiliza la misma contraseña del correo institucional.</span></p>

                    <button type="submit" class="btn metics-login-submit">Acceder</button>
                }
            </div>

            <div class="metics-login-card-footer">
                <div class="metics-login-secondary-links">
                    <div class="metics-login-secondary-link">
                        <span>¿Primera vez en METICS?</span>
                        @Html.ActionLink("Regístrate aquí", "FormularioRegistro", "Usuario", null, new { aria_label = "Formulario de registro" })
                    </div>
                    <div class="metics-login-secondary-link">
                        <span>¿Olvidaste tu contraseña?</span>
                        @Html.ActionLink("Recupera tu acceso", "FormularioRecuperarContrasena", "Participante", null, new { aria_label = "Recuperar contraseña" })
                    </div>
                </div>
                <p class="metics-login-support">¿Dudas? Escríbenos a <a href="mailto:soporte.metics@ucr.ac.cr">soporte.metics@ucr.ac.cr</a>.</p>
            </div>
        </section>
    </div>
</main>

<script>
    function togglePasswordVisibility() {
        var passwordInput = document.getElementById('password');
        var toggleIcon = document.getElementById('toggleIcon');
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleIcon.classList.remove('bi-eye');
            toggleIcon.classList.add('bi-eye-slash');
        } else {
            passwordInput.type = "password";
            toggleIcon.classList.remove('bi-eye-slash');
            toggleIcon.classList.add('bi-eye');
        }
    }
</script>
