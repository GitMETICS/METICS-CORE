@model webMetics.Models.UsuarioModel
@{
    ViewBag.Title = "Completar Información - Grado Académico";
}

<div class="contenedor-caja container-fluid required-update-page admin-panel-page">
    @await Html.PartialAsync("_MeticsToast")

    <section class="admin-panel-card required-update-card" aria-labelledby="actualizacionRequeridaTitulo">
        <div class="required-update-header">
            <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-mortarboard"></i></span>
            <div>
                <h1 class="required-update-title" id="actualizacionRequeridaTitulo">Actualización requerida</h1>
                <p class="admin-panel-card-desc">Para continuar, complete su grado académico.</p>
            </div>
        </div>

        @using (Html.BeginForm("CompletarGradoAcademico", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="required-update-account">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <div>
                    <span>Correo institucional</span>
                    <strong>@Model.correo</strong>
                </div>
            </div>

            <div class="required-update-field">
                @Html.LabelFor(m => m.gradoAcademico) <span class="required-update-required" aria-hidden="true">*</span>
                <small class="required-update-help">Seleccione su grado académico máximo.</small>
                @Html.DropDownListFor(m => m.gradoAcademico, new SelectList(new List<string>
                {
                    "Doctorado - PhD",
                    "Maestría - MSc",
                    "Licenciatura - Lic",
                    "Bachillerato - Bach"
                }), "Seleccione su grado académico...", new { @class = "form-control", @required = "required" })
                @Html.ValidationMessageFor(m => m.gradoAcademico, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn admin-panel-btn-primary required-update-submit">
                <i class="bi bi-check-circle" aria-hidden="true"></i>Guardar y continuar
            </button>

            <p class="required-update-footnote">Este dato es importante para conocer el perfil académico de nuestros participantes.</p>
        }
    </section>
</div>

<script src="~/js/metics-form-controls.js" asp-append-version="true"></script>
<script>
    // Misma lista desplegable que el resto del sistema (solo presentación; el select original se envía igual).
    (function () {
        var root = document.querySelector('.required-update-page');
        if (root && window.MeticsFormControls) MeticsFormControls.initSelects(root);
    })();
</script>
