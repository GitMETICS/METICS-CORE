@model webMetics.Models.NewLoginModel
@{
    ViewBag.Title = "Actualizar credenciales de usuario";
    PageHeadingBuilder.Configure(ViewContext, Url, subtitle: Convert.ToString(ViewBag.NombreCompleto));
}
@await Html.PartialAsync("_CredencialesModal", Model)
@await Html.PartialAsync("_MeticsToast")
@section Scripts {
    <script src="~/js/credenciales-modal.js" asp-append-version="true"></script>
    <script>window.addEventListener('DOMContentLoaded', function () { bootstrap.Modal.getOrCreateInstance(document.getElementById('credencialesModal')).show(); });</script>
}
