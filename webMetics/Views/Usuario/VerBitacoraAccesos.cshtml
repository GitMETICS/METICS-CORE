@using webMetics.Controllers
@{
    ViewBag.Title = "Registro de accesos";
    PageHeadingBuilder.Configure(ViewContext, Url, subtitle: "Inicios de sesión exitosos y fallidos registrados en el sistema.");
    ViewData["AdminPanelLayout"] = true;
    ViewData["AdminPanelIcon"] = "bi-clock-history";

    // Solo presentación: recuerda qué filtro se usó para mantener su pestaña abierta y sus valores visibles.
    // Las acciones, los parámetros y las consultas son los mismos de siempre.
    string accionBitacora = (Convert.ToString(ViewContext.RouteData.Values["action"]) ?? "").ToLowerInvariant();
    string pestanaActiva = accionBitacora == "verbitacoraaccesousuario" ? "usuario"
        : accionBitacora == "verbitacoraultimoaccesousuario" ? "ultimo"
        : "fechas";
    string filtroFechaDesde = Context.Request.Query["fechaDesde"].ToString();
    string filtroFechaHasta = Context.Request.Query["fechaHasta"].ToString();
    string filtroEstado = Context.Request.Query["estadoAcceso"].ToString();
    string filtroUsuario = Context.Request.Query["idUsuario"].ToString();
    string filtroDiasAtras = Context.Request.Query["diasAtras"].ToString();
    if (string.IsNullOrWhiteSpace(filtroDiasAtras))
    {
        filtroDiasAtras = "30";
    }

    string descripcionFiltro;
    if (pestanaActiva == "usuario")
    {
        descripcionFiltro = $"Accesos de {filtroUsuario} en los últimos {filtroDiasAtras} días.";
    }
    else if (pestanaActiva == "ultimo")
    {
        descripcionFiltro = $"Último acceso registrado de {filtroUsuario}.";
    }
    else if (accionBitacora == "verbitacoraaccesoporfecha")
    {
        // Mismas reglas que aplica el controlador: "hasta" incluye el día completo y,
        // si solo se indica "hasta", se muestran los 7 días anteriores a esa fecha.
        bool hayDesdeTexto = BitacoraHorario.IntentarLeerFecha(filtroFechaDesde, out DateTime desdeFiltro);
        bool hayHastaTexto = BitacoraHorario.IntentarLeerFecha(filtroFechaHasta, out DateTime hastaFiltro);
        string estadoTexto = filtroEstado == "EXITO" ? "solo exitosos" : filtroEstado == "FRACASO" ? "solo fallidos" : "todos los estados";
        string rangoTexto;
        if (hayDesdeTexto && hayHastaTexto)
        {
            rangoTexto = $"del {desdeFiltro:dd/MM/yyyy} al {hastaFiltro:dd/MM/yyyy}";
        }
        else if (hayHastaTexto)
        {
            rangoTexto = $"del {hastaFiltro.AddDays(-7):dd/MM/yyyy} al {hastaFiltro:dd/MM/yyyy}";
        }
        else if (hayDesdeTexto)
        {
            rangoTexto = $"desde el {desdeFiltro:dd/MM/yyyy} hasta hoy";
        }
        else
        {
            rangoTexto = "de los últimos 7 días";
        }
        descripcionFiltro = $"Accesos {rangoTexto}, {estadoTexto}.";
    }
    else
    {
        descripcionFiltro = "Accesos de los últimos 7 días.";
    }

    // Se omiten entradas vacías (por ejemplo, un usuario sin accesos en "Último acceso") para no fallar al dibujar la tabla.
    var filasBitacora = new List<global::BitacoraAcceso>();
    if (ViewBag.BitacoraAccesos != null)
    {
        foreach (var acceso in ViewBag.BitacoraAccesos)
        {
            if (acceso != null)
            {
                filasBitacora.Add(acceso);
            }
        }
    }
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja admin-panel-page">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />

        <section class="admin-panel-section" aria-label="Registro de accesos">
            @await Html.PartialAsync("_MeticsToast")

            <div class="admin-panel-card">
                <div class="admin-panel-card-header">
                    <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-funnel"></i></span>
                    <div>
                        <h2 class="admin-panel-card-title">Seleccionar tipo de vista</h2>
                        <p class="admin-panel-card-desc">Filtre los accesos por rango de fechas, por usuario o consulte el último acceso de un usuario.</p>
                    </div>
                </div>

                <ul class="nav nav-tabs admin-panel-tabs" id="bitacoraTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(pestanaActiva == "fechas" ? "active" : "")" id="tab-fechas" data-bs-toggle="tab" data-bs-target="#form-fechas-pane" type="button" role="tab" aria-controls="form-fechas-pane" aria-selected="@(pestanaActiva == "fechas" ? "true" : "false")">Por fechas</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(pestanaActiva == "usuario" ? "active" : "")" id="tab-usuario" data-bs-toggle="tab" data-bs-target="#form-usuario-pane" type="button" role="tab" aria-controls="form-usuario-pane" aria-selected="@(pestanaActiva == "usuario" ? "true" : "false")">Por usuario</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(pestanaActiva == "ultimo" ? "active" : "")" id="tab-ultimo-acceso" data-bs-toggle="tab" data-bs-target="#form-ultimo-acceso-pane" type="button" role="tab" aria-controls="form-ultimo-acceso-pane" aria-selected="@(pestanaActiva == "ultimo" ? "true" : "false")">Último acceso</button>
                    </li>
                </ul>

                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade @(pestanaActiva == "fechas" ? "show active" : "")" id="form-fechas-pane" role="tabpanel" aria-labelledby="tab-fechas" tabindex="0">
                        <form action="@Url.Action("VerBitacoraAccesoPorFecha", "Usuario")" method="get" id="formBitacoraFechas">
                            <div class="admin-filter-row admin-filter-row--fechas">
                                <div class="create-category-field mb-0">
                                    <label for="fechaDesde" class="form-label">Fecha desde</label>
                                    <input type="date" id="fechaDesde" name="fechaDesde" class="form-control" value="@filtroFechaDesde">
                                    <span class="text-danger" id="fechaDesdeError" data-valmsg-for="fechaDesde" aria-live="polite"></span>
                                </div>
                                <div class="create-category-field mb-0">
                                    <label for="fechaHasta" class="form-label">Fecha hasta</label>
                                    <input type="date" id="fechaHasta" name="fechaHasta" class="form-control" value="@filtroFechaHasta" aria-describedby="fechaHastaAyuda">
                                    <span class="text-danger" id="fechaHastaError" data-valmsg-for="fechaHasta" aria-live="polite"></span>
                                </div>
                                <div class="create-category-field mb-0">
                                    <label for="estadoAcceso" class="form-label">Estado de acceso</label>
                                    <select id="estadoAcceso" name="estadoAcceso" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="EXITO" selected="@(filtroEstado == "EXITO")">Éxito</option>
                                        <option value="FRACASO" selected="@(filtroEstado == "FRACASO")">Fallido</option>
                                    </select>
                                </div>
                                <div class="create-category-field mb-0 admin-filter-action">
                                    <span class="form-label admin-filter-spacer" aria-hidden="true">&nbsp;</span>
                                    <button type="submit" class="btn admin-panel-btn-primary">Filtrar</button>
                                </div>
                            </div>
                            <p class="admin-panel-field-help admin-filter-note" id="fechaHastaAyuda">La fecha hasta incluye todo ese día. Si deja la fecha desde vacía, se muestran los 7 días anteriores a la fecha hasta.</p>
                        </form>
                    </div>

                    <div class="tab-pane fade @(pestanaActiva == "usuario" ? "show active" : "")" id="form-usuario-pane" role="tabpanel" aria-labelledby="tab-usuario" tabindex="0">
                        <form action="@Url.Action("VerBitacoraAccesoUsuario", "Usuario")" method="get" data-requiere-usuario="idUsuario">
                            <div class="admin-filter-row admin-filter-row--usuario">
                                <div class="create-category-field mb-0">
                                    <label for="idUsuario" class="form-label">ID de usuario</label>
                                    <input type="text" id="idUsuario" name="idUsuario" class="form-control" placeholder="Correo completo, ej. ana.solis@ucr.ac.cr" value="@(pestanaActiva == "usuario" ? filtroUsuario : "")" aria-describedby="idUsuarioError">
                                    <span class="text-danger" id="idUsuarioError" aria-live="polite"></span>
                                </div>
                                <div class="create-category-field mb-0">
                                    <label for="diasAtras" class="form-label">Días atrás</label>
                                    <input type="number" id="diasAtras" name="diasAtras" value="@filtroDiasAtras" class="form-control">
                                </div>
                                <div class="create-category-field mb-0 admin-filter-action">
                                    <span class="form-label admin-filter-spacer" aria-hidden="true">&nbsp;</span>
                                    <button type="submit" class="btn admin-panel-btn-primary">Ver historial</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade @(pestanaActiva == "ultimo" ? "show active" : "")" id="form-ultimo-acceso-pane" role="tabpanel" aria-labelledby="tab-ultimo-acceso" tabindex="0">
                        <form action="@Url.Action("VerBitacoraUltimoAccesoUsuario", "Usuario")" method="get" data-requiere-usuario="idUsuarioUltimo">
                            <div class="admin-filter-row admin-filter-row--ultimo">
                                <div class="create-category-field mb-0">
                                    <label for="idUsuarioUltimo" class="form-label">ID de usuario</label>
                                    <input type="text" id="idUsuarioUltimo" name="idUsuario" class="form-control" placeholder="Correo completo, ej. ana.solis@ucr.ac.cr" value="@(pestanaActiva == "ultimo" ? filtroUsuario : "")" aria-describedby="idUsuarioUltimoError">
                                    <span class="text-danger" id="idUsuarioUltimoError" aria-live="polite"></span>
                                </div>
                                <div class="create-category-field mb-0 admin-filter-action">
                                    <span class="form-label admin-filter-spacer" aria-hidden="true">&nbsp;</span>
                                    <button type="submit" class="btn admin-panel-btn-primary">Ver último acceso</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @if (ViewBag.BitacoraAccesos != null)
            {
                <div class="table-card admin-panel-table-card">
                    <div class="table-card-header">
                        <div class="table-card-heading">
                            <span class="table-card-title">Registro de accesos</span>
                            <span class="table-card-desc">@descripcionFiltro</span>
                        </div>
                    </div>

                    @if (filasBitacora.Count == 0)
                    {
                        <p class="admin-panel-empty">No se encontraron registros de bitácora de accesos para este filtro.</p>
                    }
                    else
                    {
                        <div class="table-scroll table-scroll--fit">
                            <table id="bitacoraTblCustomers" class="data-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 18%;">ID de acceso</th>
                                        <th scope="col" style="width: 38%;">ID de usuario</th>
                                        <th scope="col" style="width: 26%;">Fecha y hora (Costa Rica)</th>
                                        <th scope="col" style="width: 18%;">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var acceso in filasBitacora)
                                    {
                                        string estadoTexto = acceso.EstadoAcceso == "EXITO" ? "Éxito"
                                            : acceso.EstadoAcceso == "FRACASO" ? "Fallido"
                                            : acceso.EstadoAcceso;
                                        <tr>
                                            <td>@acceso.IdAccesoPK</td>
                                            <td>@acceso.IdUsuario</td>
                                            <td>@acceso.FechaHoraAcceso.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>
                                                <span class="badge rounded-pill @(acceso.EstadoAcceso == "EXITO" ? "text-bg-success" : "text-bg-danger")">
                                                    @estadoTexto
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <nav id="pagination" class="table-pagination" aria-label="Paginación de bitácora"></nav>
                    }
                </div>

                @* Paginación existente (sin cambios); jQuery ya se carga una sola vez en el layout. *@
            <script>
                $(document).ready(function () {
                    const rowsPerPage = 50;
                    const $table = $('#bitacoraTblCustomers tbody');
                    const $rows = $table.find('tr');
                    const totalRows = $rows.length;
                    const totalPages = Math.ceil(totalRows / rowsPerPage);
                    let currentPage = 1;

                    function showPage(page) {
                        $rows.hide();
                        $rows.slice((page - 1) * rowsPerPage, page * rowsPerPage).show();
                        currentPage = page;
                        updatePagination();
                    }

                    function generatePaginationNumbers(current, total) {
                        const maxVisible = 5;
                        let pages = [];

                        if (total <= maxVisible) {
                            // Si la cantidad total de páginas es menor a maxVisible, mostrar todas
                            for (let i = 1; i <= total; i++) {
                                pages.push(i);
                            }
                        } else {
                            // Siempre se muestra pag 1
                            pages.push(1);

                            if (current <= 3) {
                                pages.push(2, 3, '...', total);
                            } else if (current >= total - 2) {
                                pages.push('...', total - 2, total - 1, total);
                            } else {
                                pages.push('...', current, '...', total);
                            }
                        }

                        return pages;
                    }

                    function updatePagination() {
                        const pages = generatePaginationNumbers(currentPage, totalPages);

                        let paginationHtml = '<a class="page-btn" href="#" id="prev">«</a>';

                        pages.forEach(page => {
                            if (page === '...') {
                                paginationHtml += '<span class="page-btn disabled">...</span>';
                            } else {
                                if (page === currentPage) {
                                    paginationHtml += `<span class="page-btn current">${page}</span>`;
                                } else {
                                    paginationHtml += `<a class="page-btn" href="#" data-page="${page}">${page}</a>`;
                                }
                            }
                        });

                        paginationHtml += '<a class="page-btn" href="#" id="next">»</a>';
                        $('#pagination').html(paginationHtml);

						// Actualizar botones de navegación
                        $('#pagination #prev').toggleClass('disabled', currentPage === 1);
                        $('#pagination #next').toggleClass('disabled', currentPage === totalPages);
                    }

                    // Event handlers
                    $('#pagination').on('click', 'a.page-btn', function (e) {
                        e.preventDefault();

                        if ($(this).attr('id') === 'prev') {
                            if (currentPage > 1) showPage(currentPage - 1);
                        } else if ($(this).attr('id') === 'next') {
                            if (currentPage < totalPages) showPage(currentPage + 1);
                        } else {
                            const page = parseInt($(this).attr('data-page'));
                            if (!isNaN(page)) {
                                showPage(page);
                            }
                        }
                    });

                    // inicializar la 1era pagina
                    showPage(1);
                });
            </script>

            }
            else
            {
                <p class="admin-panel-empty">No se encontraron registros de bitácora de accesos.</p>
            }
        </section>
    </div>

    <script src="~/js/metics-form-controls.js" asp-append-version="true"></script>
    <script>
        // Solo interfaz: evita enviar una consulta por usuario sin ID y muestra el aviso junto al campo.
        // (Enviar "Por usuario" vacío hacía que el servidor devolviera la vista sin sesión y la cerraba.)
        // Mismo calendario y misma lista desplegable que "Crear módulo" (wwwroot/js/metics-form-controls.js).
        (function () {
            var raizFiltros = document.getElementById('myTabContent');
            var desde = document.getElementById('fechaDesde');
            var hasta = document.getElementById('fechaHasta');

            // "Hasta" no puede ser anterior a "desde" (y viceversa): el calendario deshabilita esos días
            // y, si se escribe una fecha fuera de rango, el formulario muestra el aviso junto al campo.
            function sincronizarRango() {
                if (!desde || !hasta) return;
                if (desde.value) hasta.min = desde.value; else hasta.removeAttribute('min');
                if (hasta.value) desde.max = hasta.value; else desde.removeAttribute('max');
            }
            if (desde && hasta) {
                desde.addEventListener('change', sincronizarRango);
                hasta.addEventListener('change', sincronizarRango);
                sincronizarRango();
            }

            if (window.MeticsFormControls && raizFiltros) {
                window.MeticsFormControls.initDatePickers(raizFiltros);
                window.MeticsFormControls.initSelects(raizFiltros);
            }
        })();

        document.querySelectorAll('form[data-requiere-usuario]').forEach(function (formulario) {
            var campo = document.getElementById(formulario.getAttribute('data-requiere-usuario'));
            var aviso = campo ? document.getElementById(campo.id + 'Error') : null;
            if (!campo || !aviso) {
                return;
            }

            function limpiarAviso() {
                campo.classList.remove('is-invalid');
                campo.removeAttribute('aria-invalid');
                aviso.textContent = '';
            }

            campo.addEventListener('input', limpiarAviso);
            formulario.addEventListener('submit', function (evento) {
                if (campo.value.trim() === '') {
                    evento.preventDefault();
                    campo.classList.add('is-invalid');
                    campo.setAttribute('aria-invalid', 'true');
                    aviso.textContent = 'Ingrese el ID del usuario que desea consultar.';
                    campo.focus();
                }
            });
        });
    </script>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}
