@model webMetics.Models.TemaModel
@using webMetics.Controllers
@{
    ViewBag.Title = "Editar área de competencia";
    PageHeadingBuilder.Configure(ViewContext, Url);

}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid required-update-page admin-panel-page category-form-page">
        @using (Html.BeginForm("EditarTema", "Tema", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            @await Html.PartialAsync("_MeticsToast")

            <section class="admin-panel-card required-update-card" aria-labelledby="formularioTitulo">
                <div class="required-update-header">
                    <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-collection"></i></span>
                    <div>
                        <h2 class="required-update-title" id="formularioTitulo">Editar área de competencia</h2>
                        <p class="admin-panel-card-desc">Actualice el nombre del área de competencia.</p>
                    </div>
                </div>
                @Html.HiddenFor(temaModel => temaModel.idTema)

                <div class="form-group create-category-field required-update-field">
                    @Html.LabelFor(temaModel => temaModel.nombre) <span class="required-update-required" aria-hidden="true">*</span>
                    @Html.TextBoxFor(temaModel => temaModel.nombre, new { @class = "form-control", @maxlength = "64" })
                    @Html.ValidationMessageFor(temaModel => temaModel.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="category-form-actions">
                    <a href="#" class="btn admin-panel-btn-secondary" onclick="history.go(-1); return false;">Cancelar</a>
                    <input type="submit" class="btn admin-panel-btn-primary" value="Guardar" />
                </div>
            </section>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}