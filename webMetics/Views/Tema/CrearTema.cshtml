@model webMetics.Models.TemaModel
@using webMetics.Controllers
@{
    ViewBag.Title = "Crear área de competencia";
    PageHeadingBuilder.Configure(ViewContext, Url);

}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid required-update-page admin-panel-page category-form-page">
        @using (Html.BeginForm("CrearTema", "Tema", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            @await Html.PartialAsync("_MeticsToast")

            <section class="admin-panel-card required-update-card" aria-labelledby="formularioTitulo">
                <div class="required-update-header">
                    <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-collection"></i></span>
                    <div>
                        <h2 class="required-update-title" id="formularioTitulo">Crear área de competencia</h2>
                        <p class="admin-panel-card-desc">Revise los datos del área y vuelva a guardarla.</p>
                    </div>
                </div>
                @await Html.PartialAsync("_TemaFormFields", Model ?? new webMetics.Models.TemaModel())

                <div class="category-form-actions">
                    <a href="@Url.Action("ListaGruposDisponibles", "Grupo")" class="btn admin-panel-btn-secondary">Cancelar</a>
                    <input type="submit" class="btn admin-panel-btn-primary" value="Guardar" />
                </div>
            </section>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}
