@model webMetics.Models.TemaModel
@using webMetics.Controllers
@{
    ViewBag.Title = "Áreas de Competencia";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid table-page-with-divider">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />
        @await Html.PartialAsync("_MeticsToast")

        @if (ViewBag.Temas == null)
        {
            <h5 class="text-center mb-4">No hay temas.</h5>
            <div class="text-center">
                <button type="button" class="table-card-action bi bi-plus-lg" data-bs-toggle="modal" data-bs-target="#modalCrearTema">Crear área</button>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-card-header">
                    <div class="table-card-heading">
                        <span class="table-card-title">Áreas de Competencia</span>
                        <span class="table-card-desc">Listado de áreas de competencia registradas en el sistema</span>
                    </div>
                    <div class="table-card-header-actions">
                        <span class="table-card-count">@ViewBag.Temas.Count áreas encontradas</span>
                        <button type="button" class="table-card-action bi bi-plus-lg" data-bs-toggle="modal" data-bs-target="#modalCrearTema">Crear área</button>
                    </div>
                </div>

                <div class="table-toolbar">
                    <div class="table-toolbar-group">
                        <div class="table-search">
                            <div class="table-search-field">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" id="temaBusqueda" class="form-control" placeholder="Buscar área de competencia" aria-label="Buscar área de competencia" />
                            </div>
                        </div>

                        <div class="table-pagesize">
                            <label for="temaPageSize">Mostrar</label>
                            <select id="temaPageSize">
                                <option>5</option>
                                <option>10</option>
                                <option>25</option>
                                <option selected>50</option>
                            </select>
                            <label for="temaPageSize">registros</label>
                        </div>
                    </div>
                </div>

                <div class="table-scroll">
                    <table id="temaTblCustomers" class="data-table" style="min-width: 600px;">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 85%;">Nombre</th>
                                <th scope="col" class="text-center" style="width: 7.5%;">Editar</th>
                                <th scope="col" class="text-center" style="width: 7.5%;">Eliminar</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var tema in ViewBag.Temas)
                            {
                                <tr>
                                    <td>@tema.nombre</td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="icon-action icon-edit bi bi-pencil-square"
                                                title="Editar"
                                                aria-label="Editar @tema.nombre"
                                                data-topic-id="@tema.idTema"
                                                data-topic-name="@tema.nombre"
                                                onclick="abrirModalEditarTema(this)"></button>
                                    </td>
                                    <td class="text-center">
                                        <a href="#" onclick="actualizarModalEliminar('@tema.idTema'); return false;" class="icon-action icon-delete bi bi-trash" title="Eliminar"></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="temaTblPaginacion" class="table-pagination"></div>
            </div>
        }
    </div>

    <div class="modal fade create-category-modal create-topic-modal" id="modalCrearTema" tabindex="-1" aria-labelledby="modalCrearTemaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("CrearTema", "Tema", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inline-required-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnToList" value="true" />
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-collection"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalCrearTemaLabel">Crear área de competencia</h2>
                            <p>Completa el nombre para registrar una nueva área.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body">
                        @await Html.PartialAsync("_TemaFormFields", ViewBag.OpenEditTemaModal == true ? new webMetics.Models.TemaModel() : (Model ?? new webMetics.Models.TemaModel()))
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary create-category-save">Guardar área</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal create-topic-modal category-delete-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                    @using (Html.BeginForm("EliminarTema", "Tema"))
                    {
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-trash3"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEliminarLabel">Eliminar área</h2>
                            <p>Confirma si deseas quitar esta área de competencia del sistema.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Estás seguro de que deseas eliminar esta área de competencia? Esta acción no se puede deshacer.
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="idTema" name="idTema">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn category-delete-confirm">Eliminar área</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal create-topic-modal" id="modalEditarTema" tabindex="-1" aria-labelledby="modalEditarTemaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("EditarTema", "Tema", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inline-required-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idTema" id="editarTemaId" value="@(Model?.idTema ?? 0)" />
                    <input type="hidden" name="returnToList" value="true" />
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEditarTemaLabel">Editar área de competencia</h2>
                            <p>Actualiza el nombre de esta área.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body">
                        <div class="form-group create-category-field">
                            @Html.Label("nombre", "Nombre", new { @for = "editarTemaNombre" })
                            <span class="create-category-required" aria-hidden="true">*</span>
                            @Html.TextBox("nombre", Model?.nombre, new { @class = "form-control", id = "editarTemaNombre", maxlength = "64", autocomplete = "off", required = "required" })
                            @Html.ValidationMessage("nombre", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary create-category-save">Guardar cambios</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script type="text/javascript">
    function clearTemaModalFeedback(modalId) {
        var modal = document.getElementById(modalId);
        if (!modal) return;

        modal.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(function (field) {
            if (field.tagName === 'SELECT') field.selectedIndex = 0;
            else field.value = '';
            field.classList.remove('input-validation-error');
        });
        modal.querySelectorAll('[data-valmsg-for]').forEach(function (message) {
            message.textContent = '';
            message.classList.remove('field-validation-error');
            message.classList.add('field-validation-valid');
        });
    }

    function actualizarModalEliminar(idTema) {
        document.getElementById("idTema").value = idTema;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEliminar')).show();
    }

    function abrirModalEditarTema(button) {
        document.getElementById('editarTemaId').value = button.dataset.topicId || '';
        document.getElementById('editarTemaNombre').value = button.dataset.topicName || '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEditarTema')).show();
    }

    @if (ViewBag.OpenCreateTemaModal == true)
    {
        <text>
            document.addEventListener('DOMContentLoaded', function () {
                var createModalElement = document.getElementById('modalCrearTema');
                if (createModalElement) {
                    clearTemaModalFeedback('modalEditarTema');
                    bootstrap.Modal.getOrCreateInstance(createModalElement).show();
                }
            });
        </text>
    }

    @if (ViewBag.OpenEditTemaModal == true)
    {
        <text>
            document.addEventListener('DOMContentLoaded', function () {
                var editModalElement = document.getElementById('modalEditarTema');
                if (editModalElement) {
                    clearTemaModalFeedback('modalCrearTema');
                    bootstrap.Modal.getOrCreateInstance(editModalElement).show();
                }
            });
        </text>
    }

    MeticsTable.init({
        tableId: 'temaTblCustomers',
        pageSizeId: 'temaPageSize',
        paginationId: 'temaTblPaginacion',
        searching: true,
        searchInputId: 'temaBusqueda',
        pageLength: 50
    });
</script>
