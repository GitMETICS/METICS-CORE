@using webMetics.Models
@using webMetics.Helpers


<!--
    Vista para mostrar la lista de los modulos de un asesor
-->
@{
    ViewBag.Title = "Mis módulos";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@if (!string.IsNullOrEmpty(ViewBag.Id))
{
    <div class="contenedor-caja container-fluid module-catalog-page module-facilitator-page">
        @await Html.PartialAsync("_MeticsToast")

        @if (ViewBag.Role == 2)
        {
            <!-- Grupos Creados por Asesor -->
            <h1 metics-page-heading>@ViewBag.Title</h1>
            string terminoBusqueda = Context.Request.Query["searchTerm"].ToString();

            <section class="module-catalog-toolbar module-catalog-toolbar--facilitator" aria-label="Buscar y cambiar la vista de mis módulos">
                <div class="module-toolbar-controls">
                    <form asp-action="BuscarGrupos" asp-controller="Asesor" method="get" class="module-search-form" role="search">
                        <div class="module-search-control">
                            <button class="module-search-submit" type="submit" aria-label="Buscar módulos">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </button>
                            <input type="text" name="searchTerm" class="form-control module-search-input" placeholder="Buscar módulo" aria-label="Buscar módulo" value="@terminoBusqueda" />
                        </div>
                    </form>

                    <!-- Botón para cambiar entre vista de lista y de cuadrícula -->
                    <button class="btn btn-secondary module-view-toggle" type="button" id="toggleViewBtn2" onclick="toggleView()"><i class="bi bi-list-ul me-2" aria-hidden="true"></i>Modo lista</button>
                </div>
            </section>

            @if (ViewBag.ListaGrupos != null && ViewBag.ListaGrupos.Count > 0)
            {
                <div class="view-container" id="viewContainer">
                    @* Misma tarjeta en las dos vistas; el modo lista solo cambia la distribución (estilos compartidos con el catálogo). *@
                    @foreach (var vista in new[] { new[] { "gridView", "col-12 col-md-6" }, new[] { "listView", "col-12" } })
                    {
                        <div class="row d-none" id="@vista[0]">
                            @foreach (var grupo in ViewBag.ListaGrupos)
                            {
                                <div class="@vista[1] mb-4 module-card-item">
                                    <div id="@(vista[0] == "gridView" ? Convert.ToString(grupo.idGrupo) : "lista-" + grupo.idGrupo)" class="card h-100 text-center mb-1">
                                        <div class="card-header">
                                            <div>
                                                <div style="float:left">
                                                    @if (grupo.cupoActual < grupo.cupo)
                                                    {
                                                        <span class="badge bg-info">Cupo: @(grupo.cupo - grupo.cupoActual)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Sin cupo</span>
                                                    }
                                                    @if (ViewBag.DateNow > grupo.fechaFinalizacionInscripcion)
                                                    {
                                                        <span class="badge bg-danger">Inscripción fuera de plazo</span>
                                                    }
                                                    <span class="badge bg-info">Inscripciones: @(grupo.cupoActual)</span>
                                                </div>
                                                <div style="float:right">
                                                    <button type="button" class="module-admin-action" data-bs-toggle="modal" data-bs-target="#modalEditar" onclick="actualizarModalEditar(@grupo.idGrupo)" aria-label="Editar módulo @grupo.nombre" title="Editar módulo"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
                                                    @if (ViewBag.Role == 1)
                                                    {
                                                        <button type="button" class="module-admin-action" data-bs-toggle="modal" data-bs-target="#modalEliminar" onclick="actualizarModalEliminar(@grupo.idGrupo)" aria-label="Eliminar módulo @grupo.nombre" title="Eliminar módulo"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                                        if (grupo.esVisible == true)
                                                        {
                                                            <a href="@Url.Action("CambiarEstadoVisible", "Grupo", new { idGrupo = grupo.idGrupo })" class="module-admin-action" aria-label="Ocultar módulo @grupo.nombre" title="Ocultar módulo"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                                        }
                                                        else
                                                        {
                                                            <a href="@Url.Action("CambiarEstadoVisible", "Grupo", new { idGrupo = grupo.idGrupo })" class="module-admin-action module-admin-action-hidden" aria-label="Mostrar módulo @grupo.nombre" title="Mostrar módulo"><i class="bi bi-eye-slash" aria-hidden="true"></i></a>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-body module-card-body">
                                            <div class="module-card-heading"><h4>@grupo.nombre</h4></div>
                                            <div class="module-card-dates">
                                                <div><i class="bi bi-calendar-event" aria-hidden="true"></i><span><small>Fecha de inicio</small><time>@grupo.fechaInicioGrupo.ToString("dd/MM/yyyy")</time></span></div>
                                                <div><i class="bi bi-calendar-check" aria-hidden="true"></i><span><small>Fin del módulo</small><time>@grupo.fechaFinalizacionGrupo.ToString("dd/MM/yyyy")</time></span></div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(grupo.descripcion))
                                            {
                                                <div class="card-text module-card-description" style="line-height: 1.6; font-size: 1rem; padding: 10px;">
                                                    @grupo.descripcion.Substring(0, Math.Min(250, grupo.descripcion.Length))
                                                    @if (grupo.descripcion.Length > 250)
                                                    {
                                                        <span class="dots">...</span>
                                                        <span class="more" style="display:none;">@grupo.descripcion.Substring(250)</span>
                                                        <button class="btn btn-link p-0 see-more-btn" style="color: var(--metics-interactive-blue); font-weight: bold;" onclick="toggleSeeMore(this)">Ver más</button>
                                                    }
                                                </div>
                                            }
                                            <div class="module-card-details">
                                                <div class="module-card-detail">
                                                    <span class="module-card-detail-label"><i class="bi bi-people" aria-hidden="true"></i>Número de grupo</span>
                                                    <span class="module-card-detail-value">@grupo.numeroGrupo</span>
                                                </div>
                                                <div class="module-card-detail">
                                                    <span class="module-card-detail-label"><i class="bi bi-clock" aria-hidden="true"></i>Cantidad de horas</span>
                                                    <span class="module-card-detail-value">@grupo.cantidadHoras</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(grupo.nombreAsesor))
                                                {
                                                    <div class="module-card-detail module-card-detail-wide">
                                                        <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador(a)</span>
                                                        <span class="module-card-detail-value">@grupo.nombreAsesor</span>
                                                    </div>
                                                }
                                                else if (grupo.modalidad == "Autogestionado")
                                                {
                                                    <div class="module-card-detail module-card-detail-wide">
                                                        <span class="module-card-detail-label"><i class="bi bi-person-badge" aria-hidden="true"></i>Facilitador</span>
                                                        <span class="module-card-detail-value">Equipo del Área de Asesoría Docente de la Unidad METICS</span>
                                                    </div>
                                                }
                                                <div class="module-card-detail module-card-detail-wide">
                                                    <span class="module-card-detail-label"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Área(s) de competencia</span>
                                                    <span class="module-card-detail-value">
                                                        @if (grupo.TemasSeleccionadosNombres != null)
                                                        {
                                                            @String.Join(", ", grupo.TemasSeleccionadosNombres)
                                                        }
                                                        else
                                                        {
                                                            <span>No hay temas asociados.</span>
                                                        }
                                                    </span>
                                                </div>
                                                <div class="module-card-detail module-card-detail-wide">
                                                    <span class="module-card-detail-label"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i>Nivel</span>
                                                    <span class="module-card-detail-value">@grupo.nombreCategoria</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(grupo.enlace))
                                                {
                                                    <div class="module-card-detail module-card-detail-wide module-card-detail-mv">
                                                        <span class="module-card-detail-label"><span class="module-card-mv-logo" aria-hidden="true"><img src="~/images/images-removebg-preview.png" alt="" /></span>Mediación Virtual</span>
                                                        <span class="module-card-detail-value">
                                                            <a class="module-card-mv-link" href="@grupo.enlace" target="_blank" rel="noopener noreferrer">Abrir enlace<span class="visually-hidden"> de Mediación Virtual (se abre en otra pestaña)</span> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                                        </span>
                                                    </div>
                                                }
                                            </div>

                                            <div class="module-card-actions">
                                                <div>
                                                    <a class="btn admin-panel-btn-secondary module-enroll-btn" href="#" role="button" data-bs-toggle="modal" data-bs-target="#modalInscribirParticipante" data-id-grupo="@grupo.idGrupo" data-nombre-grupo="@grupo.nombre (Grupo @grupo.numeroGrupo)"><i class="bi bi-person-plus" aria-hidden="true"></i> Inscribir participante</a>
                                                </div>
                                                <div>
                                                    <a class="btn admin-panel-btn-primary module-enroll-btn" href="@Url.Action("ListaParticipantes", "Participante", new { idGrupo = grupo.idGrupo })"><i class="bi bi-people" aria-hidden="true"></i> Ver participantes</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer text-muted bg-primary bg-opacity-25 border-primary border-1 border-opacity-25">
                                            <span class="module-card-location"><i class="bi bi-geo-alt" aria-hidden="true"></i>
                                            @if (string.Equals(grupo.modalidad, "Presencial", StringComparison.OrdinalIgnoreCase))
                                            {
                                                @grupo.lugar
                                            }
                                            else
                                            {
                                                @EnumHelper.GetDisplayName(grupo.modalidad)
                                            }
                                            </span>
                                            <span class="module-card-schedule"><i class="bi bi-clock" aria-hidden="true"></i>@grupo.horario</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="admin-panel-card module-facilitator-empty">
                    <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-journal-plus"></i></span>
                    @if (!string.IsNullOrWhiteSpace(terminoBusqueda))
                    {
                        <h2>No hay módulos que coincidan con “@terminoBusqueda”.</h2>
                        <p>Pruebe con otro nombre o borre la búsqueda para ver todos sus módulos.</p>
                        <a class="btn admin-panel-btn-secondary" href="@Url.Action("MisModulos", "Asesor")">Ver todos mis módulos</a>
                    }
                    else
                    {
                        <h2>No tiene módulos creados.</h2>
                        <p>Cuando cree un módulo o se le asigne uno, aparecerá aquí.</p>
                        <a class="btn admin-panel-btn-primary" href="@Url.Action("CrearGrupo", "Grupo")"><i class="bi bi-plus-lg" aria-hidden="true"></i> Crear un módulo</a>
                    }
                </div>
            }
        }
    </div>


    @* Pop ups con el estilo del proyecto: encabezado con ícono, mensaje y acciones con la principal a la derecha. *@
    <div class="modal fade create-category-modal category-delete-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("EliminarGrupo", "Grupo"))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-trash3"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEliminarLabel">Eliminar módulo</h2>
                            <p>Confirme si desea quitar este módulo del sistema.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Está seguro de que desea eliminar este módulo? Esta acción no se puede deshacer.
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="valueGrupoEliminar" name="idGrupo">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn category-delete-confirm">Eliminar módulo</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("EditarGrupo", "Grupo", FormMethod.Get, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEditarLabel">Editar módulo</h2>
                            <p>Abrirá el formulario con los datos actuales del módulo.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Está seguro de que desea editar los datos del módulo?
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="valueGrupoEditar" name="idGrupo">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn create-category-save">Editar módulo</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal category-delete-modal" id="modalDesinscribir" tabindex="-1" aria-labelledby="modalDesinscribirLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("DesinscribirParticipante", "Inscripcion", FormMethod.Get, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-person-dash"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalDesinscribirLabel">Desinscribirse del módulo</h2>
                            <p>Dejará de estar inscrito(a) en este módulo.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Está seguro de que desea desinscribirse de este módulo?
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="valueGrupoDesinscribir" name="idGrupo">
                        <input type="hidden" name="idParticipante" value="@ViewBag.IdParticipante">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn category-delete-confirm">Desinscribirse</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Inscripción manual en pop up: envía el mismo formulario que la página "Inscripción" (FormularioInscripcionManual). *@
    <div class="modal fade create-category-modal" id="modalInscribirParticipante" tabindex="-1" aria-labelledby="modalInscribirParticipanteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("FormularioInscripcionManual", "Inscripcion", FormMethod.Post, new { enctype = "multipart/form-data", novalidate = "novalidate", id = "formInscribirParticipante" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalInscribirParticipanteLabel">Inscribir participante</h2>
                            <p id="modalInscribirParticipanteModulo">Módulo</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body">
                        <div class="create-category-field mb-0">
                            <label for="inscribirIdParticipante">Correo institucional <span class="create-category-required" aria-hidden="true">*</span></label>
                            <input type="email" id="inscribirIdParticipante" name="idParticipante" class="form-control" maxlength="64" autocomplete="off" placeholder="ej. ana.solis@ucr.ac.cr" required aria-describedby="inscribirIdParticipanteAyuda inscribirIdParticipanteError" />
                            <span class="admin-panel-field-help" id="inscribirIdParticipanteAyuda">Debe corresponder a un participante registrado en METICS.</span>
                            <span class="text-danger" id="inscribirIdParticipanteError" aria-live="polite"></span>
                        </div>
                        <input type="hidden" id="inscribirIdGrupo" name="idGrupo" value="" />
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn create-category-save">Inscribir</button>
                    </div>
                }
            </div>
        </div>
    </div>
    <script>
        (function () {
            var modal = document.getElementById('modalInscribirParticipante');
            var formulario = document.getElementById('formInscribirParticipante');
            if (!modal || !formulario) return;
            var correo = document.getElementById('inscribirIdParticipante');
            var aviso = document.getElementById('inscribirIdParticipanteError');

            function limpiar() { correo.classList.remove('is-invalid'); correo.removeAttribute('aria-invalid'); aviso.textContent = ''; }

            modal.addEventListener('show.bs.modal', function (evento) {
                var origen = evento.relatedTarget;
                if (!origen) return;
                document.getElementById('inscribirIdGrupo').value = origen.getAttribute('data-id-grupo') || '';
                document.getElementById('modalInscribirParticipanteModulo').textContent = origen.getAttribute('data-nombre-grupo') || '';
                correo.value = '';
                limpiar();
            });
            modal.addEventListener('shown.bs.modal', function () { correo.focus(); });
            correo.addEventListener('input', limpiar);
            formulario.addEventListener('submit', function (evento) {
                var valor = correo.value.trim();
                correo.value = valor;
                var mensaje = !valor ? 'Ingrese el correo institucional del participante.'
                    : !/^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/.test(valor) ? 'Ingrese un correo válido.' : '';
                if (mensaje) {
                    evento.preventDefault();
                    correo.classList.add('is-invalid');
                    correo.setAttribute('aria-invalid', 'true');
                    aviso.textContent = mensaje;
                    correo.focus();
                }
            });
        })();
    </script>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script type="text/javascript">
    function actualizarModalEditar(idGrupo) {
        document.getElementById("valueGrupoEditar").value = idGrupo;
    }
    function actualizarModalEliminar(idGrupo) {
        document.getElementById("valueGrupoEliminar").value = idGrupo;
    }
    function actualizarModalEditarAdjunto(idGrupo) {
        document.getElementById("valueGrupoAdjunto").value = idGrupo;
    }
    function actualizarModalDesinscribir(idGrupo) {
        document.getElementById("valueGrupoDesinscribir").value = idGrupo;
    }
</script>



<style>
    .more {
        display: none;
        transition: all 0.5s ease-in-out;
    }

    .see-more-btn {
        border: none;
        background: none;
        cursor: pointer;
    }

    .list-group-item {
        border: 1px solid var(--metics-border-card);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 0.5rem;
    }
    .grid-view .col {
        display: block;
        width: 100%;
    }

    .list-view .col {
        display: block; 
        width: 100%; 
        margin-bottom: var(--metics-space-2-5); 
    }

    .list-view .card {
        display: flex; 
        flex-direction: column; 
        padding: var(--metics-space-3-5); 
        width: 100%; 
    }

    .list-view .card-body .description {
        display: none; 
    }

    .list-view .card-footer {
        text-align: right; 
    }

    .view-container {
        transition: all 0.3s ease-in-out; 
    }
</style>


<script> 
    function toggleSeeMore(btn) {
        var dots = btn.previousElementSibling.previousElementSibling;
        var moreText = btn.previousElementSibling; 

        if (dots.style.display === "none") {
            dots.style.display = "inline";
            btn.innerHTML = "Ver más";
            moreText.style.display = "none";
        } else {
            dots.style.display = "none";
            btn.innerHTML = "Ver menos";
            moreText.style.display = "inline";
        }
    }
</script>

<script>
    function toggleSeeMoreInfo(button) {
        const moreInfoDiv = button.nextElementSibling; 
        if (moreInfoDiv.style.display === "none") {
            moreInfoDiv.style.display = "block"; 
            button.innerText = "Ocultar detalles"; 
        } else {
            moreInfoDiv.style.display = "none"; 
            button.innerText = "Ver detalles"; 
        }
    }
</script>

<script>
    window.onload = function () {
        const savedViewMode = localStorage.getItem('viewMode'); 
        const gridView0 = document.getElementById("gridView0");
        const gridView = document.getElementById("gridView");
        const listView0 = document.getElementById("listView0");
        const listView = document.getElementById("listView");
        const toggleViewBtn1 = document.getElementById("toggleViewBtn1");
        const toggleViewBtn2 = document.getElementById("toggleViewBtn2");

        if (savedViewMode === 'list') {
            isListView = true;
            if (gridView0) gridView0.classList.add("d-none");
            if (gridView) gridView.classList.add("d-none");  
            if (listView0) listView0.classList.remove("d-none");
            if (listView) listView.classList.remove("d-none");  
            if (toggleViewBtn1) toggleViewBtn1.innerHTML = "<i class='bi bi-grid me-2'></i>Modo cuadrícula";
            if (toggleViewBtn2) toggleViewBtn2.innerHTML = "<i class='bi bi-grid me-2'></i>Modo cuadrícula";
        } else {
            isListView = false;
            if (gridView) gridView.classList.remove("d-none");  
            if (gridView0) gridView0.classList.remove("d-none");
            if (listView0) listView0.classList.add("d-none");
            if (listView) listView.classList.add("d-none");  
            if (toggleViewBtn1) toggleViewBtn1.innerHTML = "<i class='bi bi-list-ul me-2'></i>Modo lista";
            if (toggleViewBtn2) toggleViewBtn2.innerHTML = "<i class='bi bi-list-ul me-2'></i>Modo lista";
        }
    };

    function toggleView() {
        isListView = !isListView;
        const gridView = document.getElementById("gridView");
        const gridView0 = document.getElementById("gridView0");
        const listView0 = document.getElementById("listView0");
        const listView = document.getElementById("listView");
        const toggleViewBtn1 = document.getElementById("toggleViewBtn");
        const toggleViewBtn2 = document.getElementById("toggleViewBtn2");

        if (isListView) {
            if (gridView) gridView.classList.add("d-none");
            if (gridView0) gridView0.classList.add("d-none");
            if (listView0) listView0.classList.remove("d-none");
            if (listView) listView.classList.remove("d-none");  
            if (toggleViewBtn1) toggleViewBtn1.innerHTML = "<i class='bi bi-grid me-2'></i>Modo cuadrícula";
            if (toggleViewBtn2) toggleViewBtn2.innerHTML = "<i class='bi bi-grid me-2'></i>Modo cuadrícula";
            localStorage.setItem('viewMode', 'list');  
        } else {
            if (gridView) gridView.classList.remove("d-none");
            if (gridView0) gridView0.classList.remove("d-none");
            if (listView0) listView0.classList.add("d-none");
            if (listView) listView.classList.add("d-none");  
            if (toggleViewBtn1) toggleViewBtn1.innerHTML = "<i class='bi bi-list-ul me-2'></i>Modo lista";
            if (toggleViewBtn2) toggleViewBtn2.innerHTML = "<i class='bi bi-list-ul me-2'></i>Modo lista";
            localStorage.setItem('viewMode', 'grid');  
        }
    }
</script>
