<script type="text/javascript">
    (function () {
        function initializeAsesorIdentificationSelects() {
            var selects = Array.prototype.slice.call(document.querySelectorAll(
                '#crearAsesorTipoIdentificacion, #editarAsesorTipoIdentificacion'
            ));
            var instances = [];

            function closeOthers(except) {
                instances.forEach(function (instance) { if (instance !== except) instance.close(false); });
            }

            selects.forEach(function (select) {
                if (select.dataset.customSelectReady === 'true') return;

                var wrapper = document.createElement('div');
                wrapper.className = 'create-group-custom-select';
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);
                select.classList.add('create-group-native-select');
                select.setAttribute('aria-hidden', 'true');
                select.setAttribute('tabindex', '-1');
                select.dataset.customSelectReady = 'true';

                var trigger = document.createElement('button');
                trigger.type = 'button';
                trigger.id = select.id + 'CustomTrigger';
                trigger.className = 'create-group-select-trigger';
                trigger.setAttribute('role', 'combobox');
                trigger.setAttribute('aria-haspopup', 'listbox');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.setAttribute('aria-controls', select.id + 'CustomListbox');

                var selectedText = document.createElement('span');
                selectedText.className = 'create-group-select-value';
                var arrow = document.createElement('span');
                arrow.className = 'create-group-select-arrow';
                arrow.setAttribute('aria-hidden', 'true');
                trigger.appendChild(selectedText);
                trigger.appendChild(arrow);

                var panel = document.createElement('div');
                panel.id = select.id + 'CustomListbox';
                panel.className = 'create-group-select-panel';
                panel.setAttribute('role', 'listbox');
                panel.hidden = true;

                var field = select.closest('.form-group');
                var label = field ? field.querySelector('label') : null;
                var message = field ? field.querySelector('[data-valmsg-for="' + select.name + '"]') : null;
                var identificationInput = select.form
                    ? select.form.querySelector('input[name="numeroIdentificacion"]')
                    : null;
                if (label) {
                    label.htmlFor = select.id;
                    label.id = label.id || select.id + 'CustomLabel';
                    trigger.setAttribute('aria-labelledby', label.id);
                    label.addEventListener('click', function (event) {
                        event.preventDefault();
                        trigger.focus();
                        toggle();
                    });
                }
                if (message) {
                    message.id = message.id || select.id + 'CustomValidation';
                    trigger.setAttribute('aria-describedby', message.id);
                }

                wrapper.appendChild(trigger);
                wrapper.appendChild(panel);

                var rows = [];
                var activeIndex = -1;
                var isOpen = false;
                var typeAhead = '';
                var typeAheadTimer;

                function updateIdentificationExample() {
                    if (!identificationInput) return;
                    var selectedOption = select.options[select.selectedIndex];
                    var selectedType = selectedOption ? selectedOption.text.trim().toLocaleLowerCase() : '';
                    if (selectedType === 'cédula' || selectedType === 'cedula') {
                        identificationInput.placeholder = 'Ej. 1-1100-1100';
                    } else if (selectedType === 'residente') {
                        identificationInput.placeholder = 'Ej. 123456789012 (DIMEX)';
                    } else if (selectedType === 'pasaporte') {
                        identificationInput.placeholder = 'Ej. A12345678';
                    } else {
                        identificationInput.placeholder = 'Seleccione el tipo de identificación...';
                    }
                }

                function renderOptions() {
                    panel.replaceChildren();
                    rows = [];
                    Array.prototype.forEach.call(select.options, function (option, index) {
                        var row = document.createElement('div');
                        row.id = panel.id + 'Option' + index;
                        row.className = 'create-group-select-option';
                        row.setAttribute('role', 'option');
                        row.setAttribute('aria-selected', option.selected ? 'true' : 'false');
                        row.setAttribute('aria-disabled', option.disabled ? 'true' : 'false');
                        row.dataset.optionIndex = String(index);
                        row.textContent = option.text;
                        if (option.selected) row.classList.add('is-selected');
                        row.addEventListener('mouseenter', function () { if (!option.disabled) setActive(index); });
                        row.addEventListener('mousedown', function (event) { event.preventDefault(); });
                        row.addEventListener('click', function () { if (!option.disabled) choose(index); });
                        panel.appendChild(row);
                        rows.push(row);
                    });
                }

                function syncFromNative() {
                    renderOptions();
                    var option = select.options[select.selectedIndex];
                    selectedText.textContent = option ? option.text : '';
                    updateIdentificationExample();
                    rows.forEach(function (row, index) {
                        var selected = index === select.selectedIndex;
                        row.classList.toggle('is-selected', selected);
                        row.setAttribute('aria-selected', selected ? 'true' : 'false');
                    });
                    trigger.disabled = select.disabled;
                    trigger.setAttribute('aria-disabled', select.disabled ? 'true' : 'false');
                    var hasError = message && message.classList.contains('field-validation-error') && message.textContent.trim();
                    trigger.classList.toggle('input-validation-error', !!hasError);
                    wrapper.classList.toggle('has-validation-error', !!hasError);
                    trigger.setAttribute('aria-invalid', hasError ? 'true' : 'false');
                    if (select.disabled) close(false);
                }

                function setActive(index) {
                    if (index < 0 || index >= rows.length || select.options[index].disabled) return;
                    activeIndex = index;
                    rows.forEach(function (row, rowIndex) { row.classList.toggle('is-active', rowIndex === activeIndex); });
                    trigger.setAttribute('aria-activedescendant', rows[index].id);
                    rows[index].scrollIntoView({ block: 'nearest' });
                }

                function firstEnabled(start, step) {
                    var index = start;
                    while (index >= 0 && index < select.options.length) {
                        if (!select.options[index].disabled) return index;
                        index += step;
                    }
                    return -1;
                }

                function open() {
                    if (trigger.disabled || isOpen) return;
                    closeOthers(instance);
                    syncFromNative();
                    panel.hidden = false;
                    wrapper.classList.add('is-open');
                    wrapper.setAttribute('aria-expanded', 'true');
                    trigger.setAttribute('aria-expanded', 'true');
                    isOpen = true;
                    var rect = trigger.getBoundingClientRect();
                    var panelHeight = Math.min(panel.scrollHeight, window.innerHeight - 24);
                    var roomBelow = window.innerHeight - rect.bottom;
                    wrapper.classList.toggle('is-open-above', roomBelow < panelHeight + 14 && rect.top > panelHeight + 14);
                    var selected = select.selectedIndex >= 0 && !select.options[select.selectedIndex].disabled
                        ? select.selectedIndex : firstEnabled(0, 1);
                    if (selected >= 0) setActive(selected);
                }

                function close(returnFocus) {
                    if (!isOpen) return;
                    panel.hidden = true;
                    wrapper.classList.remove('is-open', 'is-open-above');
                    wrapper.removeAttribute('aria-expanded');
                    trigger.setAttribute('aria-expanded', 'false');
                    trigger.removeAttribute('aria-activedescendant');
                    isOpen = false;
                    activeIndex = -1;
                    if (returnFocus) trigger.focus();
                }

                function choose(index) {
                    if (index < 0 || index >= select.options.length || select.options[index].disabled) return;
                    if (select.selectedIndex !== index) {
                        select.selectedIndex = index;
                        select.dispatchEvent(new Event('input', { bubbles: true }));
                        select.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    syncFromNative();
                    close(true);
                }

                function toggle() { if (isOpen) close(false); else open(); }

                function searchByTyping(character) {
                    var normalized = character.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                    var repeated = typeAhead && Array.from(typeAhead).every(function (letter) { return letter === normalized; });
                    typeAhead = repeated ? normalized : typeAhead + normalized;
                    window.clearTimeout(typeAheadTimer);
                    typeAheadTimer = window.setTimeout(function () { typeAhead = ''; }, 800);
                    for (var offset = 1; offset <= select.options.length; offset++) {
                        var index = (select.selectedIndex + offset + select.options.length) % select.options.length;
                        var option = select.options[index];
                        var text = option.text.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                        if (!option.disabled && option.value !== '' && text.startsWith(typeAhead)) { choose(index); return; }
                    }
                    if (typeAhead !== normalized) { typeAhead = ''; searchByTyping(character); }
                }

                var instance = { select: select, close: close };
                instances.push(instance);
                select._syncCreateGroupSelect = syncFromNative;
                trigger.addEventListener('click', toggle);
                trigger.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') { if (isOpen) { event.preventDefault(); close(true); } return; }
                    if (event.key === 'Tab') { close(false); return; }
                    if (event.key.length === 1 && event.key.trim() && !event.ctrlKey && !event.altKey && !event.metaKey) {
                        event.preventDefault(); searchByTyping(event.key); return;
                    }
                    if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' '].indexOf(event.key) === -1) return;
                    event.preventDefault();
                    if (!isOpen) {
                        open();
                        if (event.key === 'ArrowDown') setActive(firstEnabled(select.selectedIndex + 1, 1));
                        if (event.key === 'ArrowUp') setActive(firstEnabled(select.selectedIndex - 1, -1));
                    } else if (event.key === 'ArrowDown') setActive(firstEnabled(activeIndex + 1, 1));
                    else if (event.key === 'ArrowUp') setActive(firstEnabled(activeIndex - 1, -1));
                    else if (event.key === 'Home') setActive(firstEnabled(0, 1));
                    else if (event.key === 'End') setActive(firstEnabled(select.options.length - 1, -1));
                    else if (activeIndex >= 0) choose(activeIndex);
                });
                select.addEventListener('change', syncFromNative);
                var disabledObserver = new MutationObserver(syncFromNative);
                disabledObserver.observe(select, { attributes: true, attributeFilter: ['disabled'] });
                syncFromNative();
            });

            document.addEventListener('pointerdown', function (event) {
                instances.forEach(function (instance) {
                    if (!instance.select.closest('.create-group-custom-select').contains(event.target)) instance.close(false);
                });
            });
            document.addEventListener('focusin', function (event) {
                instances.forEach(function (instance) {
                    if (!instance.select.closest('.create-group-custom-select').contains(event.target)) instance.close(false);
                });
            });
        }

        function syncAsesorSelect(select) {
            if (select && typeof select._syncCreateGroupSelect === 'function') select._syncCreateGroupSelect();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeAsesorIdentificationSelects, { once: true });
        } else {
            initializeAsesorIdentificationSelects();
        }

        // Función para abrir modal de eliminación
        window.syncAsesorSelect = syncAsesorSelect;
    })();

    // Función para abrir modal de eliminación
    function openAsesorDeleteModal(asesorId) {
        document.getElementById("idAsesor").value = asesorId;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEliminar')).show();
    }

    function openAsesorEditModal(button) {
        var fields = {
            editarAsesorId: button.dataset.asesorId,
            editarAsesorNombre: button.dataset.asesorNombre,
            editarAsesorPrimerApellido: button.dataset.asesorPrimerApellido,
            editarAsesorSegundoApellido: button.dataset.asesorSegundoApellido,
            editarAsesorCorreo: button.dataset.asesorCorreo,
            editarAsesorTipoIdentificacion: button.dataset.asesorTipoIdentificacion,
            editarAsesorNumeroIdentificacion: button.dataset.asesorNumeroIdentificacion,
            editarAsesorDescripcion: button.dataset.asesorDescripcion,
            editarAsesorTelefono: button.dataset.asesorTelefono
        };

        Object.keys(fields).forEach(function (id) {
            var input = document.getElementById(id);
            if (input) {
                input.value = fields[id] || '';
                if (input.tagName === 'SELECT') window.syncAsesorSelect(input);
            }
        });

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEditarAsesor')).show();
    }

    function toggleAsesorPassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (!input || !icon) return;

        var showing = input.type === 'password';
        input.type = showing ? 'text' : 'password';
        icon.classList.toggle('bi-eye', !showing);
        icon.classList.toggle('bi-eye-slash', showing);
    }

    function clearAsesorModalFeedback(modalId) {
        var modal = document.getElementById(modalId);
        if (!modal) return;

        modal.querySelectorAll('input:not([type="hidden"]), select, textarea').forEach(function (field) {
            if (field.type === 'checkbox' || field.type === 'radio') {
                field.checked = false;
            } else if (field.tagName === 'SELECT') {
                field.selectedIndex = 0;
                window.syncAsesorSelect(field);
            } else {
                field.value = '';
            }
            field.classList.remove('input-validation-error');
        });

        modal.querySelectorAll('[data-valmsg-for]').forEach(function (message) {
            message.textContent = '';
            message.classList.remove('field-validation-error');
            message.classList.add('field-validation-valid');
        });

        modal.querySelectorAll('select').forEach(function (field) {
            window.syncAsesorSelect(field);
        });
    }

    // Función heredada para mantener compatibilidad
    function actualizarModalEliminar(idAsesor) {
        openAsesorDeleteModal(idAsesor);
    }

    @if (ViewBag.OpenCreateAsesorModal == true)
    {
        <text>
            document.addEventListener('DOMContentLoaded', function () {
                var createModalElement = document.getElementById('modalCrearAsesor');
                if (createModalElement) {
                    clearAsesorModalFeedback('modalEditarAsesor');
                    bootstrap.Modal.getOrCreateInstance(createModalElement).show();
                }
            });
        </text>
    }

    @if (ViewBag.OpenEditAsesorModal == true)
    {
        <text>
            document.addEventListener('DOMContentLoaded', function () {
                var editModalElement = document.getElementById('modalEditarAsesor');
                if (editModalElement) {
                    clearAsesorModalFeedback('modalCrearAsesor');
                    bootstrap.Modal.getOrCreateInstance(editModalElement).show();
                }
            });
        </text>
    }

    MeticsTable.init({
        tableId: 'asesorTblCustomers',
        pageSizeId: 'asesorPageSize',
        paginationId: 'asesorTblPaginacion',
        searching: true,
        searchInputId: 'asesorBusqueda',
        pageLength: 50
    });
</script>
