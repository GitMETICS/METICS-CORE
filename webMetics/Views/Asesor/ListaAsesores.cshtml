@model webMetics.Models.AsesorModel
@using webMetics.Controllers

<!--
    Vista para mostrar la lista de todos los asesores con la información personal de cada uno
    Se muestran las opciones de poder eliminar, editar o crear un asesor
-->

@{
    ViewBag.Title = "Facilitadores(as)";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid table-page-with-divider">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />
        @await Html.PartialAsync("_MeticsToast")

        <div class="table-responsive">
            @if (ViewBag.Asesores == null)
            {
                <h5 class="text-center">No hay facilitadores(as).</h5>
            }
            else
            {
                <div class="table-card">
                    <div class="table-card-header">
                        <div class="table-card-heading">
                            <span class="table-card-title">Facilitadores(as)</span>
                            <span class="table-card-desc">Listado de facilitadores(as) registrados en el sistema</span>
                        </div>
                        <div class="table-card-header-actions">
                            <span class="table-card-count">@ViewBag.Asesores.Count facilitadores encontrados</span>
                            <button type="button" class="table-card-action bi bi-plus-lg" data-bs-toggle="modal" data-bs-target="#modalCrearAsesor">Crear facilitador(a)</button>
                        </div>
                    </div>

                    <div class="table-toolbar">
                        <div class="table-toolbar-group">
                            <div class="table-search">
                                <div class="table-search-field">
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                    <input type="search" id="asesorBusqueda" class="form-control" placeholder="Buscar facilitador(a)" aria-label="Buscar facilitador(a)" />
                                </div>
                            </div>

                            <div class="table-pagesize">
                                <label for="asesorPageSize">Mostrar</label>
                                <select id="asesorPageSize">
                                    <option>5</option>
                                    <option>10</option>
                                    <option>25</option>
                                    <option selected>50</option>
                                </select>
                                <label for="asesorPageSize">registros</label>
                            </div>
                        </div>
                    </div>

                    <div class="table-scroll">
                        <table id="asesorTblCustomers" class="data-table" style="min-width: 900px;">
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 11%;">Nombre</th>
                                    <th scope="col" style="width: 9%;">Primer Apellido</th>
                                    <th scope="col" style="width: 9%;">Segundo Apellido</th>
                                    <th scope="col" style="width: 13%;">Correo Institucional</th>
                                    <th scope="col" style="width: 15%;">Descripción</th>
                                    <th scope="col" style="width: 6%;">Teléfono</th>
                                    <th scope="col" class="text-center" style="width: 4%;">Editar</th>
                                    <th scope="col" class="text-center" style="width: 4%;">Eliminar</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var asesor in ViewBag.Asesores)
                                {
                                    var nombreCompleto = asesor.nombre;
                                    nombreCompleto += " " + asesor.primerApellido;
                                    if (asesor.segundoApellido != "-")
                                    {
                                        nombreCompleto += " " + asesor.segundoApellido;
                                    }

                                    <tr>
                                        <td>@asesor.nombre</td>
                                        <td>@asesor.primerApellido</td>
                                        <td>@asesor.segundoApellido</td>
                                        <td>@asesor.correo</td>
                                        <td>@asesor.descripcion</td>
                                        <td>@asesor.telefono</td>
                                        <td class="text-center">
                                            <button type="button"
                                                    class="icon-action icon-edit bi bi-pencil-square"
                                                    title="Editar"
                                                    aria-label="Editar facilitador(a) @nombreCompleto"
                                                    data-asesor-id="@asesor.idAsesor"
                                                    data-asesor-nombre="@asesor.nombre"
                                                    data-asesor-primer-apellido="@asesor.primerApellido"
                                                    data-asesor-segundo-apellido="@asesor.segundoApellido"
                                                    data-asesor-correo="@asesor.correo"
                                                    data-asesor-tipo-identificacion="@asesor.tipoIdentificacion"
                                                    data-asesor-numero-identificacion="@asesor.numeroIdentificacion"
                                                    data-asesor-descripcion="@asesor.descripcion"
                                                    data-asesor-telefono="@asesor.telefono"
                                                    onclick="openAsesorEditModal(this)"></button>
                                        </td>
                                        <td class="text-center">
                                            <a href="#" onclick="openAsesorDeleteModal('@asesor.idAsesor'); return false;" class="icon-action icon-delete" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="asesorTblPaginacion" class="table-pagination"></div>
                </div>
            }
        </div>
    </div>

    <div class="modal fade create-category-modal asesor-form-modal" id="modalCrearAsesor" tabindex="-1" aria-labelledby="modalCrearAsesorLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                @using (Html.BeginForm("AgregarAsesor", "Asesor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inline-required-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnToList" value="true" />
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalCrearAsesorLabel">Crear facilitador(a)</h2>
                            <p>Completa la información para registrar una persona facilitadora.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body asesor-edit-modal-body">
                        <section class="asesor-edit-section" aria-labelledby="asesorCrearPersonalHeading">
                            <h3 class="asesor-edit-section-title" id="asesorCrearPersonalHeading">Información personal</h3>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.nombre)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.nombre, new { @class = "form-control", id = "crearAsesorNombre", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.nombre, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.primerApellido)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.primerApellido, new { @class = "form-control", id = "crearAsesorPrimerApellido", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.primerApellido, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.segundoApellido)
                                        @Html.TextBoxFor(asesorModel => asesorModel.segundoApellido, new { @class = "form-control", id = "crearAsesorSegundoApellido", maxlength = "64", autocomplete = "off" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.segundoApellido, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.tipoIdentificacion)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.DropDownListFor(asesorModel => asesorModel.tipoIdentificacion, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoIdentificacion))), "Seleccione su tipo de identificación...", new { @class = "form-select", id = "crearAsesorTipoIdentificacion", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.tipoIdentificacion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.numeroIdentificacion)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.numeroIdentificacion, new { @class = "form-control", id = "crearAsesorNumeroIdentificacion", maxlength = "64", autocomplete = "off", placeholder = "Seleccione el tipo de identificación...", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.numeroIdentificacion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="asesor-edit-section" aria-labelledby="asesorCrearContactoHeading">
                            <h3 class="asesor-edit-section-title" id="asesorCrearContactoHeading">Información de contacto</h3>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.correo)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.correo, new { @class = "form-control", id = "crearAsesorCorreo", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.correo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.telefono)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.telefono, new { @class = "form-control", id = "crearAsesorTelefono", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.telefono, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.descripcion)
                                        @Html.TextAreaFor(asesorModel => asesorModel.descripcion, new { @class = "form-control", id = "crearAsesorDescripcion", maxlength = "256", autocomplete = "off", rows = "2" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.descripcion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="asesor-edit-section" aria-labelledby="asesorCrearSeguridadHeading">
                            <h3 class="asesor-edit-section-title" id="asesorCrearSeguridadHeading">Seguridad y acceso</h3>
                            <p class="asesor-edit-section-help">Define la contraseña inicial de la cuenta.</p>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field asesor-password-field">
                                        @Html.LabelFor(asesorModel => asesorModel.contrasena)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        <div class="input-group">
                                            @Html.PasswordFor(asesorModel => asesorModel.contrasena, new { id = "crearAsesorPassword", @class = "form-control", maxlength = "64", autocomplete = "off", required = "required" })
                                            <button type="button" class="btn btn-outline-secondary" aria-label="Mostrar u ocultar contraseña" onclick="toggleAsesorPassword('crearAsesorPassword', 'crearAsesorPasswordIcon')"><i id="crearAsesorPasswordIcon" class="bi bi-eye" aria-hidden="true"></i></button>
                                        </div>
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.contrasena, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field asesor-password-field">
                                        @Html.LabelFor(asesorModel => asesorModel.confirmarContrasena)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        <div class="input-group">
                                            @Html.PasswordFor(asesorModel => asesorModel.confirmarContrasena, new { id = "crearAsesorPasswordCheck", @class = "form-control", maxlength = "64", autocomplete = "off", required = "required" })
                                            <button type="button" class="btn btn-outline-secondary" aria-label="Mostrar u ocultar confirmación de contraseña" onclick="toggleAsesorPassword('crearAsesorPasswordCheck', 'crearAsesorPasswordCheckIcon')"><i id="crearAsesorPasswordCheckIcon" class="bi bi-eye" aria-hidden="true"></i></button>
                                        </div>
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.confirmarContrasena, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn create-category-save">Guardar facilitador(a)</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal category-delete-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("EliminarAsesor", "Asesor"))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-trash3"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEliminarLabel">Eliminar facilitador(a)</h2>
                            <p>Confirma si deseas quitar este(a) facilitador(a) del sistema.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Estás seguro de que deseas eliminar a este(a) facilitador(a)? Esta acción no se puede deshacer.
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="idAsesor" name="idAsesor">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn category-delete-confirm">Eliminar facilitador(a)</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade create-category-modal asesor-edit-modal asesor-form-modal" id="modalEditarAsesor" tabindex="-1" aria-labelledby="modalEditarAsesorLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                @using (Html.BeginForm("ActualizarAsesor", "Asesor", FormMethod.Post, new { enctype = "multipart/form-data", @class = "inline-required-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(asesorModel => asesorModel.idAsesor, new { id = "editarAsesorId" })
                    <input type="hidden" name="returnToList" value="true" />
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-person-gear"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEditarAsesorLabel">Editar facilitador(a)</h2>
                            <p>Actualiza la información de la persona facilitadora.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body asesor-edit-modal-body">
                        <section class="asesor-edit-section" aria-labelledby="asesorPersonalHeading">
                            <h3 class="asesor-edit-section-title" id="asesorPersonalHeading">Información personal</h3>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.nombre)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.nombre, new { @class = "form-control", id = "editarAsesorNombre", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.nombre, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.primerApellido)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.primerApellido, new { @class = "form-control", id = "editarAsesorPrimerApellido", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.primerApellido, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.segundoApellido)
                                        @Html.TextBoxFor(asesorModel => asesorModel.segundoApellido, new { @class = "form-control", id = "editarAsesorSegundoApellido", maxlength = "64", autocomplete = "off" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.segundoApellido, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.tipoIdentificacion)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.DropDownListFor(asesorModel => asesorModel.tipoIdentificacion, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoIdentificacion))), "Seleccione su tipo de identificación...", new { @class = "form-select", id = "editarAsesorTipoIdentificacion", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.tipoIdentificacion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.numeroIdentificacion)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.numeroIdentificacion, new { @class = "form-control", id = "editarAsesorNumeroIdentificacion", maxlength = "64", autocomplete = "off", placeholder = "Seleccione el tipo de identificación...", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.numeroIdentificacion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="asesor-edit-section" aria-labelledby="asesorContactoHeading">
                            <h3 class="asesor-edit-section-title" id="asesorContactoHeading">Información de contacto</h3>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.correo)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.correo, new { @class = "form-control", id = "editarAsesorCorreo", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.correo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.telefono)
                                        <span class="create-category-required" aria-hidden="true">*</span>
                                        @Html.TextBoxFor(asesorModel => asesorModel.telefono, new { @class = "form-control", id = "editarAsesorTelefono", maxlength = "64", autocomplete = "off", required = "required" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.telefono, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group create-category-field">
                                        @Html.LabelFor(asesorModel => asesorModel.descripcion)
                                        @Html.TextAreaFor(asesorModel => asesorModel.descripcion, new { @class = "form-control", id = "editarAsesorDescripcion", maxlength = "256", autocomplete = "off", rows = "2" })
                                        @Html.ValidationMessageFor(asesorModel => asesorModel.descripcion, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </section>

                        @if (ViewBag.Role == 1)
                        {
                            <section class="asesor-edit-section" aria-labelledby="asesorSeguridadHeading">
                                <div class="asesor-edit-section-heading">
                                    <h3 class="asesor-edit-section-title" id="asesorSeguridadHeading">Seguridad y acceso</h3>
                                    <span class="asesor-edit-optional">Opcional al editar</span>
                                </div>
                                <p class="asesor-edit-section-help">Completa estos campos únicamente si deseas cambiar la contraseña.</p>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="form-group create-category-field asesor-password-field">
                                            @Html.Label("contrasena", "Nueva contraseña", new { @for = "editarAsesorPassword" })
                                            <div class="input-group">
                                                @Html.PasswordFor(asesorModel => asesorModel.contrasena, new { id = "editarAsesorPassword", @class = "form-control", maxlength = "64", autocomplete = "off" })
                                                <button type="button" class="btn btn-outline-secondary" aria-label="Mostrar u ocultar contraseña" onclick="toggleAsesorPassword('editarAsesorPassword', 'editarAsesorPasswordIcon')"><i id="editarAsesorPasswordIcon" class="bi bi-eye" aria-hidden="true"></i></button>
                                            </div>
                                            @Html.ValidationMessageFor(asesorModel => asesorModel.contrasena, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-group create-category-field asesor-password-field">
                                            @Html.Label("confirmarContrasena", "Confirmar contraseña", new { @for = "editarAsesorPasswordCheck" })
                                            <div class="input-group">
                                                @Html.PasswordFor(asesorModel => asesorModel.confirmarContrasena, new { id = "editarAsesorPasswordCheck", @class = "form-control", maxlength = "64", autocomplete = "off" })
                                                <button type="button" class="btn btn-outline-secondary" aria-label="Mostrar u ocultar confirmación de contraseña" onclick="toggleAsesorPassword('editarAsesorPasswordCheck', 'editarAsesorPasswordCheckIcon')"><i id="editarAsesorPasswordCheckIcon" class="bi bi-eye" aria-hidden="true"></i></button>
                                            </div>
                                            @Html.ValidationMessageFor(asesorModel => asesorModel.confirmarContrasena, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </section>
                        }
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn create-category-save">Guardar cambios</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
