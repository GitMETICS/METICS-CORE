@using webMetics.Controllers
@{
    ViewBag.Title = "Lista de medallas";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid table-page-with-divider">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />

        @await Html.PartialAsync("_MeticsToast")

        <section class="file-management-card medal-file-management" aria-labelledby="medallaFileManagementTitle">
            <header class="file-management-header">
                <h2 id="medallaFileManagementTitle">Gestión de medallas</h2>
                <p>Agregue imágenes al catálogo de medallas</p>
            </header>
            <div class="file-management-body">
                <section class="file-management-section" aria-labelledby="medallaUploadTitle">
                    <div class="file-section-heading">
                        <i class="bi bi-upload" aria-hidden="true"></i>
                        <div>
                            <h3 id="medallaUploadTitle">Subir medalla</h3>
                            <p>Seleccione la imagen que desea agregar</p>
                        </div>
                    </div>

                    <form method="post" enctype="multipart/form-data" asp-controller="Medallas" asp-action="SubirMedalla" class="medal-import-form">
                        <div class="file-management-controls file-import-controls">
                            <input type="file" name="imageFile" id="medallaFileInput" class="participant-file-input" accept=".png,.jpg,.jpeg,image/png,image/jpeg" aria-label="Seleccionar imagen de medalla" onchange="updateMedallaFileName(this)" />
                            <label for="medallaFileInput" class="file-management-button file-management-button-secondary file-picker-trigger">
                                <i class="bi bi-paperclip" aria-hidden="true"></i>
                                <span id="medallaFileName">Elegir archivo</span>
                            </label>
                            <button type="submit" class="file-management-button file-management-button-primary">
                                <i class="bi bi-upload" aria-hidden="true"></i>
                                Subir
                            </button>
                        </div>
                    </form>

                    <div class="file-management-note file-requirements-note">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <p>Subir una imagen en formato <strong>PNG</strong> o <strong>JPG</strong> menor a 5 MB.</p>
                    </div>
                </section>
            </div>
        </section>

        <section class="medal-catalog-card" aria-labelledby="medalCatalogTitle">
            <header class="medal-catalog-header">
                <span class="medal-catalog-header-icon" aria-hidden="true"><i class="bi bi-images"></i></span>
                <div>
                    <h2 id="medalCatalogTitle">Medallas registradas</h2>
                    <p>Consulte y administre las medallas disponibles.</p>
                </div>
            </header>

            <div class="medal-catalog-body">
                @{ var totalMedallas = ViewBag.TodasLasMedallas?.Count ?? 0; }
                <div class="medal-catalog-toolbar">
                    <label class="medal-catalog-search" for="medallaCatalogSearch">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" id="medallaCatalogSearch" placeholder="Buscar medalla..." aria-label="Buscar medalla" oninput="filterMedalCatalog()" />
                    </label>
                    <span class="medal-catalog-count" id="medallaCatalogCount" aria-live="polite">@totalMedallas @(totalMedallas == 1 ? "medalla" : "medallas")</span>
                </div>

                @if (ViewBag.TodasLasMedallas != null && totalMedallas > 0)
                {
                    var medallasRegistradas = ViewBag.MedallasRegistradas as List<string> ?? new List<string>();
                    <div class="medal-catalog-grid" id="medallaCatalogGrid">
                        @foreach (string nombreMedalla in ViewBag.TodasLasMedallas)
                        {
                            var medallaRegistrada = medallasRegistradas.Contains(nombreMedalla, StringComparer.OrdinalIgnoreCase);
                            <article class="medal-catalog-item" data-medal-name="@nombreMedalla.ToLowerInvariant()">
                                @if (medallaRegistrada)
                                {
                                    <div class="dropdown medal-catalog-menu">
                                        <button type="button" class="medal-catalog-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opciones para @nombreMedalla">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button" class="dropdown-item medal-catalog-edit" data-medal-name="@nombreMedalla" data-medal-display="@webMetics.Services.MedallasCatalogoService.NombreVisible(nombreMedalla)" data-medal-src="@Url.Content("~/images/medallas/" + Uri.EscapeDataString(nombreMedalla))" data-bs-toggle="modal" data-bs-target="#modalEditarMedalla"><i class="bi bi-pencil-square" aria-hidden="true"></i><span>Editar</span></button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item medal-catalog-delete" data-medal-name="@nombreMedalla" data-medal-display="@webMetics.Services.MedallasCatalogoService.NombreVisible(nombreMedalla)" data-bs-toggle="modal" data-bs-target="#modalEliminar"><i class="bi bi-trash3" aria-hidden="true"></i><span>Eliminar</span></button>
                                            </li>
                                        </ul>
                                    </div>
                                }

                                <div class="medal-catalog-image-wrap">
                                    <img src="@Url.Content("~/images/medallas/" + Uri.EscapeDataString(nombreMedalla))" alt="" loading="lazy" />
                                </div>
                                <h3 title="@nombreMedalla">@webMetics.Services.MedallasCatalogoService.NombreVisible(nombreMedalla)</h3>
                            </article>
                        }
                    </div>
                    <p class="medal-catalog-empty" id="medallaCatalogEmpty" hidden>No se encontraron medallas con ese nombre.</p>
                }
                else
                {
                    <p class="medal-catalog-empty">No hay imágenes de medallas disponibles.</p>
                }
            </div>
        </section>
    </div>

    <!-- Popup: editar medalla (mismo POST que la página Editar medalla). -->
    <div class="modal fade create-category-modal" id="modalEditarMedalla" tabindex="-1" aria-labelledby="modalEditarMedallaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" enctype="multipart/form-data" asp-controller="Medallas" asp-action="EditarMedalla">
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-award"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEditarMedallaLabel">Editar medalla</h2>
                            <p>Reemplaza la imagen de la medalla seleccionada.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body">
                        <div class="medal-edit-current">
                            <div class="medal-edit-preview"><img id="editarMedallaImagen" src="" alt="" /></div>
                            <div class="medal-edit-name">
                                <span>Medalla actual</span>
                                <strong id="editarMedallaNombre"></strong>
                            </div>
                        </div>
                        <input type="text" name="nombreMedalla" id="editarMedallaNombreInput" value="" hidden />
                        <label class="medal-edit-label" for="editarMedallaArchivo">Nueva imagen</label>
                        <div class="file-management-controls file-import-controls">
                            <input type="file" name="imageFile" id="editarMedallaArchivo" class="participant-file-input" accept=".png,.jpg,.jpeg,image/png,image/jpeg" onchange="updateEditarMedallaFileName(this)" />
                            <label for="editarMedallaArchivo" class="file-management-button file-management-button-secondary file-picker-trigger">
                                <i class="bi bi-paperclip" aria-hidden="true"></i>
                                <span id="editarMedallaArchivoNombre">Elegir archivo</span>
                            </label>
                        </div>
                        <p class="medal-edit-help"><i class="bi bi-info-circle" aria-hidden="true"></i>Subir una imagen en formato <strong>PNG</strong> o <strong>JPG</strong> menor a 5 MB.</p>
                        <p class="medal-edit-help medal-edit-name-note"><i class="bi bi-tag" aria-hidden="true"></i>El nombre de la medalla se tomará del nombre del archivo que suba (sin la extensión).</p>
                        <p class="medal-edit-new-name" id="editarMedallaNuevoNombre" hidden>Nuevo nombre: <strong></strong></p>
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn create-category-save">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Popup: eliminar medalla. -->
    <div class="modal fade create-category-modal category-delete-modal" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                @using (Html.BeginForm("EliminarMedalla", "Medallas"))
                {
                    <div class="modal-header create-category-modal-header">
                        <div class="create-category-modal-icon" aria-hidden="true"><i class="bi bi-trash3"></i></div>
                        <div class="create-category-modal-heading">
                            <h2 class="modal-title" id="modalEliminarLabel">Eliminar medalla</h2>
                            <p>La medalla dejará de estar disponible en el catálogo.</p>
                        </div>
                    </div>
                    <div class="modal-body create-category-modal-body category-delete-message">
                        ¿Está seguro de que desea eliminar la medalla <strong id="eliminarMedallaNombre"></strong>?
                    </div>
                    <div class="modal-footer create-category-modal-actions">
                        <input type="hidden" id="nombreMedalla" name="nombreMedalla">
                        <button type="button" class="btn create-category-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn category-delete-confirm">Eliminar medalla</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script type="text/javascript">
    function updateMedallaFileName(fileInput) {
        var fileNameLabel = document.getElementById('medallaFileName');
        if (!fileNameLabel) return;

        var selectedFile = fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
        fileNameLabel.textContent = selectedFile ? selectedFile.name : 'Elegir archivo';
        fileNameLabel.title = selectedFile ? selectedFile.name : '';
    }

    function updateEditarMedallaFileName(fileInput) {
        var etiqueta = document.getElementById('editarMedallaArchivoNombre');
        if (!etiqueta) return;
        var archivo = fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
        etiqueta.textContent = archivo ? archivo.name : 'Elegir archivo';
        etiqueta.title = archivo ? archivo.name : '';

        // Vista previa del nombre que tendrá la medalla (nombre del archivo sin la extensión).
        var nuevoNombre = document.getElementById('editarMedallaNuevoNombre');
        if (nuevoNombre) {
            nuevoNombre.hidden = !archivo;
            nuevoNombre.querySelector('strong').textContent = archivo ? archivo.name.replace(/\.[^.]+$/, '').trim() : '';
        }
    }

    // Popup de editar: carga la medalla elegida y limpia el archivo anterior.
    document.querySelectorAll('.medal-catalog-edit').forEach(function (button) {
        button.addEventListener('click', function () {
            var nombre = button.dataset.medalName || '';
            document.getElementById('editarMedallaNombreInput').value = nombre;
            document.getElementById('editarMedallaNombre').textContent = button.dataset.medalDisplay || '';
            var imagen = document.getElementById('editarMedallaImagen');
            imagen.src = button.dataset.medalSrc || '';
            imagen.alt = 'Medalla: ' + (button.dataset.medalDisplay || '');
            var archivo = document.getElementById('editarMedallaArchivo');
            archivo.value = '';
            updateEditarMedallaFileName(archivo);
        });
    });

    document.querySelectorAll('.medal-catalog-delete').forEach(function (button) {
        button.addEventListener('click', function () {
            document.getElementById('nombreMedalla').value = button.dataset.medalName || '';
            document.getElementById('eliminarMedallaNombre').textContent = '«' + (button.dataset.medalDisplay || '') + '»';
        });
    });

    function filterMedalCatalog() {
        var searchInput = document.getElementById('medallaCatalogSearch');
        var grid = document.getElementById('medallaCatalogGrid');
        if (!searchInput || !grid) return;

        var term = searchInput.value.trim().toLocaleLowerCase();
        var cards = grid.querySelectorAll('.medal-catalog-item');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var matches = (card.dataset.medalName || '').includes(term);
            card.hidden = !matches;
            if (matches) visibleCount++;
        });

        var countLabel = document.getElementById('medallaCatalogCount');
        if (countLabel) countLabel.textContent = visibleCount + (visibleCount === 1 ? ' medalla' : ' medallas');

        var emptyMessage = document.getElementById('medallaCatalogEmpty');
        if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    }
</script>

<script type="text/javascript">
    function filterParticipantes() {
        var input, filter, container, elements, i, txtValue;
        input = document.getElementById("participanteSearch");
        filter = input.value.toUpperCase();
        container = document.getElementById("participantesContainer"); // Selecciona el contenedor por su ID
        elements = container.getElementsByClassName("form-check");
        for (i = 0; i < elements.length; i++) {
            var label = elements[i].querySelector("label");
            if (label) {
                txtValue = label.textContent || label.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    elements[i].style.display = "";
                } else {
                    elements[i].style.display = "none";
                }
            }
        }
    }
</script>

<script>
    function filterMedals() {
        var input, filter, medallaList, medallas, i, txtValue;
        input = document.getElementById("medallaSearch");
        filter = input.value.toUpperCase();
        medallaList = document.getElementById("medallaList");
        medallas = medallaList.getElementsByClassName("medalla-item");

        for (i = 0; i < medallas.length; i++) {
            txtValue = medallas[i].textContent || medallas[i].innerText;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                medallas[i].style.display = "";
            } else {
                medallas[i].style.display = "none";
            }
        }
    }
</script>

<style>
    .participante-item {
        display: block; /* Asegura que cada checkbox y label ocupe una línea */
    }
</style>
