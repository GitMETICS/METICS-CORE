@using webMetics.Controllers
@{
    ViewBag.Title = "Lista de Medallas";
    PageHeadingBuilder.Configure(ViewContext, Url);
}

@if (ViewBag.Id != "" && ViewBag.Role == 1)
{
    <div class="contenedor-caja container-fluid table-page-with-divider">
        <h1 metics-page-heading>@ViewBag.Title</h1>
        <hr metics-page-heading />

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-dark alert-dismissible fade show mb-4" role="alert">
                @ViewBag.ErrorMessage
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <section class="file-management-card medal-file-management" aria-labelledby="medallaFileManagementTitle">
            <header class="file-management-header">
                <h2 id="medallaFileManagementTitle">Gestión de medallas</h2>
                <p>Agrega imágenes al catálogo de medallas</p>
            </header>
            <div class="file-management-body">
                <section class="file-management-section" aria-labelledby="medallaUploadTitle">
                    <div class="file-section-heading">
                        <i class="bi bi-upload" aria-hidden="true"></i>
                        <div>
                            <h3 id="medallaUploadTitle">Subir medalla</h3>
                            <p>Selecciona la imagen que deseas agregar</p>
                        </div>
                    </div>

                    <form method="post" enctype="multipart/form-data" asp-controller="Medallas" asp-action="SubirMedalla" class="medal-import-form">
                        <div class="file-management-controls file-import-controls">
                            <input type="file" name="imageFile" id="medallaFileInput" class="participant-file-input" accept=".png,.jpg,.jpeg,image/png,image/jpeg" aria-label="Seleccionar imagen de medalla" onchange="updateMedallaFileName(this)" />
                            <label for="medallaFileInput" class="file-management-button file-management-button-secondary file-picker-trigger">
                                <i class="bi bi-paperclip" aria-hidden="true"></i>
                                <span id="medallaFileName">Elegir archivo</span>
                            </label>
                            <button type="submit" class="file-management-button file-management-button-primary">
                                <i class="bi bi-upload" aria-hidden="true"></i>
                                Subir
                            </button>
                        </div>
                    </form>

                    <div class="file-management-note file-requirements-note">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <p>Subir una imagen en formato <strong>PNG</strong> o <strong>JPG</strong> menor a 5 MB.</p>
                    </div>
                </section>
            </div>
        </section>

        <section class="medal-catalog-card" aria-labelledby="medalCatalogTitle">
            <header class="medal-catalog-header">
                <span class="medal-catalog-header-icon" aria-hidden="true"><i class="bi bi-images"></i></span>
                <div>
                    <h2 id="medalCatalogTitle">Medallas registradas</h2>
                    <p>Consulta y administra las medallas disponibles.</p>
                </div>
            </header>

            <div class="medal-catalog-body">
                @{ var totalMedallas = ViewBag.TodasLasMedallas?.Count ?? 0; }
                <div class="medal-catalog-toolbar">
                    <label class="medal-catalog-search" for="medallaCatalogSearch">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" id="medallaCatalogSearch" placeholder="Buscar medalla..." aria-label="Buscar medalla" oninput="filterMedalCatalog()" />
                    </label>
                    <span class="medal-catalog-count" id="medallaCatalogCount" aria-live="polite">@totalMedallas @(totalMedallas == 1 ? "medalla" : "medallas")</span>
                </div>

                @if (ViewBag.TodasLasMedallas != null && totalMedallas > 0)
                {
                    var medallasRegistradas = ViewBag.MedallasRegistradas as List<string> ?? new List<string>();
                    <div class="medal-catalog-grid" id="medallaCatalogGrid">
                        @foreach (string nombreMedalla in ViewBag.TodasLasMedallas)
                        {
                            var medallaRegistrada = medallasRegistradas.Contains(nombreMedalla, StringComparer.OrdinalIgnoreCase);
                            <article class="medal-catalog-item" data-medal-name="@nombreMedalla.ToLowerInvariant()">
                                @if (medallaRegistrada)
                                {
                                    <div class="dropdown medal-catalog-menu">
                                        <button type="button" class="medal-catalog-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opciones para @nombreMedalla">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                @Html.ActionLink("Editar", "EditarMedalla", "Medallas", new { nombreMedalla = nombreMedalla }, new { @class = "dropdown-item bi bi-pencil-square" })
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger bi bi-trash3 medal-catalog-delete" data-medal-name="@nombreMedalla" data-bs-toggle="modal" data-bs-target="#modalEliminar">Eliminar</button>
                                            </li>
                                        </ul>
                                    </div>
                                }

                                <div class="medal-catalog-image-wrap">
                                    <img src="@Url.Content("~/images/medallas/" + Uri.EscapeDataString(nombreMedalla))" alt="Medalla: @nombreMedalla" loading="lazy" />
                                </div>
                                <h3 title="@nombreMedalla">@nombreMedalla</h3>
                            </article>
                        }
                    </div>
                    <p class="medal-catalog-empty" id="medallaCatalogEmpty" hidden>No se encontraron medallas con ese nombre.</p>
                }
                else
                {
                    <p class="medal-catalog-empty">No hay imágenes de medallas disponibles.</p>
                }
            </div>
        </section>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Eliminar medalla</h5>
                </div>
                <div class="modal-body">
                    ¿Está seguro de que desea eliminar esta medalla?
                    <br />
                    @using (Html.BeginForm("EliminarMedalla", "Medallas"))
                    {
                        <div class="modal-footer">
                            <input type="hidden" id="nombreMedalla" name="nombreMedalla">
                            <input type="submit" class="btn btn-danger" value="Aceptar" />
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script type="text/javascript">
    function updateMedallaFileName(fileInput) {
        var fileNameLabel = document.getElementById('medallaFileName');
        if (!fileNameLabel) return;

        var selectedFile = fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
        fileNameLabel.textContent = selectedFile ? selectedFile.name : 'Elegir archivo';
        fileNameLabel.title = selectedFile ? selectedFile.name : '';
    }

    document.querySelectorAll('.medal-catalog-delete').forEach(function (button) {
        button.addEventListener('click', function () {
            document.getElementById('nombreMedalla').value = button.dataset.medalName || '';
        });
    });

    function filterMedalCatalog() {
        var searchInput = document.getElementById('medallaCatalogSearch');
        var grid = document.getElementById('medallaCatalogGrid');
        if (!searchInput || !grid) return;

        var term = searchInput.value.trim().toLocaleLowerCase();
        var cards = grid.querySelectorAll('.medal-catalog-item');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var matches = (card.dataset.medalName || '').includes(term);
            card.hidden = !matches;
            if (matches) visibleCount++;
        });

        var countLabel = document.getElementById('medallaCatalogCount');
        if (countLabel) countLabel.textContent = visibleCount + (visibleCount === 1 ? ' medalla' : ' medallas');

        var emptyMessage = document.getElementById('medallaCatalogEmpty');
        if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    }
</script>

<script type="text/javascript">
    function filterParticipantes() {
        var input, filter, container, elements, i, txtValue;
        input = document.getElementById("participanteSearch");
        filter = input.value.toUpperCase();
        container = document.getElementById("participantesContainer"); // Selecciona el contenedor por su ID
        elements = container.getElementsByClassName("form-check");
        for (i = 0; i < elements.length; i++) {
            var label = elements[i].querySelector("label");
            if (label) {
                txtValue = label.textContent || label.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    elements[i].style.display = "";
                } else {
                    elements[i].style.display = "none";
                }
            }
        }
    }
</script>

<script>
    function filterMedals() {
        var input, filter, medallaList, medallas, i, txtValue;
        input = document.getElementById("medallaSearch");
        filter = input.value.toUpperCase();
        medallaList = document.getElementById("medallaList");
        medallas = medallaList.getElementsByClassName("medalla-item");

        for (i = 0; i < medallas.length; i++) {
            txtValue = medallas[i].textContent || medallas[i].innerText;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                medallas[i].style.display = "";
            } else {
                medallas[i].style.display = "none";
            }
        }
    }
</script>

<style>
    .participante-item {
        display: block; /* Asegura que cada checkbox y label ocupe una línea */
    }
</style>
