						<label class="medal-section-label" id="medalGalleryTitle" for="medalla-search">Seleccionar medalla</label>
						<div class="input-group medal-search-group">
							<input type="text" class="form-control" id="medalla-search" onkeyup="filterMedals()" placeholder="Buscar medalla..." aria-label="Buscar medalla">
							<span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
						</div>

						@if (ViewBag.TodasLasMedallas != null)
						{
							<div class="medal-carousel" aria-label="Navegación de medallas">
								<button type="button" class="medal-carousel-button" id="medalCarouselPrevious" onclick="navigateMedalCarousel(-1)" aria-label="Ver medallas anteriores" aria-controls="medalCarouselViewport" disabled>
									<i class="bi bi-chevron-left" aria-hidden="true"></i>
								</button>
								<div class="medal-gallery-scroll" id="medalCarouselViewport" role="region" aria-label="Galería de medallas" tabindex="0">
									<div id="medalla-list" class="medalla-list-container" role="radiogroup" aria-label="Medallas disponibles">
										@foreach (var medalla in ViewBag.TodasLasMedallas)
										{
											<div class="medalla-item medal-option-card">
												<img src="~/images/medallas/@medalla" alt="" class="medalla-image" loading="lazy" />
												<div class="form-check">
													<label class="form-check-label" for="medalla_@medalla">
														<input class="form-check-input" type="radio" name="nombreMedalla" value="@medalla" id="medalla_@medalla" form="formAsignarMedallas">
														<span>@medalla</span>
													</label>
												</div>
											</div>
										}
									</div>
								</div>
								<button type="button" class="medal-carousel-button" id="medalCarouselNext" onclick="navigateMedalCarousel(1)" aria-label="Ver más medallas" aria-controls="medalCarouselViewport">
									<i class="bi bi-chevron-right" aria-hidden="true"></i>
								</button>
							</div>
						}
						else
						{
							<p class="medal-gallery-empty">No hay medallas disponibles.</p>
						}
					</section>

					<aside class="medal-assignment-panel" aria-labelledby="assignmentSummaryTitle">
						<h3 id="assignmentSummaryTitle">Resumen de asignación</h3>
						@if (ViewBag.Role == 1)
						{
							@Html.AntiForgeryToken()
							<input type="hidden" name="nombreGrupo" value="@ViewBag.NombreGrupo">
							<input type="hidden" name="numeroGrupo" value="@ViewBag.NumeroGrupo">

							<div class="medal-participant-summary" aria-live="polite" aria-atomic="true">
								<i class="bi bi-people" aria-hidden="true"></i>
								<div>
									<span>Participantes seleccionados</span>
									<strong id="selectedCount">0</strong>
								</div>
							</div>
						}
						<p class="medal-selection-hint"><i class="bi bi-info-circle-fill" aria-hidden="true"></i> Selecciona participantes desde el listado de participantes.</p>
						<div class="medal-assignment-actions">
							@if (ViewBag.Role == 1)
							{
								<button type="button" class="btn admin-panel-btn-secondary" onclick="selectAllParticipants()">
									<i class="bi bi-check2-square" aria-hidden="true"></i>Seleccionar todo
								</button>
								<button type="button" class="btn admin-panel-btn-secondary" onclick="clearAllParticipants()">
									<i class="bi bi-x-lg" aria-hidden="true"></i>Limpiar
								</button>
							}
							<button type="submit" class="btn admin-panel-btn-primary" id="btnAsignarMedallas" form="formAsignarMedallas">
								<i class="bi bi-award" aria-hidden="true"></i>Asignar a seleccionados
							</button>
						</div>

						@if (ViewBag.Role == 1)
						{
							<div class="participantes-more-actions">
								<span class="participantes-more-title">Otras acciones</span>
								<form method="post" asp-controller="Inscripcion" asp-action="CambiarEstadoInscritoAIncompleto" id="formCambiarEstado">
									@Html.AntiForgeryToken()
									<input type="hidden" name="idGrupo" value="@ViewBag.IdGrupo">
									<button type="button" class="btn admin-panel-btn-soft" id="btnCambiarEstado" onclick="actualizarModalCambiarEstado()">
										<i class="bi bi-arrow-repeat" aria-hidden="true"></i>Cambiar estado
									</button>
								</form>

								<form method="post" asp-controller="Inscripcion" asp-action="EliminarInscripcionMasivo" id="formEliminarInscripciones">
									<button type="button" class="btn participantes-btn-danger" id="btnEliminarInscripciones" onclick="actualizarModalEliminarMasivo()">
										<i class="bi bi-trash3" aria-hidden="true"></i>Eliminar inscripciones
									</button>
								</form>
							</div>
						}
					</aside>
				</div>
			</section>
		}

		<!-- SECCIÓN: Listado de participantes -->
		<section class="table-card" aria-labelledby="participantesListadoTitulo">
			<div class="table-card-header">
				<div class="table-card-heading participantes-list-heading">
					<div>
						<div class="participantes-list-title">
							<h2 class="table-card-title mb-0" id="participantesListadoTitulo">Listado de participantes</h2>
							<span class="participantes-total" title="Participantes inscritos">@totalParticipantes</span>
						</div>
						<span class="table-card-desc">Personas inscritas en el módulo</span>
					</div>
				</div>
				<div class="participantes-list-actions">
					<div class="dropdown">
						<button type="button" class="btn admin-panel-btn-secondary dropdown-toggle" id="participantesExportar" data-bs-toggle="dropdown" aria-expanded="false">
							<i class="bi bi-download" aria-hidden="true"></i>Exportar
						</button>
						<ul class="dropdown-menu dropdown-menu-end participantes-export-menu" aria-labelledby="participantesExportar">
							<li><a class="dropdown-item" href="@Url.Action("ExportarCalificacionesPDF", "Calificaciones", new { idGrupo = ViewBag.IdGrupo, searchTerm = Context.Request.Query["searchTerm"] })"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>Documento PDF</a></li>
							<li><a class="dropdown-item" href="@Url.Action("ExportarCalificacionesExcel", "Calificaciones", new { idGrupo = ViewBag.IdGrupo, searchTerm = Context.Request.Query["searchTerm"] })"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i>Microsoft Excel</a></li>
							<li><a class="dropdown-item" href="@Url.Action("ExportarCalificacionesWord", "Calificaciones", new { idGrupo = ViewBag.IdGrupo, searchTerm = Context.Request.Query["searchTerm"] })"><i class="bi bi-file-earmark-word" aria-hidden="true"></i>Microsoft Word</a></li>
						</ul>
					</div>
					<a class="btn admin-panel-btn-soft" href="@Url.Action("EnviarCalificacionesAlCorreo", "Calificaciones", new { idGrupo = ViewBag.IdGrupo, searchTerm = Context.Request.Query["searchTerm"] })"><i class="bi bi-envelope" aria-hidden="true"></i>Enviar</a>
				</div>
			</div>

			@if (ViewBag.ListaParticipantes == null)
			{
				<div class="participantes-empty">
					<span class="participantes-empty-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
					<p class="participantes-empty-title">No hay participantes inscritos</p>
					<p class="participantes-empty-text">Las personas inscritas en este módulo aparecerán aquí.</p>
				</div>
			}
			else
			{
