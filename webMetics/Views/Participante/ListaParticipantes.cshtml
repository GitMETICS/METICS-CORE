												   aria-label="Seleccionar a @nombreCompleto">
										</div>
									</td>
									<td>@participante.unidadAcademica</td>
									<td>@nombreCompleto</td>
									<td>@participante.correo</td>
									<td class="text-center">
										<div class="horas-display" id="horas-display-@participante.idParticipante">
											<span>@horasAprobadas</span>
										</div>
										<form class="horas-form d-none" id="form-horas-@participante.idParticipante" data-id-participante="@participante.idParticipante" data-id-grupo="@ViewBag.IdGrupo">
											@Html.AntiForgeryToken()
											<div class="d-flex align-items-center gap-1 justify-content-center flex-nowrap">
												<input type="number" min="0" class="form-control form-control-sm" style="width: 80px; min-width: 80px;" name="horasAprobadas" value="@horasAprobadas" id="input-horas-@participante.idParticipante" aria-label="Horas aprobadas">
												<button type="submit" class="btn btn-sm participantes-inline-btn participantes-inline-save" title="Guardar" aria-label="Guardar horas">
													<i class="bi bi-check-lg"></i>
												</button>
												<button type="button" class="btn btn-sm participantes-inline-btn participantes-inline-cancel" title="Cancelar" aria-label="Cancelar edición" onclick="cancelarEdicionHoras('@participante.idParticipante')">
													<i class="bi bi-x-lg"></i>
												</button>
											</div>
										</form>
									</td>
									<td class="text-center">
										<div class="calificacion-display" id="calificacion-display-@participante.idParticipante">
											<span>@calificacion</span>
										</div>
										<form class="calificacion-form d-none" id="form-calificacion-@participante.idParticipante" data-id-participante="@participante.idParticipante" data-id-grupo="@ViewBag.IdGrupo">
											@Html.AntiForgeryToken()
											<div class="d-flex align-items-center gap-1 justify-content-center flex-nowrap">
												<input type="number" min="0" max="100" class="form-control form-control-sm" style="width: 80px; min-width: 80px;" name="calificacion" value="@calificacion" id="input-calificacion-@participante.idParticipante" aria-label="Calificación">
												<button type="submit" class="btn btn-sm participantes-inline-btn participantes-inline-save" title="Guardar" aria-label="Guardar calificación">
													<i class="bi bi-check-lg"></i>
												</button>
												<button type="button" class="btn btn-sm participantes-inline-btn participantes-inline-cancel" title="Cancelar" aria-label="Cancelar edición" onclick="cancelarEdicionCalificacion('@participante.idParticipante')">
													<i class="bi bi-x-lg"></i>
												</button>
											</div>
										</form>
									</td>
									<td class="text-center">
										<div class="grupo-action-list">
											<button type="button" class="grupo-action-btn" title="Editar horas" aria-label="Editar horas" onclick="editarHoras('@participante.idParticipante')">
												<i class="bi bi-pencil"></i>
											</button>
											<button type="button" class="grupo-action-btn" title="Editar calificación" aria-label="Editar calificación" onclick="editarCalificacion('@participante.idParticipante')">
												<i class="bi bi-pencil-square"></i>
											</button>
											<a class="grupo-action-btn" title="Ver detalles" aria-label="Ver detalles" href="@Url.Action("VerDatosParticipante", "Participante", new { idParticipante = participante.idParticipante, idGrupo = ViewBag.IdGrupo })">
												<i class="bi bi-search"></i>
											</a>
										</div>
									</td>
									@if (ViewBag.Role == 1)
									{
										<td class="text-center">
											<a href="#" class="grupo-action-delete" title="Eliminar inscripción" aria-label="Eliminar inscripción" data-bs-toggle="modal" data-bs-target="#modalEliminar" onclick="actualizarModalEliminarInscripcion('@ViewBag.NombreGrupo', '@ViewBag.NumeroGrupo', '@participante.idParticipante')">
												<i class="bi bi-trash3"></i>
											</a>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div id="participantesTblPaginacion" class="table-pagination"></div>
			}
		</section>

		@if (ViewBag.ListaParticipantes != null)
		{
			<div class="grupo-participantes-actions">
				<a href="@regresarUrl" class="btn admin-panel-btn-secondary">Regresar</a>
			</div>
		}
	</div>

