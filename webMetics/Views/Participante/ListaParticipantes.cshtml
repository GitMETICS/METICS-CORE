<script type="text/javascript">

	function guardarHoras(idParticipante) {
		const form = document.getElementById('form-horas-' + idParticipante);
		const input = document.getElementById('input-horas-' + idParticipante);
		const displayElement = document.getElementById('horas-display-' + idParticipante).querySelector('span');

		const formData = new FormData(form);

		formData.append('idGrupo', form.dataset.idGrupo);
		formData.append('idParticipante', form.dataset.idParticipante);

		input.disabled = true;

		fetch('@Url.Action("SubirHorasAprobadasYCalificacionAjax", "Calificaciones")', {
			method: 'POST',
			body: formData
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				displayElement.textContent = data.data.horasAprobadas;
				cancelarEdicionHoras(idParticipante);
				mostrarNotificacion(data.message, 'success');
			} else {
				mostrarNotificacion(data.message, 'danger');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			mostrarNotificacion('Error al guardar los cambios', 'danger');
		})
		.finally(() => {
			input.disabled = false;
		});
	}

	function guardarCalificacion(idParticipante) {
		const form = document.getElementById('form-calificacion-' + idParticipante);
		const input = document.getElementById('input-calificacion-' + idParticipante);
		const displayElement = document.getElementById('calificacion-display-' + idParticipante).querySelector('span');

		const formData = new FormData(form);

		formData.append('idGrupo', form.dataset.idGrupo);
		formData.append('idParticipante', form.dataset.idParticipante);

		input.disabled = true;

		fetch('@Url.Action("SubirHorasAprobadasYCalificacionAjax", "Calificaciones")', {
			method: 'POST',
			body: formData
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				if (data.data.calificacion !== null) {
					displayElement.textContent = data.data.calificacion;
				}
				cancelarEdicionCalificacion(idParticipante);
				mostrarNotificacion(data.message, 'success');
			} else {
				mostrarNotificacion(data.message, 'danger');
			}
		})
		.catch(error => {
			console.error('Error:', error);
			mostrarNotificacion('Error al guardar los cambios', 'danger');
		})
		.finally(() => {
			input.disabled = false;
		});
	}

	function mostrarNotificacion(mensaje, tipo) {
		let region = document.querySelector('.metics-toast-region');
		if (!region) {
			region = document.createElement('div');
			region.className = 'metics-toast-region';
			region.setAttribute('aria-label', 'Notificaciones');
			document.body.appendChild(region);
		}
		const esExito = tipo === 'success';
		const toast = document.createElement('div');
		toast.className = 'metics-toast toast fade' + (esExito ? '' : ' metics-toast--error');
		toast.setAttribute('role', esExito ? 'status' : 'alert');
		toast.setAttribute('aria-live', esExito ? 'polite' : 'assertive');
		toast.setAttribute('aria-atomic', 'true');
		toast.innerHTML =
			'<div class="metics-toast-inner">' +
				'<span class="metics-toast-icon" aria-hidden="true"><i class="bi ' + (esExito ? 'bi-check-lg' : 'bi-exclamation-lg') + '"></i></span>' +
				'<div class="metics-toast-message"><strong></strong><p></p></div>' +
				'<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar notificación"></button>' +
			'</div>';
		toast.querySelector('strong').textContent = esExito ? 'Operación completada' : 'No se pudo completar la operación';
		toast.querySelector('p').textContent = mensaje || '';
		region.appendChild(toast);
		toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
		if (window.bootstrap && window.bootstrap.Toast) {
			window.bootstrap.Toast.getOrCreateInstance(toast, { delay: esExito ? 4875 : 6750 }).show();
		} else {
			toast.classList.add('show');
			setTimeout(function () { toast.remove(); }, 4000);
		}
	}

	function actualizarModalEliminarInscripcion(nombreGrupo, numeroGrupo, idParticipante) {
		document.getElementById("nombreGrupo").value = nombreGrupo;
		document.getElementById("numeroGrupo").value = numeroGrupo;
		document.getElementById("idParticipante").value = idParticipante;
	}

	function updateSelectedCount() {
		const checkboxes = document.querySelectorAll('.participante-checkbox:checked');
		const selectedCount = document.getElementById('selectedCount');
		if (selectedCount) selectedCount.textContent = checkboxes.length;

		const allCheckboxes = document.querySelectorAll('.participante-checkbox');
		const selectAllCheckbox = document.getElementById('selectAllCheckbox');

		if (checkboxes.length === 0) {
			selectAllCheckbox.indeterminate = false;
			selectAllCheckbox.checked = false;
		} else if (checkboxes.length === allCheckboxes.length) {
			selectAllCheckbox.indeterminate = false;
			selectAllCheckbox.checked = true;
		} else {
			selectAllCheckbox.indeterminate = true;
		}
	}

	function toggleAllParticipants() {
		const selectAllCheckbox = document.getElementById('selectAllCheckbox');
		const participantCheckboxes = document.querySelectorAll('.participante-checkbox');

		participantCheckboxes.forEach(checkbox => {
			checkbox.checked = selectAllCheckbox.checked;
		});

		updateSelectedCount();
	}

	function selectAllParticipants() {
		const participantCheckboxes = document.querySelectorAll('.participante-checkbox');
		participantCheckboxes.forEach(checkbox => {
			checkbox.checked = true;
		});
		updateSelectedCount();
	}

	function clearAllParticipants() {
		const participantCheckboxes = document.querySelectorAll('.participante-checkbox');
		participantCheckboxes.forEach(checkbox => {
			checkbox.checked = false;
		});
		updateSelectedCount();
	}

	function actualizarModalEliminarMasivo() {
		const checkboxes = document.querySelectorAll('.participante-checkbox:checked');
		if (checkboxes.length === 0) {
			const modal = new bootstrap.Modal(document.getElementById('modalEliminarMasivoInvalido'));
			modal.show();
			return;
		}

		document.getElementById('cantidadParticipantes').textContent = checkboxes.length;

		const form = document.querySelector('#modalEliminarMasivo form');
		const existingInputs = form.querySelectorAll('input[name="participantesSeleccionados"]');
		existingInputs.forEach(input => input.remove());

		checkboxes.forEach(checkbox => {
			const input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'participantesSeleccionados';
			input.value = checkbox.value;
			form.appendChild(input);
		});

		const modal = new bootstrap.Modal(document.getElementById('modalEliminarMasivo'));
		modal.show();
	}

	function filterMedals() {
		var input = document.getElementById("medalla-search");
		if (!input) return;

		var filter = input.value.toUpperCase();
		var medallaList = document.getElementById("medalla-list");
		if (!medallaList) return;

		var medallas = medallaList.getElementsByClassName("medalla-item");

		for (var i = 0; i < medallas.length; i++) {
			var txtValue = medallas[i].textContent || medallas[i].innerText;
			if (txtValue.toUpperCase().indexOf(filter) > -1) {
				medallas[i].style.display = "";
			} else {
				medallas[i].style.display = "none";
			}
		}

		var viewport = document.getElementById('medalCarouselViewport');
		if (viewport) {
			viewport.scrollLeft = 0;
			updateMedalCarouselControls();
		}
	}

	// Carrusel de medallas (mismo comportamiento visual que "Ver inscripciones").
	function navigateMedalCarousel(direction) {
		const viewport = document.getElementById('medalCarouselViewport');
		if (!viewport) return;
		viewport.scrollBy({ left: direction * viewport.clientWidth * 0.8, behavior: 'smooth' });
	}

	function updateMedalCarouselControls() {
		const viewport = document.getElementById('medalCarouselViewport');
		const previousButton = document.getElementById('medalCarouselPrevious');
		const nextButton = document.getElementById('medalCarouselNext');
		if (!viewport || !previousButton || !nextButton) return;
		const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
		previousButton.disabled = viewport.scrollLeft <= 1;
		nextButton.disabled = viewport.scrollLeft >= maxScroll - 1;
	}

	(function () {
		const viewport = document.getElementById('medalCarouselViewport');
		if (!viewport) return;
		viewport.addEventListener('scroll', updateMedalCarouselControls, { passive: true });
		window.addEventListener('resize', updateMedalCarouselControls);
		window.addEventListener('load', updateMedalCarouselControls);
		updateMedalCarouselControls();
	})();

	document.getElementById('formAsignarMedallas').addEventListener('submit', function(e) {
		// Obtener todos los checkboxes seleccionados
		const checkboxes = document.querySelectorAll('.participante-checkbox:checked');

		// Crear inputs ocultos para cada participante seleccionado
		checkboxes.forEach(checkbox => {
			const input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'participantesSeleccionados';
			input.value = checkbox.value;
			this.appendChild(input);
		});
	});

	// Funciones para edición rápida de horas
	function editarHoras(idParticipante) {
		document.getElementById('horas-display-' + idParticipante).classList.add('d-none');
		document.getElementById('form-horas-' + idParticipante).classList.remove('d-none');
		document.getElementById('input-horas-' + idParticipante).focus();
		document.getElementById('input-horas-' + idParticipante).select();
	}

	function cancelarEdicionHoras(idParticipante) {
		document.getElementById('horas-display-' + idParticipante).classList.remove('d-none');
		document.getElementById('form-horas-' + idParticipante).classList.add('d-none');
	}

	// Funciones para edición rápida de calificaciones
	function editarCalificacion(idParticipante) {
		document.getElementById('calificacion-display-' + idParticipante).classList.add('d-none');
		document.getElementById('form-calificacion-' + idParticipante).classList.remove('d-none');
		document.getElementById('input-calificacion-' + idParticipante).focus();
		document.getElementById('input-calificacion-' + idParticipante).select();
	}

	function cancelarEdicionCalificacion(idParticipante) {
		document.getElementById('calificacion-display-' + idParticipante).classList.remove('d-none');
		document.getElementById('form-calificacion-' + idParticipante).classList.add('d-none');
	}

	document.addEventListener('DOMContentLoaded', function () {
		updateSelectedCount();

		// Muestra el nombre del archivo elegido en el selector personalizado (solo visual).
		const inputArchivo = document.getElementById('file');
		const nombreArchivo = document.getElementById('participantesFileName');
		if (inputArchivo && nombreArchivo) {
			inputArchivo.addEventListener('change', function () {
				const tieneArchivo = this.files && this.files.length > 0;
				nombreArchivo.textContent = tieneArchivo ? this.files[0].name : 'Ningún archivo seleccionado';
				document.getElementById('participantesFile').classList.toggle('has-file', tieneArchivo);
			});
		}

		// Prevenir submit tradicional y usar AJAX para formularios de horas
		document.querySelectorAll('.horas-form').forEach(form => {
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				const idParticipante = this.id.replace('form-horas-', '');
				guardarHoras(idParticipante);
			});
		});

		// Prevenir submit tradicional y usar AJAX para formularios de calificación
		document.querySelectorAll('.calificacion-form').forEach(form => {
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				const idParticipante = this.id.replace('form-calificacion-', '');
				guardarCalificacion(idParticipante);
			});
		});
	});
		function actualizarModalCambiarEstado() {
		const checkboxes = document.querySelectorAll('.participante-checkbox:checked');
		if (checkboxes.length === 0) {
			const modal = new bootstrap.Modal(document.getElementById('modalCambiarEstadoInvalido'));
			modal.show();
			return;
		}

		document.getElementById('cantidadParticipantesEstado').textContent = checkboxes.length;

		const form = document.querySelector('#modalCambiarEstado form');
		const existingInputs = form.querySelectorAll('input[name="participantesSeleccionados"]');
		existingInputs.forEach(input => input.remove());

		checkboxes.forEach(checkbox => {
			const input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'participantesSeleccionados';
			input.value = checkbox.value;
			form.appendChild(input);
		});

		const modal = new bootstrap.Modal(document.getElementById('modalCambiarEstado'));
		modal.show();
	}
</script>

