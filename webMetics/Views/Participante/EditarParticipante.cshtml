@model webMetics.Models.ParticipanteModel
@using webMetics.Controllers
@using webMetics.Helpers
@{
    ViewBag.Title = "Editar participante";
    PageHeadingBuilder.Configure(ViewContext, Url);

    var areasDisponibles = (ViewData["jsonDataAreas"] as List<string> ?? new List<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(a => a)
        .ToList();
}

@if (ViewBag.Id != "")
{
    <div class="contenedor-caja container-fluid create-participant-page edit-participant-page table-page-with-divider">
        @using (Html.BeginForm("ActualizarParticipante", "Participante", new { breadcrumbOrigin = Context.Request.Query["breadcrumbOrigin"].ToString() }, FormMethod.Post, null, new { enctype = "multipart/form-data", id = "participanteEditForm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            @if (ViewBag.ErrorMessage != null)
            {
                ViewData["ErrorMessage"] = ViewBag.ErrorMessage.ToString();
                @await Html.PartialAsync("_MeticsToast")
            }

            @Html.HiddenFor(participanteModel => participanteModel.horasMatriculadas)
            @Html.HiddenFor(participanteModel => participanteModel.horasAprobadas)

            <div class="create-participant-sections">
                <section class="create-participant-card" aria-labelledby="editParticipantPersonalTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                        <div><h2 id="editParticipantPersonalTitle">Información personal</h2><p>Datos de identificación del participante.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <div class="create-participant-field-grid">
                            <div class="form-group create-participant-full-field">
                                @Html.LabelFor(m => m.nombre) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", maxlength = "64", autocomplete = "off", aria_describedby = "nombre-error" })
                                @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger", id = "nombre-error" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.primerApellido) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.primerApellido, new { @class = "form-control", maxlength = "64", autocomplete = "off", aria_describedby = "primerApellido-error" })
                                @Html.ValidationMessageFor(m => m.primerApellido, "", new { @class = "text-danger", id = "primerApellido-error" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.segundoApellido)
                                @Html.TextBoxFor(m => m.segundoApellido, new { @class = "form-control", maxlength = "64", autocomplete = "off", aria_describedby = "segundoApellido-error" })
                                @Html.ValidationMessageFor(m => m.segundoApellido, "", new { @class = "text-danger", id = "segundoApellido-error" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.gradoAcademico) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(m => m.gradoAcademico, new SelectList(new List<string> { "Doctorado - PhD", "Maestría - MSc", "Licenciatura - Lic", "Bachillerato - Bach" }), "Seleccione su grado académico...", new { @class = "form-control", aria_describedby = "gradoAcademico-error" })
                                @Html.ValidationMessageFor(m => m.gradoAcademico, "", new { @class = "text-danger", id = "gradoAcademico-error" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.tipoIdentificacion) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(m => m.tipoIdentificacion, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoIdentificacion))), "Seleccione su tipo de identificación...", new { @class = "form-control", aria_describedby = "tipoIdentificacion-error" })
                                @Html.ValidationMessageFor(m => m.tipoIdentificacion, "", new { @class = "text-danger", id = "tipoIdentificacion-error" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.numeroIdentificacion) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.numeroIdentificacion, new { @class = "form-control", maxlength = "64", autocomplete = "off", aria_describedby = "numeroIdentificacion-hint numeroIdentificacion-error" })
                                <small id="numeroIdentificacion-hint" class="form-text text-muted">Formato de cédula: 1-1100-1100 (con guiones)</small>
                                @Html.ValidationMessageFor(m => m.numeroIdentificacion, "", new { @class = "text-danger", id = "numeroIdentificacion-error" })
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="editParticipantContactTitle">
                    <header class="create-participant-card-header"><i class="bi bi-envelope" aria-hidden="true"></i><div><h2 id="editParticipantContactTitle">Información de contacto</h2><p>Medios para comunicarse con el participante.</p></div></header>
                    <div class="create-participant-card-body"><div class="create-participant-field-grid">
                        <div class="form-group">
                            @Html.LabelFor(m => m.correo) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.TextBoxFor(m => m.correo, new { @class = "form-control", maxlength = "64", autocomplete = "off", @readonly = "readonly", aria_describedby = "correo-error" })
                            @Html.ValidationMessageFor(m => m.correo, "", new { @class = "text-danger", id = "correo-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.correoAlternativo) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.TextBoxFor(m => m.correoAlternativo, new { @class = "form-control", maxlength = "64", autocomplete = "off", type = "email", aria_describedby = "correoAlternativo-error" })
                            @Html.ValidationMessageFor(m => m.correoAlternativo, "", new { @class = "text-danger", id = "correoAlternativo-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.telefono) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.TextBoxFor(m => m.telefono, new { @class = "form-control", maxlength = "64", minlength = "7", autocomplete = "off", aria_describedby = "telefono-error" })
                            @Html.ValidationMessageFor(m => m.telefono, "", new { @class = "text-danger", id = "telefono-error" })
                        </div>
                    </div></div>
                </section>

                <section class="create-participant-card" aria-labelledby="editParticipantAcademicTitle">
                    <header class="create-participant-card-header"><i class="bi bi-mortarboard" aria-hidden="true"></i><div><h2 id="editParticipantAcademicTitle">Información institucional</h2><p>Clasificación y ubicación académica del participante.</p></div></header>
                    <div class="create-participant-card-body"><div class="create-participant-field-grid">
                        <div class="form-group">
                            @Html.LabelFor(m => m.tipoParticipante) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(m => m.tipoParticipante, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoDeParticipantes)).Cast<webMetics.Models.TipoDeParticipantes>().Select(e => new { Value = e, Text = EnumHelper.GetDisplayName(e) }), "Value", "Text"), "Seleccione un tipo de participante...", new { @class = "form-control", aria_describedby = "tipoParticipante-error" })
                            @Html.ValidationMessageFor(m => m.tipoParticipante, "", new { @class = "text-danger", id = "tipoParticipante-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.area) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(m => m.area, new SelectList(areasDisponibles), "Seleccione un área...", new { @class = "form-control", id = "areaDropdown", aria_describedby = "area-error" })
                            @Html.ValidationMessageFor(m => m.area, "", new { @class = "text-danger", id = "area-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.departamento) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(m => m.departamento, new SelectList(ViewData["jsonDataDepartamentos"] as List<string> ?? new List<string>()), "Seleccione un departamento...", new { @class = "form-control", id = "departamentoDropdown", aria_describedby = "departamento-error" })
                            @Html.ValidationMessageFor(m => m.departamento, "", new { @class = "text-danger", id = "departamento-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.unidadAcademica) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(m => m.unidadAcademica, new SelectList(ViewData["jsonDataUnidadesAcademicas"] as List<string> ?? new List<string>()), "Seleccione una unidad académica...", new { @class = "form-control", id = "seccionDropdown", aria_describedby = "unidadAcademica-error" })
                            @Html.ValidationMessageFor(m => m.unidadAcademica, "", new { @class = "text-danger", id = "unidadAcademica-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.sede) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(m => m.sede, ParticipanteController.GetSedes(), "Seleccione una sede y recinto...", new { @class = "form-control", id = "sedeDropdown", aria_describedby = "sede-error" })
                            @Html.ValidationMessageFor(m => m.sede, "", new { @class = "text-danger", id = "sede-error" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.carrera) <span class="create-participant-required" aria-hidden="true">*</span>
                            <select id="carreraDropdown" class="form-control" aria-describedby="carrera-error"><option value="">Seleccione una carrera...</option></select>
                            <input type="text" id="carreraPersonalizada" class="form-control mt-2 d-none" maxlength="512" placeholder="Escriba el nombre de su carrera" />
                            <small id="carreraFormato" class="form-text text-muted d-none">Se guardará en mayúsculas y sin tildes.</small>
                            <small id="carreraPreview" class="form-text text-muted d-none"></small>
                            @Html.HiddenFor(m => m.carrera)
                            @Html.ValidationMessageFor(m => m.carrera, "", new { @class = "text-danger", id = "carrera-error" })
                        </div>
                    </div></div>
                </section>

                <section class="create-participant-card" aria-labelledby="editParticipantExtraAreasTitle">
                    <header class="create-participant-card-header"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><h2 id="editParticipantExtraAreasTitle">Áreas extra</h2><p>Seleccione otras áreas relacionadas, si corresponde.</p></div></header>
                    <div class="create-participant-card-body">
                        <fieldset class="create-participant-area-fieldset"><legend class="visually-hidden">Áreas extra</legend><small class="form-text text-muted d-block mb-2">Opcional. Debe ser diferente al área principal.</small>
                            @{ int areaIndex = 0; }
                            @foreach (var areaExtra in areasDisponibles)
                            {
                                var checkboxId = $"areaExtra_{areaIndex++}";
                                <div class="form-check"><input class="form-check-input area-extra-checkbox" type="checkbox" name="areasExtra" id="@checkboxId" value="@areaExtra" @(Model?.areasExtra?.Contains(areaExtra, StringComparer.OrdinalIgnoreCase) == true ? "checked" : null) /><label class="form-check-label" for="@checkboxId">@areaExtra</label></div>
                            }
                            @Html.ValidationMessageFor(m => m.areasExtra, "", new { @class = "text-danger", id = "areasExtra-error" })
                        </fieldset>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="editParticipantConditionTitle">
                    <header class="create-participant-card-header"><i class="bi bi-person-check" aria-hidden="true"></i><div><h2 id="editParticipantConditionTitle">Condición institucional</h2><p>Indique la condición actual en la institución.</p></div></header>
                    <div class="create-participant-card-body">
                        <fieldset class="create-participant-condition-fieldset"><legend>@Html.DisplayNameFor(m => m.condicion) <span class="create-participant-required" aria-hidden="true">*</span></legend>
                            <div class="create-participant-condition-grid">
                                @foreach (var condicion in new[] { "Profesor(a) Interino(a)", "Profesor(a) Instructor(a)", "Profesor(a) Adjunto(a)", "Profesor(a) Catedrático(a)", "Profesor(a) Invitado(a)", "Profesor(a) Asociado(a)", "Otro" })
                                {
                                    var condicionId = "condicion_" + Array.IndexOf(new[] { "Profesor(a) Interino(a)", "Profesor(a) Instructor(a)", "Profesor(a) Adjunto(a)", "Profesor(a) Catedrático(a)", "Profesor(a) Invitado(a)", "Profesor(a) Asociado(a)", "Otro" }, condicion);
                                    <div class="form-check">@Html.RadioButtonFor(m => m.condicion, condicion, new { @class = "form-check-input", id = condicionId, aria_describedby = "condicion-error" })<label class="form-check-label" for="@condicionId">@condicion</label></div>
                                }
                            </div>
                            @Html.ValidationMessageFor(m => m.condicion, "", new { @class = "text-danger", id = "condicion-error" })
                        </fieldset>
                    </div>
                </section>
            </div>

            <div class="create-participant-actions">
                <a href="#" class="create-participant-action-button create-participant-action-cancel" onclick="history.go(-1); return false;">Cancelar</a>
                <input type="submit" id="guardarBtn" class="create-participant-action-button create-participant-action-save" value="Guardar" />
            </div>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script type="text/javascript">
    var areasData = {
        carrerasBySeccionAndSede: {}
    };
    var enviandoFormulario = false;
    var estadoInicial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        area = Model?.area ?? string.Empty,
        departamento = Model?.departamento ?? string.Empty,
        unidadAcademica = Model?.unidadAcademica ?? string.Empty,
        sede = Model?.sede ?? string.Empty,
        carrera = Model?.carrera ?? string.Empty
    }));

    function limpiarMensajesValidacion() {
        $('.field-validation-error')
            .text('')
            .removeClass('field-validation-error')
            .addClass('field-validation-valid');

        $('.input-validation-error').removeClass('input-validation-error');
        $('#participanteEditForm [aria-invalid="true"]').removeAttr('aria-invalid');
        $('#participanteEditForm .participant-custom-select').removeClass('has-validation-error');
    }

    function mostrarMensajesValidacion(fieldErrors) {
        if (!fieldErrors) {
            return;
        }

        $.each(fieldErrors, function (fieldName, mensajes) {
            if (!mensajes || mensajes.length === 0) {
                return;
            }

            var mensaje = mensajes[0];
            var $campo = $('[name="' + fieldName + '"]');
            var $mensaje = $('[data-valmsg-for="' + fieldName + '"]');

            if ($campo.length) {
                $campo.addClass('input-validation-error');
            }

            if ($mensaje.length) {
                $mensaje
                    .text(mensaje)
                    .removeClass('field-validation-valid')
                    .addClass('field-validation-error');
            }

            if (fieldName === 'carrera') {
                var $carreraVisible = $('#carreraPersonalizada').is(':visible')
                    ? $('#carreraPersonalizada')
                    : $('#carreraDropdown');
                $carreraVisible.addClass('input-validation-error').attr('aria-invalid', 'true');
                if ($mensaje.attr('id')) $carreraVisible.attr('aria-describedby', $mensaje.attr('id'));
            }

            var $customTrigger = $campo.filter('select').closest('.participant-custom-select').find('.participant-select-trigger');
            if ($customTrigger.length) {
                $customTrigger.addClass('input-validation-error').attr('aria-invalid', 'true');
                $customTrigger.closest('.participant-custom-select').addClass('has-validation-error');
                if ($mensaje.attr('id')) $customTrigger.attr('aria-describedby', $mensaje.attr('id'));
            } else if ($campo.length) {
                $campo.attr('aria-invalid', 'true');
                if ($mensaje.attr('id')) $campo.attr('aria-describedby', $mensaje.attr('id'));
            }
        });

        var $firstInvalid = $('#participanteEditForm .input-validation-error').first();
        if ($firstInvalid.length) {
            if ($firstInvalid.attr('id') === 'carrera') {
                $firstInvalid = $('#carreraPersonalizada').is(':visible') ? $('#carreraPersonalizada') : $('#carreraDropdown');
            } else if ($firstInvalid.is('select')) {
                $firstInvalid = $firstInvalid.closest('.participant-custom-select').find('.participant-select-trigger');
            }
            if ($firstInvalid.length) {
                $firstInvalid[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                $firstInvalid.trigger('focus');
            }
        }
    }

    function limpiarErrorCampo(campo) {
        var nombre = campo.name;
        if (campo.id === 'carreraDropdown' || campo.id === 'carreraPersonalizada') nombre = 'carrera';
        if (!nombre) return;

        var $mensaje = $('#participanteEditForm [data-valmsg-for="' + nombre + '"]');
        var $campo = nombre === 'carrera'
            ? $('#carrera, #carreraDropdown, #carreraPersonalizada')
            : $('#participanteEditForm [name="' + nombre + '"]');
        var valorValido = campo.type === 'radio' || campo.type === 'checkbox'
            ? $campo.is(':checked')
            : $.trim((nombre === 'carrera' ? $('#carrera').val() : $(campo).val()) || '') !== '';

        if (!valorValido) return;
        $mensaje.text('').removeClass('field-validation-error').addClass('field-validation-valid');
        $campo.removeClass('input-validation-error').removeAttr('aria-invalid');
        $campo.closest('.participant-custom-select').removeClass('has-validation-error')
            .find('.participant-select-trigger').removeClass('input-validation-error').removeAttr('aria-invalid');
    }

    function validarRestriccionesLocales() {
        var form = document.getElementById('participanteEditForm');
        var errores = {};

        Array.prototype.forEach.call(form.querySelectorAll('input, textarea, select'), function (campo) {
            if (campo.disabled || campo.readOnly || campo.type === 'hidden' || campo.type === 'radio' || campo.type === 'checkbox') return;
            var valor = (campo.value || '').trim();
            if (!valor) return;

            if (campo.type === 'email' && campo.validity.typeMismatch) {
                errores[campo.name] = [campo.getAttribute('data-val-email') || 'Ingrese un correo electrónico válido.'];
                return;
            }

            var longitudMinima = Number(campo.getAttribute('minlength'));
            if (longitudMinima > 0 && valor.length < longitudMinima) {
                errores[campo.name] = ['El número de teléfono debe tener al menos ' + longitudMinima + ' caracteres.'];
            }
        });

        if (Object.keys(errores).length) {
            mostrarMensajesValidacion(errores);
            return false;
        }
        return true;
    }

    function mostrarErrorGlobal(mensaje) {
        mostrarToastEdicion(mensaje);
    }

    function mostrarToastEdicion(mensaje) {
        var region = document.querySelector('.metics-toast-region');
        if (!region) {
            region = document.createElement('div');
            region.className = 'metics-toast-region';
            region.setAttribute('aria-label', 'Notificaciones');
            document.body.appendChild(region);
        }

        var toast = document.createElement('div');
        toast.className = 'metics-toast metics-toast--error toast fade';
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');
        toast.setAttribute('data-bs-delay', '6750');

        var inner = document.createElement('div');
        inner.className = 'metics-toast-inner';
        var icon = document.createElement('span');
        icon.className = 'metics-toast-icon';
        icon.setAttribute('aria-hidden', 'true');
        var iconElement = document.createElement('i');
        iconElement.className = 'bi bi-exclamation-lg';
        icon.appendChild(iconElement);
        var content = document.createElement('div');
        content.className = 'metics-toast-message';
        var title = document.createElement('strong');
        title.textContent = 'No se pudo completar la operación';
        var detail = document.createElement('p');
        detail.textContent = mensaje;
        content.append(title, detail);
        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'btn-close';
        close.setAttribute('aria-label', 'Cerrar notificación');
        close.addEventListener('click', function () {
            if (window.bootstrap && window.bootstrap.Toast) window.bootstrap.Toast.getOrCreateInstance(toast).hide();
        });
        inner.append(icon, content, close);
        toast.appendChild(inner);
        region.appendChild(toast);
        if (window.bootstrap && window.bootstrap.Toast) window.bootstrap.Toast.getOrCreateInstance(toast).show();
    }

    function resetDepartamentos() {
        $('#departamentoDropdown').empty().append('<option value="">Seleccione un departamento...</option>');
    }

    function resetSecciones() {
        $('#seccionDropdown').empty().append('<option value="">Seleccione una unidad académica...</option>');
    }

    var carrerasActuales = [];

    function normalizarCarrera(valor) {
        return (valor || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toUpperCase()
            .replace(/[^A-Z0-9]+/g, ' ')
            .trim()
            .slice(0, 512);
    }

    // Replica la regla del servidor: si lo escrito calza con una carrera del
    // catálogo devuelve el nombre oficial; si no, devuelve el normalizado.
    function resolverCarrera(valor) {
        var normalizada = normalizarCarrera(valor);
        if (!normalizada) {
            return '';
        }

        for (var i = 0; i < carrerasActuales.length; i++) {
            if (normalizarCarrera(carrerasActuales[i]) === normalizada) {
                return carrerasActuales[i];
            }
        }

        return normalizada;
    }

    function resetCarreras() {
        carrerasActuales = [];
        $('#carreraDropdown').empty().append('<option value="">Seleccione una carrera...</option>');
        $('#carreraPersonalizada').addClass('d-none').val('');
        $('#carreraFormato').addClass('d-none');
        $('#carreraPreview').addClass('d-none').text('');
        $('#carrera').val('');
    }

    var CARRERA_OTRA = '__OTRA__';

    function sincronizarCarrera() {
        var seleccion = $('#carreraDropdown').val();

        if (seleccion !== CARRERA_OTRA) {
            $('#carreraPersonalizada').addClass('d-none').val('');
            $('#carreraFormato').addClass('d-none');
            $('#carreraPreview').addClass('d-none').text('');
            $('#carrera').val(seleccion || '');
            return;
        }

        // La regla de formato se anuncia al activar "Otra", antes de teclear;
        // la vista previa de abajo aparece después, ya con el valor concreto.
        $('#carreraPersonalizada').removeClass('d-none');
        $('#carreraFormato').removeClass('d-none');

        var crudo = $('#carreraPersonalizada').val() || '';
        var resuelta = resolverCarrera(crudo);
        $('#carrera').val(resuelta);

        if (resuelta && resuelta !== crudo.trim()) {
            $('#carreraPreview')
                .removeClass('d-none')
                .text('Se guardará como: ' + resuelta);
        } else {
            $('#carreraPreview').addClass('d-none').text('');
        }
    }

    function actualizarAreasExtraDisponibles() {
        var areaPrincipal = $('#areaDropdown').val();

        $('.area-extra-checkbox').each(function () {
            var esAreaPrincipal = $(this).val() === areaPrincipal;
            $(this).prop('disabled', esAreaPrincipal);

            if (esAreaPrincipal) {
                $(this).prop('checked', false);
            }
        });
    }

    function cargarSecciones(areaName, departamentoName, seccionSeleccionada) {
        resetSecciones();
        resetCarreras();

        if (!areaName || !departamentoName) {
            return $.Deferred().resolve().promise();
        }

        return $.ajax({
            url: '/Participante/GetSeccionesByDepartamento',
            type: 'GET',
            data: {
                areaName: areaName,
                departamentoName: departamentoName
            },
            dataType: 'json',
            success: function (data) {
                $.each(data || [], function (index, value) {
                    $('#seccionDropdown').append('<option value="' + value + '">' + value + '</option>');
                });

                if (seccionSeleccionada) {
                    $('#seccionDropdown').val(seccionSeleccionada);
                }
            },
            error: function (xhr, status, error) {
                mostrarErrorGlobal('Error al cargar las unidades académicas: ' + error);
            }
        });
    }

    function cargarDepartamentos(areaName, departamentoSeleccionado, seccionSeleccionada) {
        resetDepartamentos();
        resetSecciones();
        resetCarreras();

        if (!areaName) {
            return $.Deferred().resolve().promise();
        }

        return $.ajax({
            url: '/Participante/GetDepartamentosByArea',
            type: 'GET',
            data: { areaName: areaName },
            dataType: 'json',
            success: function (data) {
                $.each(data || [], function (index, value) {
                    $('#departamentoDropdown').append('<option value="' + value + '">' + value + '</option>');
                });

                if (departamentoSeleccionado) {
                    $('#departamentoDropdown').val(departamentoSeleccionado);
                }

                if (departamentoSeleccionado) {
                    cargarSecciones(areaName, departamentoSeleccionado, seccionSeleccionada);
                }
            },
            error: function (xhr, status, error) {
                mostrarErrorGlobal('Error al cargar los departamentos: ' + error);
            }
        });
    }

    function setCarreras(carreras, carreraSeleccionada) {
        resetCarreras();
        carrerasActuales = carreras || [];

        $.each(carrerasActuales, function (index, value) {
            $('#carreraDropdown').append('<option value="' + value + '">' + value + '</option>');
        });

        // Always offer a custom option
        $('#carreraDropdown').append('<option value="' + CARRERA_OTRA + '">Otra (no está en la lista)</option>');

        var enLista = carreraSeleccionada &&
            $.grep(carreras || [], function (c) { return c === carreraSeleccionada; }).length > 0;

        if (enLista) {
            $('#carreraDropdown').val(carreraSeleccionada);
        } else if (carreraSeleccionada) {
            // Saved value not in the list → treat as custom
            $('#carreraDropdown').val(CARRERA_OTRA);
            $('#carreraPersonalizada').val(carreraSeleccionada);
        } else if (!carreras || carreras.length === 0) {
            // No careers for this combination → default straight to custom entry
            $('#carreraDropdown').val(CARRERA_OTRA);
        }

        sincronizarCarrera();
    }

    function actualizarCarreras(carreraSeleccionada) {
        var area = $('#areaDropdown').val();
        var departamento = $('#departamentoDropdown').val();
        var seccion = $('#seccionDropdown').val();
        var sede = $('#sedeDropdown').val();

        resetCarreras();

        if (!area || !departamento || !seccion || !sede) {
            return $.Deferred().resolve().promise();
        }

        if (areasData.carrerasBySeccionAndSede[seccion] &&
            areasData.carrerasBySeccionAndSede[seccion][sede]) {
            setCarreras(areasData.carrerasBySeccionAndSede[seccion][sede], carreraSeleccionada);
            return $.Deferred().resolve().promise();
        }

        return $.ajax({
            url: '/Participante/GetCarrerasBySeccionAndSede',
            type: 'GET',
            data: {
                areaName: area,
                departamentoName: departamento,
                unidadAcademica: seccion,
                sede: sede
            },
            dataType: 'json',
            success: function (carreras) {
                if (!areasData.carrerasBySeccionAndSede[seccion]) {
                    areasData.carrerasBySeccionAndSede[seccion] = {};
                }

                areasData.carrerasBySeccionAndSede[seccion][sede] = carreras || [];
                setCarreras(carreras, carreraSeleccionada);
            },
            error: function () {
                mostrarErrorGlobal('Error al cargar las carreras.');
            }
        });
    }

    $(document).ready(function () {
        var $form = $('#participanteEditForm');
        var $submitButton = $form.find('input[type="submit"]');
        var submitLabel = $submitButton.val();

        if (estadoInicial.area) {
            $('#areaDropdown').val(estadoInicial.area);
        }

        if (estadoInicial.departamento) {
            $('#departamentoDropdown').val(estadoInicial.departamento);
        }

        if (estadoInicial.unidadAcademica) {
            $('#seccionDropdown').val(estadoInicial.unidadAcademica);
        }

        if (estadoInicial.sede) {
            $('#sedeDropdown').val(estadoInicial.sede);
        }

        actualizarCarreras(estadoInicial.carrera);
        actualizarAreasExtraDisponibles();

        $('#areaDropdown').on('change', function () {
            var areaName = $(this).val();
            cargarDepartamentos(areaName, null, null);
            actualizarAreasExtraDisponibles();
        });

        $('#departamentoDropdown').on('change', function () {
            var areaName = $('#areaDropdown').val();
            var departamentoName = $(this).val();
            cargarSecciones(areaName, departamentoName, null);
        });

        $('#seccionDropdown, #sedeDropdown').on('change', function () {
            actualizarCarreras(null);
        });

        $('#carreraDropdown').on('change', sincronizarCarrera);
        $('#carreraPersonalizada').on('input', sincronizarCarrera);
        $form.on('input change', ':input', function () {
            limpiarErrorCampo(this);
        });

        $form.on('submit', function (event) {
            event.preventDefault();

            if (enviandoFormulario) {
                return;
            }

            limpiarMensajesValidacion();
            if (!validarRestriccionesLocales()) return;

            enviandoFormulario = true;
            $submitButton.prop('disabled', true).val('Guardando...');

            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (response) {
                    if (response && response.success && response.redirectUrl) {
                        window.location.href = response.redirectUrl;
                        return;
                    }

                    var tieneFieldErrors = response && response.fieldErrors && Object.keys(response.fieldErrors).length > 0;
                    var tieneGlobalErrors = response && response.globalErrors && response.globalErrors.length > 0;

                    if (tieneFieldErrors) {
                        mostrarMensajesValidacion(response.fieldErrors);
                    } else if (tieneGlobalErrors) {
                        mostrarToastEdicion(response.globalErrors.join(' '));
                    }
                },
                error: function (xhr) {
                    var response = xhr.responseJSON || {};
                    var tieneFieldErrors = response.fieldErrors && Object.keys(response.fieldErrors).length > 0;
                    var tieneGlobalErrors = response.globalErrors && response.globalErrors.length > 0;

                    if (tieneFieldErrors) {
                        mostrarMensajesValidacion(response.fieldErrors);
                    } else if (tieneGlobalErrors) {
                        mostrarToastEdicion(response.globalErrors.join(' '));
                    } else {
                        mostrarToastEdicion(response.message || 'Ocurrió un error inesperado.');
                    }
                },
                complete: function () {
                    enviandoFormulario = false;
                    $submitButton.prop('disabled', false).val(submitLabel);
                }
            });
        });
    });
</script>
<script src="~/js/participant-custom-select.js" asp-append-version="true"></script>
