@model webMetics.Models.ParticipanteModel
@using webMetics.Controllers
@using webMetics.Helpers
@{
    ViewBag.Title = "Formulario de Participante";
    PageHeadingBuilder.Configure(ViewContext, Url);

    var areasDisponibles = (ViewData["jsonDataAreas"] as List<string> ?? new List<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(a => a)
        .ToList();
}

@if (ViewBag.Title == "Formulario de Participante")
{
    <div class="contenedor-caja container-fluid create-participant-page table-page-with-divider">

        @using (Html.BeginForm("FormularioParticipante", "Participante", FormMethod.Post, new { enctype = "multipart/form-data", id = "participanteCreateForm" }))
        {
            @Html.AntiForgeryToken()
            <h1 metics-page-heading>@ViewBag.Title</h1>
            <hr metics-page-heading />

            if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-dark alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.ErrorMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-2" role="alert">
                    <span>@ViewBag.SuccessMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="create-participant-sections">
                <section class="create-participant-card" aria-labelledby="participantPersonalTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                        <div><h2 id="participantPersonalTitle">Información personal</h2><p>Datos de identificación del participante.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <div class="create-participant-field-grid">
                            <div class="form-group create-participant-full-field">
                                @Html.LabelFor(participanteModel => participanteModel.nombre) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(participanteModel => participanteModel.nombre, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.nombre, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.primerApellido) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(participanteModel => participanteModel.primerApellido, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.primerApellido, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.segundoApellido)
                                @Html.TextBoxFor(participanteModel => participanteModel.segundoApellido, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.segundoApellido, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.gradoAcademico) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(participanteModel => participanteModel.gradoAcademico, new SelectList(new List<string> 
                            { 
                                "Doctorado - PhD", 
                                "Maestría - MSc", 
                                "Licenciatura - Lic", 
                                "Bachillerato - Bach" 
                            }), "Seleccione su grado académico...", new { @class = "form-control" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.gradoAcademico, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.tipoIdentificacion) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.DropDownListFor(participanteModel => participanteModel.tipoIdentificacion, new SelectList(Enum.GetValues(typeof(webMetics.Models.TipoIdentificacion))), "Seleccione su tipo de identificación...", new { @class = "form-control" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.tipoIdentificacion, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(usuarioModel => usuarioModel.numeroIdentificacion) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(usuarioModel => usuarioModel.numeroIdentificacion, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(usuarioModel => usuarioModel.numeroIdentificacion, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">
                                    Formato de cédula: 1-1100-1100 (con guiones)
                                </small>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="participantContactTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <div><h2 id="participantContactTitle">Información de contacto</h2><p>Medios para comunicarse con el participante.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <div class="create-participant-field-grid">
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.correo) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(participanteModel => participanteModel.correo, new { @class = "form-control", @maxlength = "64", @autocomplete = "off" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.correo, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.correoAlternativo) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(participanteModel => participanteModel.correoAlternativo, new { @class = "form-control", @maxlength = "64", @autocomplete = "off", @type = "email" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.correoAlternativo, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.telefono) <span class="create-participant-required" aria-hidden="true">*</span>
                                @Html.TextBoxFor(participanteModel => participanteModel.telefono, new { @class = "form-control", @maxlength = "64", @minlength = "7", @autocomplete = "off" })
                                @Html.ValidationMessageFor(participanteModel => participanteModel.telefono, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="participantAcademicTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-mortarboard" aria-hidden="true"></i>
                        <div><h2 id="participantAcademicTitle">Información institucional</h2><p>Clasificación y ubicación académica del participante.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <div class="create-participant-field-grid">
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.tipoParticipante) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(
                                     usuarioModel => usuarioModel.tipoParticipante,
                                     new SelectList(
                                     Enum.GetValues(typeof(webMetics.Models.TipoDeParticipantes))
                                     .Cast<webMetics.Models.TipoDeParticipantes>()
                                     .Select(e => new { Value = e, Text = EnumHelper.GetDisplayName(e) }),
                                     "Value",
                                     "Text"),
                                     "Seleccione un tipo de participante...",
                                     new { @class = "form-control" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.tipoParticipante, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.area) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(participanteModel => participanteModel.area, new SelectList(ViewData["jsonDataAreas"] as List<string>), "Seleccione un área...", new { @class = "form-control", id = "areaDropdown" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.area, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.departamento) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(participanteModel => participanteModel.departamento, new SelectList(Enumerable.Empty<SelectListItem>()), "Seleccione un departamento...", new { @class = "form-control", id = "departamentoDropdown" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.departamento, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.unidadAcademica) <span class="create-participant-required" aria-hidden="true">*</span>
                            @Html.DropDownListFor(participanteModel => participanteModel.unidadAcademica, new SelectList(Enumerable.Empty<SelectListItem>()), "Seleccione una unidad académica...", new { @class = "form-control", id = "seccionDropdown" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.unidadAcademica, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.sede) <span class="create-participant-required" aria-hidden="true">*</span>
                    @Html.DropDownListFor(participanteModel => participanteModel.sede, webMetics.Controllers.ParticipanteController.GetSedes(), "Seleccione una sede y recinto...", new { @class = "form-control", id = "sedeDropdown" })
                            @Html.ValidationMessageFor(participanteModel => participanteModel.sede, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(participanteModel => participanteModel.carrera) <span class="create-participant-required" aria-hidden="true">*</span>
                            <select id="carreraDropdown" class="form-control">
                                <option value="">Seleccione una carrera...</option>
                            </select>
                            <input type="text" id="carreraPersonalizada" class="form-control mt-2 d-none"
                                   maxlength="512" placeholder="Escriba el nombre de su carrera" />
                            <small id="carreraFormato" class="form-text text-muted d-none">
                                Se guardará en mayúsculas y sin tildes.
                            </small>
                            <small id="carreraPreview" class="form-text text-muted d-none"></small>
                            @Html.HiddenFor(participanteModel => participanteModel.carrera)
                            @Html.ValidationMessageFor(participanteModel => participanteModel.carrera, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="participantExtraAreasTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i>
                        <div><h2 id="participantExtraAreasTitle">Áreas extra</h2><p>Seleccione otras áreas relacionadas, si corresponde.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <fieldset class="create-participant-area-fieldset">
                            <legend class="visually-hidden">Áreas extra</legend>
                            <small class="form-text text-muted d-block mb-2">Opcional. Debe ser diferente al área principal.</small>
                                @{ int areaIndex = 0; }
                                @foreach (var areaExtra in areasDisponibles)
                                {
                                    var checkboxId = $"areaExtra_{areaIndex++}";
                                    <div class="form-check">
                                        <input
                                            class="form-check-input area-extra-checkbox"
                                            type="checkbox"
                                            name="areasExtra"
                                            id="@checkboxId"
                                            value="@areaExtra"
                                            @(Model?.areasExtra?.Contains(areaExtra, StringComparer.OrdinalIgnoreCase) == true ? "checked" : null) />
                                        <label class="form-check-label" for="@checkboxId">@areaExtra</label>
                                    </div>
                                }

                                @Html.ValidationMessageFor(participanteModel => participanteModel.areasExtra, "", new { @class = "text-danger" })
                        </fieldset>
                    </div>
                </section>

                <section class="create-participant-card" aria-labelledby="participantConditionTitle">
                    <header class="create-participant-card-header">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        <div><h2 id="participantConditionTitle">Condición institucional</h2><p>Indique la condición actual en la institución.</p></div>
                    </header>
                    <div class="create-participant-card-body">
                        <fieldset class="create-participant-condition-fieldset">
                            <legend>@Html.DisplayNameFor(participanteModel => participanteModel.condicion) <span class="create-participant-required" aria-hidden="true">*</span></legend>
                            
                            <div class="create-participant-condition-grid">
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Interino(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Interino(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Instructor(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Instructor(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Adjunto(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Adjunto(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Catedrático(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Catedrático(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Invitado(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Invitado(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Profesor(a) Asociado(a)", new { @class = "form-check-input" }) <span class="form-check-label">Profesor(a) Asociado(a)</span></label>
                                <label class="form-check">@Html.RadioButtonFor(participanteModel => participanteModel.condicion, "Otro", new { @class = "form-check-input" }) <span class="form-check-label">Otro</span></label>
                            </div>
                            @Html.ValidationMessageFor(participanteModel => participanteModel.condicion, "", new { @class = "text-danger" })
                        </fieldset>
                    </div>
                </section>
            </div>

            <div class="create-participant-actions">
                <a href="#" class="create-participant-action-button create-participant-action-cancel" onclick="history.go(-1); return false;">Cancelar</a>
                <input type="submit" id="guardarBtn" class="create-participant-action-button create-participant-action-save" value="Guardar" />
            </div>
        }
    </div>
}
else
{
    <script>
        window.location.href = '@Url.Action("CerrarSesion", "Usuario")';
    </script>
}

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.js"></script>
<script type="text/javascript">
    var areasData = null;
    var enviandoFormulario = false;
    var estadoInicial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        area = Model?.area ?? string.Empty,
        departamento = Model?.departamento ?? string.Empty,
        unidadAcademica = Model?.unidadAcademica ?? string.Empty,
        sede = Model?.sede ?? string.Empty,
        carrera = Model?.carrera ?? string.Empty
    }));

    function limpiarMensajesValidacion() {
        $('.field-validation-error')
            .text('')
            .removeClass('field-validation-error')
            .addClass('field-validation-valid');

        $('.input-validation-error').removeClass('input-validation-error');
        $('.participant-select-trigger').removeClass('input-validation-error').removeAttr('aria-invalid');
        $('.participant-custom-select').removeClass('has-validation-error');
        ocultarPopoverGuardar();
    }

    function mostrarMensajesValidacion(fieldErrors) {
        if (!fieldErrors) {
            return;
        }

        $.each(fieldErrors, function (fieldName, mensajes) {
            if (!mensajes || mensajes.length === 0) {
                return;
            }

            var mensaje = mensajes[0];
            var $campo = $('[name="' + fieldName + '"]');
            var $mensaje = $('[data-valmsg-for="' + fieldName + '"]');

            if ($campo.length) {
                $campo.addClass('input-validation-error');
                var $selectorPersonalizado = $campo.closest('.participant-custom-select');
                if ($selectorPersonalizado.length) {
                    $selectorPersonalizado.addClass('has-validation-error');
                    $selectorPersonalizado.find('.participant-select-trigger')
                        .addClass('input-validation-error')
                        .attr('aria-invalid', 'true');
                }
            }

            if ($mensaje.length) {
                $mensaje
                    .text(mensaje)
                    .removeClass('field-validation-valid')
                    .addClass('field-validation-error');
            }
        });
    }

    function mostrarErrorGlobal(mensaje) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: mensaje
        });
    }

    var guardarPopover = null;

    function escaparHtml(texto) {
        return $('<div>').text(texto).html();
    }

    function mostrarPopoverGuardar(mensaje) {
        if (guardarPopover) {
            guardarPopover.dispose();
        }
        $(document).off('click.guardarPopover');
        guardarPopover = new bootstrap.Popover(document.getElementById('guardarBtn'), {
            title: '<i class="bi bi-exclamation-circle-fill text-danger me-1"></i> Error',
            content: '<span style="font-size:1.3em">' + escaparHtml(mensaje) + '</span>',
            placement: 'right',
            trigger: 'manual',
            html: true,
            allowList: Object.assign({}, bootstrap.Popover.Default.allowList, {
                span: ['style']
            })
        });
        var scrollX = window.pageXOffset;
        var scrollY = window.pageYOffset;
        guardarPopover.show();
        window.scrollTo(scrollX, scrollY);
        $(document).on('click.guardarPopover', function (e) {
            var $popover = $('.popover');
            if (!$popover.is(e.target) && $popover.has(e.target).length === 0 &&
                !$('#guardarBtn').is(e.target)) {
                ocultarPopoverGuardar();
            }
        });
    }

    function ocultarPopoverGuardar() {
        $(document).off('click.guardarPopover');
        if (guardarPopover) {
            guardarPopover.hide();
        }
    }

    function resetDepartamentos() {
        $('#departamentoDropdown').empty().append('<option value="">Seleccione un departamento...</option>');
    }

    function resetSecciones() {
        $('#seccionDropdown').empty().append('<option value="">Seleccione una unidad académica...</option>');
    }

    var carrerasActuales = [];

    function normalizarCarrera(valor) {
        return (valor || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toUpperCase()
            .replace(/[^A-Z0-9]+/g, ' ')
            .trim()
            .slice(0, 512);
    }

    // Replica la regla del servidor: si lo escrito calza con una carrera del
    // catálogo devuelve el nombre oficial; si no, devuelve el normalizado.
    function resolverCarrera(valor) {
        var normalizada = normalizarCarrera(valor);
        if (!normalizada) {
            return '';
        }

        for (var i = 0; i < carrerasActuales.length; i++) {
            if (normalizarCarrera(carrerasActuales[i]) === normalizada) {
                return carrerasActuales[i];
            }
        }

        return normalizada;
    }

    function resetCarreras() {
        carrerasActuales = [];
        $('#carreraDropdown').empty().append('<option value="">Seleccione una carrera...</option>');
        $('#carreraPersonalizada').addClass('d-none').val('');
        $('#carreraFormato').addClass('d-none');
        $('#carreraPreview').addClass('d-none').text('');
        $('#carrera').val('');
    }

    var CARRERA_OTRA = '__OTRA__';

    function sincronizarCarrera() {
        var seleccion = $('#carreraDropdown').val();

        if (seleccion !== CARRERA_OTRA) {
            $('#carreraPersonalizada').addClass('d-none').val('');
            $('#carreraFormato').addClass('d-none');
            $('#carreraPreview').addClass('d-none').text('');
            $('#carrera').val(seleccion || '');
            return;
        }

        // La regla de formato se anuncia al activar "Otra", antes de teclear;
        // la vista previa de abajo aparece después, ya con el valor concreto.
        $('#carreraPersonalizada').removeClass('d-none');
        $('#carreraFormato').removeClass('d-none');

        var crudo = $('#carreraPersonalizada').val() || '';
        var resuelta = resolverCarrera(crudo);
        $('#carrera').val(resuelta);

        if (resuelta && resuelta !== crudo.trim()) {
            $('#carreraPreview')
                .removeClass('d-none')
                .text('Se guardará como: ' + resuelta);
        } else {
            $('#carreraPreview').addClass('d-none').text('');
        }
    }

    function actualizarAreasExtraDisponibles() {
        var areaPrincipal = $('#areaDropdown').val();

        $('.area-extra-checkbox').each(function () {
            var esAreaPrincipal = $(this).val() === areaPrincipal;
            $(this).prop('disabled', esAreaPrincipal);

            if (esAreaPrincipal) {
                $(this).prop('checked', false);
            }
        });
    }

    function cargarDepartamentos(areaName, departamentoSeleccionado) {
        resetDepartamentos();
        resetSecciones();
        resetCarreras();

        if (!areaName || !areasData || !areasData.departamentosByArea || !areasData.departamentosByArea[areaName]) {
            return;
        }

        var departamentos = areasData.departamentosByArea[areaName];
        $.each(departamentos, function (index, value) {
            $('#departamentoDropdown').append('<option value="' + value + '">' + value + '</option>');
        });

        if (departamentoSeleccionado) {
            $('#departamentoDropdown').val(departamentoSeleccionado);
        }
    }

    function cargarSecciones(areaName, departamentoName, seccionSeleccionada) {
        resetSecciones();
        resetCarreras();

        if (!areaName || !departamentoName || !areasData || !areasData.seccionesByDepartamento) {
            return;
        }

        var key = areaName + '|' + departamentoName;
        var secciones = areasData.seccionesByDepartamento[key];

        if (!secciones) {
            return;
        }

        $.each(secciones, function (index, value) {
            $('#seccionDropdown').append('<option value="' + value + '">' + value + '</option>');
        });

        if (seccionSeleccionada) {
            $('#seccionDropdown').val(seccionSeleccionada);
        }
    }

    function setCarreras(carreras, carreraSeleccionada) {
        resetCarreras();
        carrerasActuales = carreras || [];

        $.each(carrerasActuales, function (index, value) {
            $('#carreraDropdown').append('<option value="' + value + '">' + value + '</option>');
        });

        // Always offer a custom option
        $('#carreraDropdown').append('<option value="' + CARRERA_OTRA + '">Otra (no está en la lista)</option>');

        var enLista = carreraSeleccionada &&
            $.grep(carreras || [], function (c) { return c === carreraSeleccionada; }).length > 0;

        if (enLista) {
            $('#carreraDropdown').val(carreraSeleccionada);
        } else if (carreraSeleccionada) {
            // Saved value not in the list → treat as custom
            $('#carreraDropdown').val(CARRERA_OTRA);
            $('#carreraPersonalizada').val(carreraSeleccionada);
        } else if (!carreras || carreras.length === 0) {
            // No careers for this combination → default straight to custom entry
            $('#carreraDropdown').val(CARRERA_OTRA);
        }

        sincronizarCarrera();
    }

    function actualizarCarreras(carreraSeleccionada) {
        var area = $('#areaDropdown').val();
        var departamento = $('#departamentoDropdown').val();
        var seccion = $('#seccionDropdown').val();
        var sede = $('#sedeDropdown').val();

        resetCarreras();

        if (!area || !departamento || !seccion || !sede) {
            return $.Deferred().resolve().promise();
        }

        if (areasData &&
            areasData.carrerasBySeccionAndSede &&
            areasData.carrerasBySeccionAndSede[seccion] &&
            areasData.carrerasBySeccionAndSede[seccion][sede]) {

            setCarreras(areasData.carrerasBySeccionAndSede[seccion][sede], carreraSeleccionada);
            return $.Deferred().resolve().promise();
        }

        return $.ajax({
            url: '/Participante/GetCarrerasBySeccionAndSede',
            type: 'GET',
            data: {
                areaName: area,
                departamentoName: departamento,
                unidadAcademica: seccion,
                sede: sede
            },
            dataType: 'json',
            success: function (carreras) {
                if (!areasData.carrerasBySeccionAndSede) {
                    areasData.carrerasBySeccionAndSede = {};
                }

                if (!areasData.carrerasBySeccionAndSede[seccion]) {
                    areasData.carrerasBySeccionAndSede[seccion] = {};
                }

                areasData.carrerasBySeccionAndSede[seccion][sede] = carreras || [];
                setCarreras(carreras, carreraSeleccionada);
            },
            error: function () {
                mostrarErrorGlobal('Error al cargar las carreras.');
            }
        });
    }

    // Mejora visual accesible que conserva los <select> originales para el envío
    // y para los cambios dependientes de área, unidad, sede y carrera.
    var participanteSelectInstances = [];

    function sincronizarSelectoresParticipante() {
        participanteSelectInstances.forEach(function (instance) { instance.syncFromNative(); });
    }

    function inicializarSelectoresParticipante() {
        var selects = Array.prototype.slice.call(
            document.querySelectorAll('.create-participant-page select:not([hidden])')
        );

        function cerrarOtros(excepto) {
            participanteSelectInstances.forEach(function (instance) {
                if (instance !== excepto) instance.close(false);
            });
        }

        selects.forEach(function (select, index) {
            if (select.dataset.participantSelectReady === 'true') return;

            var baseId = select.id || select.name || ('participantSelect' + index);
            var wrapper = document.createElement('div');
            wrapper.className = 'participant-custom-select';
            select.parentNode.insertBefore(wrapper, select);
            wrapper.appendChild(select);
            select.classList.add('participant-native-select');
            select.setAttribute('aria-hidden', 'true');
            select.setAttribute('tabindex', '-1');
            select.dataset.participantSelectReady = 'true';

            var trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.id = baseId + 'ParticipantTrigger';
            trigger.className = 'participant-select-trigger';
            trigger.setAttribute('role', 'combobox');
            trigger.setAttribute('aria-haspopup', 'listbox');
            trigger.setAttribute('aria-expanded', 'false');
            trigger.setAttribute('aria-controls', baseId + 'ParticipantListbox');

            var value = document.createElement('span');
            value.className = 'participant-select-value';
            var arrow = document.createElement('span');
            arrow.className = 'participant-select-arrow';
            arrow.setAttribute('aria-hidden', 'true');
            trigger.appendChild(value);
            trigger.appendChild(arrow);

            var panel = document.createElement('div');
            panel.id = baseId + 'ParticipantListbox';
            panel.className = 'participant-select-panel';
            panel.setAttribute('role', 'listbox');
            panel.hidden = true;

            var field = select.closest('.form-group');
            var label = field ? field.querySelector('label') : null;
            var validationMessage = field
                ? field.querySelector('[data-valmsg-for="' + select.name + '"]')
                : null;
            if (label) {
                if (!label.id) label.id = baseId + 'ParticipantLabel';
                trigger.setAttribute('aria-labelledby', label.id);
                label.addEventListener('click', function (event) {
                    event.preventDefault();
                    if (!trigger.disabled) {
                        trigger.focus();
                        toggle();
                    }
                });
            } else {
                trigger.setAttribute('aria-label', select.name || 'Seleccionar una opción');
            }

            wrapper.appendChild(trigger);
            wrapper.appendChild(panel);

            var rows = [];
            var activeIndex = -1;
            var isOpen = false;
            var typeAheadBuffer = '';
            var typeAheadTimer = null;

            function renderOptions() {
                panel.replaceChildren();
                rows = [];
                Array.prototype.forEach.call(select.options, function (option, optionIndex) {
                    var row = document.createElement('div');
                    row.id = panel.id + 'Option' + optionIndex;
                    row.className = 'participant-select-option';
                    row.setAttribute('role', 'option');
                    row.setAttribute('aria-selected', option.selected ? 'true' : 'false');
                    row.setAttribute('aria-disabled', option.disabled ? 'true' : 'false');
                    row.textContent = option.text;
                    if (option.selected) row.classList.add('is-selected');
                    row.addEventListener('mouseenter', function () {
                        if (!option.disabled) setActive(optionIndex, false);
                    });
                    row.addEventListener('mousedown', function (event) { event.preventDefault(); });
                    row.addEventListener('click', function () {
                        if (!option.disabled) choose(optionIndex);
                    });
                    panel.appendChild(row);
                    rows.push(row);
                });
            }

            function syncDisabled() {
                trigger.disabled = select.disabled;
                trigger.setAttribute('aria-disabled', select.disabled ? 'true' : 'false');
                if (select.disabled) close(false);
            }

            function syncFromNative() {
                renderOptions();
                var selected = select.options[select.selectedIndex];
                value.textContent = selected ? selected.text : '';
                rows.forEach(function (row, rowIndex) {
                    var isSelected = rowIndex === select.selectedIndex;
                    row.classList.toggle('is-selected', isSelected);
                    row.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                });
                if (select.value !== '' && validationMessage) {
                    validationMessage.textContent = '';
                    validationMessage.classList.remove('field-validation-error');
                    validationMessage.classList.add('field-validation-valid');
                    trigger.classList.remove('input-validation-error');
                    trigger.removeAttribute('aria-invalid');
                    wrapper.classList.remove('has-validation-error');
                } else if (validationMessage && validationMessage.textContent.trim()) {
                    trigger.classList.add('input-validation-error');
                    trigger.setAttribute('aria-invalid', 'true');
                    wrapper.classList.add('has-validation-error');
                }
                syncDisabled();
            }

            function setActive(optionIndex, scroll) {
                if (optionIndex < 0 || optionIndex >= rows.length || select.options[optionIndex].disabled) return;
                activeIndex = optionIndex;
                rows.forEach(function (row, rowIndex) { row.classList.toggle('is-active', rowIndex === activeIndex); });
                trigger.setAttribute('aria-activedescendant', rows[activeIndex].id);
                if (scroll) rows[activeIndex].scrollIntoView({ block: 'nearest' });
            }

            function firstEnabled(start, step) {
                var optionIndex = start;
                while (optionIndex >= 0 && optionIndex < select.options.length) {
                    if (!select.options[optionIndex].disabled) return optionIndex;
                    optionIndex += step;
                }
                return -1;
            }

            function open() {
                if (trigger.disabled || isOpen) return;
                cerrarOtros(instance);
                syncFromNative();
                panel.hidden = false;
                wrapper.classList.add('is-open');
                var card = wrapper.closest('.create-participant-card');
                if (card) card.classList.add('participant-card-select-open');
                trigger.setAttribute('aria-expanded', 'true');
                isOpen = true;

                var rect = trigger.getBoundingClientRect();
                var panelHeight = Math.min(panel.scrollHeight, window.innerHeight - 24);
                var roomBelow = window.innerHeight - rect.bottom;
                wrapper.classList.toggle('is-open-above', roomBelow < panelHeight + 14 && rect.top > panelHeight + 14);
                var selectedIndex = select.selectedIndex;
                if (selectedIndex < 0 || select.options[selectedIndex].disabled) selectedIndex = firstEnabled(0, 1);
                if (selectedIndex >= 0) setActive(selectedIndex, true);
            }

            function close(returnFocus) {
                if (!isOpen) return;
                panel.hidden = true;
                wrapper.classList.remove('is-open', 'is-open-above');
                var card = wrapper.closest('.create-participant-card');
                if (card) card.classList.remove('participant-card-select-open');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.removeAttribute('aria-activedescendant');
                isOpen = false;
                activeIndex = -1;
                if (returnFocus) trigger.focus();
            }

            function choose(optionIndex) {
                if (optionIndex < 0 || optionIndex >= select.options.length || select.options[optionIndex].disabled) return;
                if (select.selectedIndex !== optionIndex) {
                    select.selectedIndex = optionIndex;
                    select.dispatchEvent(new Event('input', { bubbles: true }));
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                }
                syncFromNative();
                close(true);
            }

            function toggle() { if (isOpen) close(false); else open(); }

            function moveActive(step) {
                var start = activeIndex < 0 ? (step > 0 ? -1 : select.options.length) : activeIndex;
                var next = firstEnabled(start + step, step);
                if (next >= 0) setActive(next, true);
            }

            function searchByTyping(character) {
                var normalized = character.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                var repeated = typeAheadBuffer && Array.from(typeAheadBuffer).every(function (letter) { return letter === normalized; });
                typeAheadBuffer = repeated ? normalized : typeAheadBuffer + normalized;
                window.clearTimeout(typeAheadTimer);
                typeAheadTimer = window.setTimeout(function () { typeAheadBuffer = ''; }, 800);

                var start = select.selectedIndex;
                for (var offset = 1; offset <= select.options.length; offset++) {
                    var optionIndex = (start + offset + select.options.length) % select.options.length;
                    var option = select.options[optionIndex];
                    var text = option.text.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
                    if (!option.disabled && option.value !== '' && text.startsWith(typeAheadBuffer)) {
                        choose(optionIndex);
                        return;
                    }
                }
                if (typeAheadBuffer !== normalized) {
                    typeAheadBuffer = normalized;
                    searchByTyping(character);
                }
            }

            var instance = { select: select, close: close, syncFromNative: syncFromNative };
            participanteSelectInstances.push(instance);
            trigger.addEventListener('click', toggle);
            trigger.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') { if (isOpen) { event.preventDefault(); close(true); } return; }
                if (event.key === 'Tab') { close(false); return; }
                if (event.key.length === 1 && event.key.trim() && !event.ctrlKey && !event.altKey && !event.metaKey) {
                    event.preventDefault();
                    searchByTyping(event.key);
                    return;
                }
                if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' '].indexOf(event.key) === -1) return;
                event.preventDefault();
                if (!isOpen) {
                    open();
                    if (event.key === 'ArrowDown') setActive(firstEnabled(select.selectedIndex + 1, 1), true);
                    if (event.key === 'ArrowUp') setActive(firstEnabled(select.selectedIndex - 1, -1), true);
                } else if (event.key === 'ArrowDown') moveActive(1);
                else if (event.key === 'ArrowUp') moveActive(-1);
                else if (event.key === 'Home') setActive(firstEnabled(0, 1), true);
                else if (event.key === 'End') setActive(firstEnabled(select.options.length - 1, -1), true);
                else if (activeIndex >= 0) choose(activeIndex);
            });

            select.addEventListener('change', syncFromNative);
            var observer = new MutationObserver(syncFromNative);
            observer.observe(select, { childList: true, subtree: true, attributes: true, attributeFilter: ['disabled'] });
            syncFromNative();
        });

        document.addEventListener('pointerdown', function (event) {
            participanteSelectInstances.forEach(function (instance) {
                if (!instance.select.closest('.participant-custom-select').contains(event.target)) instance.close(false);
            });
        });
        document.addEventListener('focusin', function (event) {
            participanteSelectInstances.forEach(function (instance) {
                if (!instance.select.closest('.participant-custom-select').contains(event.target)) instance.close(false);
            });
        });
    }

    function rehidratarFormularioInicial() {
        if (!estadoInicial.area) {
            actualizarAreasExtraDisponibles();
            return;
        }

        $('#areaDropdown').val(estadoInicial.area);
        cargarDepartamentos(estadoInicial.area, estadoInicial.departamento);
        cargarSecciones(estadoInicial.area, estadoInicial.departamento, estadoInicial.unidadAcademica);

        if (estadoInicial.sede) {
            $('#sedeDropdown').val(estadoInicial.sede);
        }

        actualizarCarreras(estadoInicial.carrera);
        actualizarAreasExtraDisponibles();
        sincronizarSelectoresParticipante();
    }

    $(document).ready(function () {
        inicializarSelectoresParticipante();
        var $form = $('#participanteCreateForm');
        var $submitButton = $form.find('input[type="submit"]');
        var submitLabel = $submitButton.val();

        $('#areaDropdown, #departamentoDropdown').prop('disabled', true);

        $.ajax({
            url: '/Participante/GetAllAreasData',
            type: 'GET',
            cache: true,
            dataType: 'json',
            success: function (data) {
                areasData = data || {};
                $('#areaDropdown, #departamentoDropdown').prop('disabled', false);
                rehidratarFormularioInicial();
            },
            error: function (xhr, status, error) {
                $('#areaDropdown, #departamentoDropdown').prop('disabled', false);
                mostrarErrorGlobal('Error al cargar la información del formulario: ' + error);
            }
        });

        $('#areaDropdown').on('change', function () {
            var areaName = $(this).val();
            cargarDepartamentos(areaName, null);
            actualizarAreasExtraDisponibles();
        });

        $('#departamentoDropdown').on('change', function () {
            var areaName = $('#areaDropdown').val();
            var departamentoName = $(this).val();
            cargarSecciones(areaName, departamentoName, null);
        });

        $('#seccionDropdown, #sedeDropdown').on('change', function () {
            actualizarCarreras(null);
        });

        $('#carreraDropdown').on('change', sincronizarCarrera);
        $('#carreraPersonalizada').on('input', sincronizarCarrera);

        $form.on('submit', function (event) {
            event.preventDefault();

            if (enviandoFormulario) {
                return;
            }

            enviandoFormulario = true;
            limpiarMensajesValidacion();
            $submitButton.prop('disabled', true).val('Guardando...');

            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (response) {
                    if (response && response.success && response.redirectUrl) {
                        window.location.href = response.redirectUrl;
                        return;
                    }

                    var tieneFieldErrors = response && response.fieldErrors && Object.keys(response.fieldErrors).length > 0;
                    var tieneGlobalErrors = response && response.globalErrors && response.globalErrors.length > 0;

                    if (tieneFieldErrors) {
                        mostrarMensajesValidacion(response.fieldErrors);
                        mostrarPopoverGuardar('Por favor, revise los campos marcados en rojo.');
                    } else if (tieneGlobalErrors) {
                        mostrarPopoverGuardar(response.globalErrors.join(' '));
                    }
                },
                error: function (xhr) {
                    var response = xhr.responseJSON || {};
                    var tieneFieldErrors = response.fieldErrors && Object.keys(response.fieldErrors).length > 0;
                    var tieneGlobalErrors = response.globalErrors && response.globalErrors.length > 0;

                    if (tieneFieldErrors) {
                        mostrarMensajesValidacion(response.fieldErrors);
                        mostrarPopoverGuardar('Por favor, revise los campos marcados en rojo.');
                    } else if (tieneGlobalErrors) {
                        mostrarPopoverGuardar(response.globalErrors.join(' '));
                    } else {
                        mostrarPopoverGuardar(response.message || 'Ocurrió un error inesperado.');
                    }
                },
                complete: function () {
                    enviandoFormulario = false;
                    $submitButton.prop('disabled', false).val(submitLabel);
                }
            });
        });
    });
</script>
