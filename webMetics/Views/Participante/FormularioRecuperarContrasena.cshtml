@model webMetics.Models.ParticipanteModel
@using webMetics.Controllers
@using webMetics.Helpers
@{
    ViewBag.Title = "Recuperar contraseña";

    var urlReferrer = Context.Request.Headers["Referer"].FirstOrDefault();
}

@if (ViewBag.Id != "")
{
    <div class="contenedor-caja container-fluid required-update-page admin-panel-page">
        @await Html.PartialAsync("_MeticsToast")

        <section class="admin-panel-card required-update-card" aria-labelledby="recuperarContrasenaTitulo">
            <div class="required-update-header">
                <span class="admin-panel-card-icon" aria-hidden="true"><i class="bi bi-key"></i></span>
                <div>
                    <h1 class="required-update-title" id="recuperarContrasenaTitulo">Recuperar contraseña</h1>
                    <p class="admin-panel-card-desc">Ingrese su correo institucional para recuperar el acceso a su cuenta.</p>
                </div>
            </div>

            @using (Html.BeginForm("RecuperarContrasena", "Participante", FormMethod.Post, new { id = "recuperarContrasenaForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="required-update-field">
                    @Html.LabelFor(model => model.correo) <span class="required-update-required" aria-hidden="true">*</span>
                    @Html.TextBoxFor(model => model.correo, new { @class = "form-control", @type = "email", @placeholder = "Ingrese su correo institucional" })
                    @Html.ValidationMessageFor(model => model.correo, "", new { @class = "text-danger", id = "recuperarCorreoError" })
                </div>

                <button type="submit" class="btn admin-panel-btn-primary required-update-submit">
                    <i class="bi bi-envelope" aria-hidden="true"></i>Recuperar contraseña
                </button>

                @if (urlReferrer != null)
                {
                    <a href="#" class="btn admin-panel-btn-secondary required-update-submit required-update-back" onclick="history.go(-1); return false;">Volver</a>
                }
            }
        </section>
    </div>
}

<script>
    // Campo obligatorio: si el correo está vacío no se envía el formulario y se muestra el aviso.
    (function () {
        var form = document.getElementById('recuperarContrasenaForm');
        if (!form) return;
        var input = form.querySelector('input[name="correo"]');
        var mensaje = document.getElementById('recuperarCorreoError');
        if (!input || !mensaje) return;

        function mostrar(texto) {
            mensaje.textContent = texto;
            mensaje.classList.remove('field-validation-valid');
            mensaje.classList.add('field-validation-error');
            input.classList.add('input-validation-error');
            input.setAttribute('aria-invalid', 'true');
        }
        function limpiar() {
            mensaje.textContent = '';
            mensaje.classList.remove('field-validation-error');
            mensaje.classList.add('field-validation-valid');
            input.classList.remove('input-validation-error');
            input.removeAttribute('aria-invalid');
        }

        input.setAttribute('aria-describedby', 'recuperarCorreoError');
        form.addEventListener('submit', function (event) {
            if (!input.value.trim()) {
                event.preventDefault();
                mostrar('Debe completar este campo obligatorio.');
                input.focus();
            }
        });
        input.addEventListener('input', function () {
            if (input.value.trim()) limpiar();
        });
    })();
</script>
